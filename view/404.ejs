<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
</head>

<body class="bg-bg dark:bg-dark transition-colors duration-300 flex flex-col min-h-screen">
    <%- include('partials/header') %>

        <main class="flex-grow flex items-center justify-center p-4">
            <div class="text-center max-w-2xl mx-auto">
                <!-- Animation Container -->
                <div class="w-full max-w-md mx-auto mb-8">
                    <lottie-player src="/animations/giraff.json" background="transparent" speed="1"
                        style="width: 100%; height: 300px;" loop autoplay>
                    </lottie-player>
                </div>

                <h1 class="text-4xl md:text-6xl font-extrabold text-primary dark:text-blue-400 mb-4 tracking-tight">
                    Oops!</h1>
                <!-- ... rest of content ... -->
                <h2 class="text-2xl md:text-3xl font-bold text-dark dark:text-white mb-6">Page Not Found</h2>

                <p class="text-gray-600 dark:text-gray-300 text-lg mb-10 max-w-md mx-auto">
                    We looked everywhere for this medicin (or service), but it seems to be missing from our shelves.
                </p>

                <a href="/"
                    class="inline-flex items-center justify-center gap-3 bg-primary hover:bg-blue-800 text-white font-bold py-4 px-8 rounded-full shadow-lg shadow-blue-500/30 transition-all transform hover:-translate-y-1 active:scale-95 text-lg group">
                    <i class="fas fa-arrow-left group-hover:-translate-x-1 transition-transform"></i>
                    Back to Home
                </a>
            </div>
        </main>

        <%- include('partials/footer') %>
</body>

</html>