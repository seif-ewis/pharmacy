<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

    <body
        class="bg-gray-50 text-dark font-sans antialiased overflow-x-hidden selection:bg-primary selection:text-white dark:bg-dark transition-colors duration-300">
        <div class="print:hidden">
            <%- include('../partials/header') %>
        </div>

        <main class="min-h-screen py-12">
            <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
                <nav class="flex mb-8 text-sm text-gray-500 print:hidden">
                    <a href="/profile" class="hover:text-primary transition-colors">My Account</a>
                    <span class="mx-2">/</span>
                    <span class="text-dark dark:text-gray-300 font-bold">Order #<%= order.order_uid || order.id %>
                    </span>
                </nav>

                <div id="invoice-card"
                    class="bg-white dark:bg-slate-900 rounded-3xl shadow-xl shadow-gray-200/50 dark:shadow-none overflow-hidden border border-gray-100 dark:border-slate-800">
                    <div
                        class="bg-gray-50 dark:bg-slate-800/50 px-4 sm:px-8 py-6 border-b border-gray-100 dark:border-slate-800 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div>
                            <h1 class="text-2xl font-bold text-dark dark:text-white mb-1">Order Details
                            </h1>
                            <p class="text-sm text-gray-500">Placed on <%= new Date(order.created_at).toDateString() %>
                            </p>
                            <!-- Show Order ID clearly in invoice -->
                            <p class="text-base font-bold text-primary mt-1">#<%= order.order_uid ||
                                    order.id.substring(0,8).toUpperCase() %>
                            </p>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:items-center gap-3 w-full sm:w-auto">
                            <span class="px-3 py-1 text-sm font-bold rounded-full w-fit 
                                <%= order.status === 'completed' ? 'bg-green-100 text-green-800' : 
                                    (order.status === 'canceled' || order.status === 'cancelled') ? 'bg-red-100 text-red-800' : 
                                    'bg-yellow-100 text-yellow-800' %>">
                                <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                            </span>

                            <% if (order.return_status==='partial' ) { %>
                                <span
                                    class="px-3 py-1 text-sm font-bold rounded-full w-fit bg-amber-100 text-amber-800">
                                    Partial Return
                                </span>
                                <% } else if (order.return_status==='full' ) { %>
                                    <span
                                        class="px-3 py-1 text-sm font-bold rounded-full w-fit bg-red-100 text-red-800">
                                        Returned
                                    </span>
                                    <% } %>
                                        <div class="flex flex-wrap items-center gap-2 print:hidden mt-2 sm:mt-0">
                                            <% if (order.status==='pending' ) { %>
                                                <form action="/orders/<%= order.id %>/cancel" method="POST"
                                                    onsubmit="event.preventDefault(); showConfirm('Cancel Order', 'Are you sure you want to cancel this order?').then(ok => { if(ok) this.submit(); });"
                                                    class="flex-1 sm:flex-none">
                                                    <button type="submit"
                                                        class="w-full sm:w-auto px-4 py-2 border border-red-200 text-red-600 rounded-xl text-sm font-bold hover:bg-red-50 text-center whitespace-nowrap">
                                                        Cancel Order
                                                    </button>
                                                </form>
                                                <% } %>
                                                    <button onclick="downloadPDF()"
                                                        class="flex-1 sm:flex-none w-full sm:w-auto px-4 py-2 bg-gray-800 text-white rounded-xl text-sm font-bold hover:bg-gray-900 transition-colors whitespace-nowrap text-center">
                                                        Download PDF
                                                    </button>
                                                    <button onclick="window.print()"
                                                        class="flex-1 sm:flex-none w-full sm:w-auto px-4 py-2 bg-primary text-white rounded-xl text-sm font-bold shadow-lg shadow-blue-200 hover:shadow-blue-300 transition-all whitespace-nowrap text-center">
                                                        Print Invoice
                                                    </button>
                                        </div>
                        </div>
                    </div>
                    <div class="p-4 sm:p-8">
                        <!-- Invoice Header Section -->
                        <div
                            class="flex flex-col md:flex-row justify-between items-start border-b border-gray-100 dark:border-slate-800 pb-8 mb-8 gap-6">
                            <div>
                                <h2 class="text-3xl font-black text-primary mb-2">Hosam Pharmacy</h2>
                                <div class="text-sm text-gray-500 dark:text-gray-400 space-y-1">
                                    <p class="flex items-center gap-2"><i
                                            class="fas fa-map-marker-alt text-primary/60 w-4"></i> 123 Health St,
                                        Medical District</p>
                                    <p class="flex items-center gap-2"><i
                                            class="fas fa-envelope text-primary/60 w-4"></i> contact@hosampharmacy.com
                                    </p>
                                    <p class="flex items-center gap-2"><i class="fas fa-phone text-primary/60 w-4"></i>
                                        +1 (555) 123-4567</p>
                                </div>
                            </div>
                            <div class="text-left md:text-right">
                                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Billed To</h3>
                                <p class="font-bold text-dark dark:text-white text-lg">
                                    <%= user.full_name %>
                                </p>
                                <p class="text-sm text-gray-500 dark:text-gray-400">
                                    <%= user.email %>
                                </p>
                                <p class="text-sm text-gray-500 dark:text-gray-400">
                                    <%= order.phone || user.phone %>
                                </p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
                            <div>
                                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">
                                    Delivery
                                    Address</h3>
                                <div class="text-sm text-gray-600 dark:text-gray-300 space-y-1">
                                    <p class="font-bold text-dark dark:text-white text-base mb-1">
                                        <%= order.address_label || 'Home' %>
                                    </p>
                                    <p>
                                        <%= order.street %>
                                    </p>
                                    <p>
                                        <%= order.city %>
                                    </p>
                                    <p class="mt-2">
                                        <%= order.phone || user.phone %>
                                    </p>
                                </div>
                            </div>
                            <div>
                                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">
                                    Payment
                                    Method</h3>
                                <div
                                    class="bg-gray-50 dark:bg-slate-800/50 p-4 rounded-2xl border border-gray-100 dark:border-slate-800">
                                    <p class="font-bold text-dark dark:text-white text-sm">Cash on Delivery</p>
                                    <p class="text-sm text-gray-500 mt-1">Status: <span
                                            class="capitalize px-2 py-0.5 rounded-md bg-green-50 dark:bg-green-900/20 text-green-600 font-medium text-xs">
                                            <%= order.payment_status %>
                                        </span></p>
                                </div>
                            </div>
                        </div>
                        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Items
                            Ordered</h3>
                        <div class="overflow-x-auto rounded-xl border border-gray-100 dark:border-slate-800 mb-8">
                            <table class="w-full text-sm text-left">
                                <thead class="bg-gray-50 dark:bg-slate-800 text-gray-500 uppercase text-xs">
                                    <tr>
                                        <th class="px-6 py-3 font-medium">Product</th>
                                        <th class="px-6 py-3 font-medium text-center">Qty</th>
                                        <th class="px-6 py-3 font-medium text-right">Price</th>
                                        <th class="px-6 py-3 font-medium text-right">Total</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
                                    <% order.items.forEach(function(item) { %>
                                        <tr class="bg-white dark:bg-slate-900">
                                            <td class="px-6 py-4">
                                                <span class="font-medium text-dark dark:text-white">
                                                    <%= item.name %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-center text-gray-600 dark:text-gray-400">
                                                <%= item.quantity %>
                                            </td>
                                            <td class="px-6 py-4 text-right text-gray-600 dark:text-gray-400">
                                                $<%= parseFloat(item.price).toFixed(2) %>
                                            </td>
                                            <td class="px-6 py-4 text-right font-medium text-dark dark:text-white">
                                                $<%= parseFloat(item.total).toFixed(2) %>
                                            </td>
                                        </tr>
                                        <% }); %>
                                </tbody>
                            </table>
                        </div>
                        <div class="flex flex-col md:flex-row justify-end">
                            <div class="w-full md:w-80 space-y-3">
                                <div class="flex justify-between text-gray-500 dark:text-gray-400 text-sm">
                                    <span>Subtotal</span>
                                    <span>$<%= parseFloat(order.subtotal).toFixed(2) %></span>
                                </div>
                                <% if (parseFloat(order.delivery_fee)> 0) { %>
                                    <div class="flex justify-between text-gray-500 dark:text-gray-400 text-sm">
                                        <span>Delivery Fee</span>
                                        <span>$<%= parseFloat(order.delivery_fee).toFixed(2) %></span>
                                    </div>
                                    <% } %>
                                        <% if (parseFloat(order.tax_amount)> 0) { %>
                                            <div class="flex justify-between text-gray-500 dark:text-gray-400 text-sm">
                                                <span>Tax</span>
                                                <span>$<%= parseFloat(order.tax_amount).toFixed(2) %></span>
                                            </div>
                                            <% } %>
                                                <div
                                                    class="border-t border-gray-100 dark:border-slate-800 pt-3 flex justify-between items-center">
                                                    <span
                                                        class="font-bold text-dark dark:text-white text-lg">Total</span>
                                                    <span class="font-bold text-primary text-xl">$<%=
                                                            parseFloat(order.total_price).toFixed(2) %></span>
                                                </div>
                            </div>
                        </div>

                        <!-- Thanks Message Section -->
                        <div class="mt-12 pt-8 border-t border-gray-100 dark:border-slate-800 text-center">
                            <p class="text-gray-500 dark:text-gray-400 font-medium italic">Thank you for choosing Hosam
                                Pharmacy. We wish you a speedy recovery!</p>
                            <p class="text-xs text-gray-400 mt-2 italic">This is a computer generated invoice.</p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <div class="print:hidden">
            <%- include('../partials/footer') %>
        </div>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
        <script>
            function downloadPDF() {
                const btn = document.querySelector('button[onclick="downloadPDF()"]');
                if (btn) {
                    btn.innerText = 'Generating...';
                    btn.disabled = true;
                }

                // Capture the exact card as shown on screen
                const element = document.getElementById('invoice-card');

                // Clone the element to hide buttons without affecting main UI
                const clone = element.cloneNode(true);
                const printHiddenElements = clone.querySelectorAll('.print\\:hidden');
                printHiddenElements.forEach(el => {
                    el.style.display = 'none';
                });

                // Set options
                const opt = {
                    margin: [10, 10, 10, 10],
                    filename: 'invoice_<%= order.order_uid || order.id %>.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: {
                        scale: 2,
                        useCORS: true,
                        backgroundColor: '#ffffff' // Ensure it's white for PDF
                    },
                    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
                };

                // Generate
                html2pdf().from(clone).set(opt).save().then(() => {
                    if (btn) {
                        btn.innerText = 'Download PDF';
                        btn.disabled = false;
                    }
                }).catch(err => {
                    showToast('error', 'Failed to generate PDF.');
                    if (btn) {
                        btn.innerText = 'Download PDF';
                        btn.disabled = false;
                    }
                });
            }
        </script>
    </body>

</html>