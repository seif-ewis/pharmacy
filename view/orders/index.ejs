<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<%- include('../partials/head') %>

    <body
        class="bg-gray-50 text-dark font-sans antialiased overflow-x-hidden transition-colors duration-300 dark:bg-dark">

        <%- include('../partials/header') %>

            <main class="min-h-screen py-12 relative overflow-hidden">
                <!-- Background Elements -->
                <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0">
                    <div
                        class="absolute top-[20%] right-[-10%] w-[40%] h-[40%] bg-primary/5 rounded-full blur-3xl animate-blob">
                    </div>
                    <div
                        class="absolute bottom-[10%] left-[-10%] w-[40%] h-[40%] bg-purple-400/5 rounded-full blur-3xl animate-blob animation-delay-2000">
                    </div>
                </div>

                <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                    <!-- Header -->
                    <div class="mb-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div>
                            <h1 class="text-3xl font-extrabold text-dark dark:text-white mb-2">My Orders</h1>
                            <p class="text-gray-500 dark:text-gray-400">Track your past purchases and returns.</p>
                        </div>
                        <a href="/orders/request/new"
                            class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-white font-bold rounded-xl shadow-lg shadow-blue-500/20 hover:shadow-xl hover:bg-blue-700 transition-all border border-transparent">
                            <i class="fas fa-search-plus"></i>
                            <span>Request Product</span>
                        </a>
                    </div>

                    <!-- Orders List -->
                    <div class="space-y-6">
                        <% if (orders && orders.length> 0) { %>
                            <% orders.forEach(order=> { %>
                                <div
                                    class="bg-white dark:bg-slate-900 rounded-3xl p-6 shadow-xl shadow-gray-200/50 dark:shadow-none border border-gray-100 dark:border-slate-800 transition-all hover:translate-y-[-2px]">
                                    <!-- Order Header -->
                                    <div
                                        class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-gray-50 dark:border-slate-800 gap-4">
                                        <div class="flex items-center gap-4">
                                            <div
                                                class="w-12 h-12 rounded-2xl bg-primary/10 dark:bg-blue-900/20 flex items-center justify-center text-primary dark:text-blue-400 text-xl">
                                                <i class="fas fa-box"></i>
                                            </div>
                                            <div>
                                                <h3 class="font-bold text-lg text-dark dark:text-white">Order #<%=
                                                        order.order_uid %>
                                                </h3>
                                                <p class="text-xs text-gray-400">Placed on <%= new
                                                        Date(order.created_at).toLocaleDateString() %>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-4">
                                            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide
                                        <%= order.status === 'delivered' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' : 
                                           order.status === 'cancelled' ? 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400' :
                                           order.status === 'returned' ? 'bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400' :
                                           order.status === 'scheduled' ? 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400' :
                                           'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400' %>">
                                                <%= order.status %>
                                            </span>
                                            <% if (order.return_status==='partial' ) { %>
                                                <span
                                                    class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">
                                                    Partial Return
                                                </span>
                                                <% } else if (order.return_status==='full' ) { %>
                                                    <span
                                                        class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400">
                                                        Returned
                                                    </span>
                                                    <% } %>
                                                        <span class="text-xl font-extrabold text-dark dark:text-white">$
                                                            <%= parseFloat(order.total_price).toFixed(2) %>
                                                        </span>
                                        </div>
                                    </div>

                                    <% if (order.status==='scheduled' ) { %>
                                        <div
                                            class="mt-4 -mb-2 bg-purple-50 dark:bg-purple-900/10 border border-purple-100 dark:border-purple-800/30 rounded-xl p-3 flex items-start gap-3">
                                            <i class="fas fa-clock text-purple-500 mt-0.5"></i>
                                            <div>
                                                <p class="text-sm font-bold text-purple-700 dark:text-purple-300">Order
                                                    Scheduled</p>
                                                <p class="text-xs text-purple-600 dark:text-purple-400">Our pharmacy is
                                                    currently closed. Your order has been secured and will be processed
                                                    immediately when our next shift begins.</p>
                                            </div>
                                        </div>
                                        <% } %>

                                            <!-- Order Items -->
                                            <div class="py-6 space-y-4">
                                                <% order.items.forEach(item=> { %>
                                                    <div class="flex items-center justify-between group">
                                                        <div class="flex items-center gap-4">
                                                            <div
                                                                class="w-10 h-10 rounded-lg bg-gray-50 dark:bg-slate-800 flex items-center justify-center flex-shrink-0">
                                                                <% if (item.image_url) { %>
                                                                    <img src="<%= item.image_url %>"
                                                                        alt="<%= item.name %>"
                                                                        class="w-full h-full object-cover rounded-lg">
                                                                    <% } else { %>
                                                                        <i
                                                                            class="fas fa-pills text-gray-400 text-xs"></i>
                                                                        <% } %>
                                                            </div>
                                                            <div>
                                                                <p
                                                                    class="text-sm font-bold text-dark dark:text-gray-200">
                                                                    <%= item.name %>
                                                                </p>
                                                                <div class="flex items-center gap-2">
                                                                    <p class="text-xs text-gray-400">Qty: <%=
                                                                            item.quantity %>
                                                                    </p>
                                                                    <% if (item.returned_quantity> 0) { %>
                                                                        <span
                                                                            class="text-[10px] font-bold text-orange-500 bg-orange-50 dark:bg-orange-900/20 px-1.5 py-0.5 rounded">
                                                                            Returned: <%= item.returned_quantity %>
                                                                        </span>
                                                                        <% } %>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <span
                                                            class="text-sm font-bold text-gray-500 dark:text-gray-400">$
                                                            <%= parseFloat(item.price).toFixed(2) %>
                                                        </span>
                                                    </div>
                                                    <% }); %>
                                            </div>

                                            <!-- Actions -->
                                            <div
                                                class="flex flex-wrap items-center justify-end gap-3 pt-4 border-t border-gray-50 dark:border-slate-800">
                                                <% if (order.status==='delivered' ) { %>
                                                    <a href="/orders/<%= order.id %>/return"
                                                        class="px-4 py-2 rounded-xl text-xs font-bold border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors">
                                                        Request Return
                                                    </a>
                                                    <% } %>
                                                        <a href="/orders/<%= order.id %>"
                                                            class="inline-block px-4 py-2 rounded-xl text-xs font-bold bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-slate-700 transition-colors text-center">
                                                            View Invoice
                                                        </a>
                                                        <% if (order.status==='pending' ) { %>
                                                            <form action="/orders/<%= order.id %>/cancel" method="POST"
                                                                onsubmit="return confirm('Cancel this order?');"
                                                                class="inline">
                                                                <button type="submit"
                                                                    class="px-4 py-2 rounded-xl text-xs font-bold bg-red-50 dark:bg-red-900/10 text-red-600 hover:bg-red-100 dark:hover:bg-red-900/20 transition-colors">
                                                                    Cancel Order
                                                                </button>
                                                            </form>
                                                            <% } %>
                                            </div>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <div
                                            class="text-center py-20 bg-white dark:bg-slate-900 rounded-3xl shadow-xl shadow-gray-200/50 dark:shadow-none border border-gray-100 dark:border-slate-800">
                                            <div
                                                class="w-20 h-20 bg-gray-50 dark:bg-slate-800 rounded-full flex items-center justify-center mx-auto mb-6 text-gray-300 dark:text-slate-600 text-3xl">
                                                <i class="fas fa-shopping-basket"></i>
                                            </div>
                                            <h2 class="text-2xl font-bold text-dark dark:text-white mb-2">No orders yet
                                            </h2>
                                            <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-md mx-auto">Looks like
                                                you haven't placed any orders yet. Start shopping to fill this page!</p>
                                            <a href="/"
                                                class="px-8 py-3 bg-primary hover:bg-blue-700 text-white rounded-xl font-bold shadow-lg shadow-blue-500/30 transition-all transform hover:-translate-y-1 active:scale-95 inline-flex items-center gap-2">
                                                <span>Start Shopping</span>
                                                <i class="fas fa-arrow-right"></i>
                                            </a>
                                        </div>
                                        <% } %>
                    </div>

                    <!-- Product Requests Section (New) -->
                    <div class="mt-16 pt-12 border-t border-gray-100 dark:border-slate-800">
                        <div class="mb-8">
                            <h2 class="text-2xl font-bold text-dark dark:text-white mb-2">My Product Requests</h2>
                            <p class="text-gray-500 dark:text-gray-400">Special orders sourced by our doctors just for
                                you.</p>
                        </div>

                        <div id="requests-container" class="space-y-4">
                            <!-- Requests will be loaded here via JS or simple initial EJS loop -->
                            <% if (typeof requests !=='undefined' && requests.length> 0) { %>
                                <% requests.forEach(req=> { %>
                                    <div
                                        class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-gray-100 dark:border-slate-800 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                                        <div class="flex items-center gap-4">
                                            <div
                                                class="w-10 h-10 rounded-xl bg-orange-50 dark:bg-orange-900/20 flex items-center justify-center text-orange-500">
                                                <i class="fas fa-clipboard-list"></i>
                                            </div>
                                            <div>
                                                <h4 class="font-bold text-dark dark:text-white">
                                                    <%= req.product_name %>
                                                </h4>
                                                <p class="text-xs text-gray-400">Requested on <%= new
                                                        Date(req.created_at).toLocaleDateString() %>
                                                </p>
                                            </div>
                                        </div>

                                        <div class="flex items-center gap-4 w-full md:w-auto">
                                            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase 
                                                <%= req.status === 'ready' ? 'bg-green-100 text-green-700' : 
                                                   req.status === 'preparing' ? 'bg-blue-100 text-blue-700' : 
                                                   'bg-gray-100 text-gray-600' %>">
                                                <%= req.status %>
                                            </span>

                                            <% if (req.status==='ready' ) { %>
                                                <button onclick="confirmOrder('<%= req.id %>')"
                                                    class="flex-1 md:flex-none px-4 py-2 bg-primary text-white text-xs font-bold rounded-xl hover:bg-blue-800 transition-colors shadow-lg active:scale-95">
                                                    Ready to Take
                                                </button>
                                                <% } %>
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <p
                                                class="text-gray-400 text-center py-8 bg-gray-50 dark:bg-slate-800/20 rounded-2xl border border-dashed border-gray-200 dark:border-slate-800">
                                                No active product requests.</p>
                                            <% } %>
                        </div>
                    </div>
                </div>

                <script>
                    async function confirmOrder(requestId) {
                        try {
                            const res = await fetch(`/orders/request/${requestId}/confirm`, { method: 'POST' });
                            const data = await res.json();
                            if (data.success) {
                                showToast('success', 'Success! Your order has been created.');
                                setTimeout(() => window.location.reload(), 1500);
                            } else {
                                showToast('error', data.message || 'Error occurred');
                            }
                        } catch (err) {
                            showToast('error', 'Failed to process request');
                        }
                    }
                </script>
                </div>
            </main>

            <%- include('../partials/footer') %>

    </body>

</html>