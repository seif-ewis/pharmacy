<!-- NEW OVERVIEW SECTION REPLACEMENT -->
<!-- This replaces lines 148-250 in dashboard.ejs -->

<!-- MODULE: OVERVIEW -->
<div id="module-overview" class="module-content animate-fade-in">

    <!-- Shift Status Banner -->
    <% if (activeShift) { %>
        <div id="shift-status-banner"
            class="bg-gradient-to-r from-green-500 to-emerald-600 rounded-2xl p-6 text-white shadow-lg mb-6 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center">
                    <i class="fas fa-clock text-2xl"></i>
                </div>
                <div>
                    <h3 class="font-black text-lg">Shift Active</h3>
                    <p class="text-white/80 text-sm" id="shift-duration">Started at <%= new
                            Date(activeShift.created_at).toLocaleTimeString() %>
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-white animate-pulse"></span>
                <span class="font-bold text-sm uppercase tracking-wider">LIVE</span>
            </div>
        </div>
        <% } else { %>
            <div id="shift-status-banner"
                class="bg-gradient-to-r from-slate-600 to-slate-700 rounded-2xl p-6 text-white shadow-lg mb-6 flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-white/10 backdrop-blur-sm rounded-full flex items-center justify-center">
                        <i class="fas fa-moon text-2xl"></i>
                    </div>
                    <div>
                        <h3 class="font-black text-lg">No Active Shift</h3>
                        <p class="text-white/70 text-sm">Start a shift to begin monitoring</p>
                    </div>
                </div>
                <form action="/doctor/shift/start" method="POST" class="inline">
                    <button type="submit"
                        class="bg-white/20 hover:bg-white/30 backdrop-blur-sm px-6 py-2 rounded-lg font-bold text-sm transition-all">
                        Start Shift
                    </button>
                </form>
            </div>
            <% } %>

                <!-- Live Counters Grid (4 cards) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
                    <!-- Revenue -->
                    <div
                        class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700/50">
                        <div class="flex items-center gap-3 mb-3">
                            <div
                                class="w-10 h-10 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center text-green-600">
                                <i class="fas fa-dollar-sign"></i>
                            </div>
                            <span class="text-xs font-bold text-gray-400 uppercase">Revenue</span>
                        </div>
                        <h3 id="counter-revenue" class="text-3xl font-black dark:text-white">$<%= activeShift ?
                                parseFloat(activeShift.total_revenue).toFixed(2) : '0.00' %>
                        </h3>
                        <p class="text-[10px] text-gray-400 mt-1">Current Shift</p>
                    </div>

                    <!-- Orders -->
                    <div
                        class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700/50">
                        <div class="flex items-center gap-3 mb-3">
                            <div
                                class="w-10 h-10 bg-blue-100 dark:bg-blue-900/30 rounded-xl flex items-center justify-center text-blue-600">
                                <i class="fas fa-shopping-bag"></i>
                            </div>
                            <span class="text-xs font-bold text-gray-400 uppercase">Orders</span>
                        </div>
                        <h3 id="counter-orders" class="text-3xl font-black dark:text-white">
                            <%= activeShift ? activeShift.orders_count : 0 %>
                        </h3>
                        <p class="text-[10px] text-gray-400 mt-1">Pending</p>
                    </div>

                    <!-- Prescriptions -->
                    <div
                        class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700/50">
                        <div class="flex items-center gap-3 mb-3">
                            <div
                                class="w-10 h-10 bg-purple-100 dark:bg-purple-900/30 rounded-xl flex items-center justify-center text-purple-600">
                                <i class="fas fa-file-medical"></i>
                            </div>
                            <span class="text-xs font-bold text-gray-400 uppercase">Prescriptions</span>
                        </div>
                        <h3 id="counter-prescriptions" class="text-3xl font-black dark:text-white">
                            <%= activeShift ? activeShift.prescriptions_count : 0 %>
                        </h3>
                        <p class="text-[10px] text-gray-400 mt-1">Reviewing</p>
                    </div>

                    <!-- Total Requests -->
                    <div
                        class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700/50">
                        <div class="flex items-center gap-3 mb-3">
                            <div
                                class="w-10 h-10 bg-orange-100 dark:bg-orange-900/30 rounded-xl flex items-center justify-center text-orange-600">
                                <i class="fas fa-chart-line"></i>
                            </div>
                            <span class="text-xs font-bold text-gray-400 uppercase">Requests</span>
                        </div>
                        <h3 id="counter-total-requests" class="text-3xl font-black dark:text-white">0</h3>
                        <p class="text-[10px] text-gray-400 mt-1">All-Time</p>
                    </div>
                </div>

                <!-- Alerts Section -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                    <!-- Low Stock Alert -->
                    <div class="bg-gradient-to-br from-yellow-50 to-amber-50 dark:from-yellow-900/20 dark:to-amber-900/20 border-2 border-yellow-200 dark:border-yellow-800 rounded-2xl p-6 relative overflow-hidden group cursor-pointer hover:scale-[1.02] transition-all"
                        onclick="showModule('inventory')">
                        <div class="relative z-10">
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center gap-3">
                                    <div
                                        class="w-10 h-10 bg-yellow-500 rounded-xl flex items-center justify-center text-white">
                                        <i class="fas fa-exclamation-triangle"></i>
                                    </div>
                                    <h4 class="font-black text-dark dark:text-white">Low Stock Alert</h4>
                                </div>
                                <span id="alert-low-stock-count"
                                    class="text-2xl font-black text-yellow-600 dark:text-yellow-400">0</span>
                            </div>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Items running low in inventory</p>
                        </div>
                        <i
                            class="fas fa-boxes absolute -right-6 -bottom-6 text-8xl text-yellow-400/10 group-hover:rotate-12 transition-transform"></i>
                    </div>

                    <!-- Scheduled Orders Alert -->
                    <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 border-2 border-blue-200 dark:border-blue-800 rounded-2xl p-6 relative overflow-hidden group cursor-pointer hover:scale-[1.02] transition-all"
                        onclick="showModule('orders')">
                        <div class="relative z-10">
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center gap-3">
                                    <div
                                        class="w-10 h-10 bg-blue-500 rounded-xl flex items-center justify-center text-white">
                                        <i class="fas fa-clock"></i>
                                    </div>
                                    <h4 class="font-black text-dark dark:text-white">Scheduled Orders</h4>
                                </div>
                                <span id="alert-scheduled-count"
                                    class="text-2xl font-black text-blue-600 dark:text-blue-400">0</span>
                            </div>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Orders waiting for pharmacy</p>
                        </div>
                        <i
                            class="fas fa-calendar-alt absolute -right-6 -bottom-6 text-8xl text-blue-400/10 group-hover:rotate-12 transition-transform"></i>
                    </div>
                </div>

</div>