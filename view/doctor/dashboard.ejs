            // Open Modal for Existing Request
            function openProcessRequestModal(returnData) {
                selectedPendingReturn = returnData;

                // Populate Modal UI
                // We'll reuse a new modal or a specific section of the existing one?
                // Let's create a dedicated simplified modal dynamically or inject into DOM if cleaner.
                // For speed, let's assume we have a 'process-request-modal' in HTML or we build one.
                // Since I can't easily edit the HTML structure higher up without a huge replace, 
                // I will inject the modal into the body if it doesn't exist, or use a JS prompt/confirm flow 
                // properly. But for a good UX, let's create a visual modal string and insert it.

                const modalHtml = `
                    <div id="process-request-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[60] flex items-center justify-center p-4">
                        <div class="bg-white dark:bg-slate-900 w-full max-w-2xl rounded-3xl p-6 shadow-2xl border border-gray-100 dark:border-slate-800 animate-slide-up">
                            <h3 class="text-xl font-black dark:text-white mb-4">Process Return Request</h3>
                            <div class="bg-gray-50 dark:bg-slate-800 rounded-xl p-4 mb-4">
                                <div class="flex justify-between mb-2">
                                    <span class="text-sm text-gray-500">Customer</span>
                                    <span class="text-sm font-bold dark:text-white">${returnData.user_name}</span>
                                </div>
                                <div class="flex justify-between mb-2">
                                    <span class="text-sm text-gray-500">Order</span>
                                    <span class="text-sm font-bold dark:text-white">#${returnData.order_uid}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-sm text-gray-500">Reason</span>
                                    <span class="text-sm italic dark:text-gray-300">"${returnData.reason}"</span>
                                </div>
                            </div>

                            <h4 class="font-bold text-sm text-gray-500 uppercase mb-3">Items to Return</h4>
                            <div class="space-y-3 mb-6">
                                ${returnData.items.map(item => `
                                    <div class="flex items-center justify-between p-3 border rounded-lg dark:border-slate-700">
                                        <div>
                                            <p class="font-bold text-sm dark:text-white">${item.medicine_name}</p>
                                            <p class="text-xs text-gray-400">Qty: ${item.quantity}</p>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <label class="text-xs text-gray-500">Condition:</label>
                                            <select id="condition-${item.id}" class="text-xs rounded border-gray-300 dark:bg-slate-800">
                                                <option value="good">Good (Restock)</option>
                                                <option value="damaged">Damaged (Discard)</option>
                                                <option value="expired">Expired (Discard)</option>
                                            </select>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>

                            <label class="block text-sm font-bold mb-2 dark:text-white">Admin Notes</label>
                            <textarea id="admin-notes" class="w-full text-sm rounded-xl border-gray-300 dark:bg-slate-800 mb-6" placeholder="Optional notes..."></textarea>

                            <div class="flex gap-3 justify-end">
                                <button onclick="document.getElementById('process-request-modal').remove()" class="px-4 py-2 font-bold text-gray-500 hover:bg-gray-100 rounded-xl">Cancel</button>
                                <button onclick="submitRequestAction('reject')" class="px-4 py-2 font-bold text-red-600 bg-red-50 hover:bg-red-100 rounded-xl">Reject</button>
                                <button onclick="submitRequestAction('approve')" class="px-6 py-2 font-bold text-white bg-green-600 hover:bg-green-700 rounded-xl shadow-lg">Approve Check</button>
                            </div>
                        </div>
                    </div>
                `;
                document.body.insertAdjacentHTML('beforeend', modalHtml);
            }

            async function submitRequestAction(action) {
                if (!selectedPendingReturn) return;

                const itemConditions = {};
                selectedPendingReturn.items.forEach(item => {
                    const val = document.getElementById(`condition-${item.id}`).value;
                    itemConditions[item.id] = val;
                });

                const notes = document.getElementById('admin-notes').value;
                const modal = document.getElementById('process-request-modal');

                // Visual loading state
                const btns = modal.querySelectorAll('button');
                btns.forEach(b => b.disabled = true);

                try {
                    const res = await fetch('/doctor/returns/action', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            return_id: selectedPendingReturn.id,
                            action: action,
                            admin_notes: notes,
                            item_conditions: itemConditions
                        })
                    });

                    // We expect a redirect from backend usually, but since it's fetch:
                    if (res.redirected) {
                        window.location.href = res.url;
                        return;
                    }

                    // Or if JSON response
                    const data = await res.json().catch(() => ({}));

                    modal.remove();
                    showToast('success', `Request ${action}ed`);
                    loadPendingReturns();
                    loadRecentReturns();

                } catch (e) {
                    // If response was actually a redirect (HTML), fetch might have 'failed' JSON parse
                    // Just reload to be safe or inspect
                    window.location.reload();
                }
            }

            // --- End Pending Logic --- //

            function resetReturnForm() {
                selectedReturnOrderId = null;
                returnItemsCache = [];
                document.getElementById('return-step-1').classList.remove('hidden');
                document.getElementById('return-step-2').classList.add('hidden');
                document.getElementById('return-actions').classList.add('hidden');
                document.getElementById('return-order-search').value = '';
                document.getElementById('return-order-results').innerHTML = '';
                document.getElementById('return-items-list').innerHTML = '';
                document.getElementById('return-total-refund').textContent = '$0.00';
                document.getElementById('return-notes').value = '';
            }

            async function searchReturnOrder() {
                const query = document.getElementById('return-order-search').value.trim();
                if (query.length < 3) return showToast('error', 'Enter at least 3 characters');

                const resultsContainer = document.getElementById('return-order-results');
                resultsContainer.innerHTML = '<div class="text-center py-4"><i class="fas fa-spinner fa-spin"></i> Finding orders...</div>';

                try {
                    const res = await fetch(`/doctor/returns/search-order?query=${encodeURIComponent(query)}`);
                    const data = await res.json();

                    if (data.success && data.orders.length > 0) {
                        resultsContainer.innerHTML = data.orders.map(o => `
                            <div onclick="selectReturnOrder('${o.id}', '${o.user_name}', '${o.order_uid}')" 
                                class="bg-white dark:bg-slate-900 border border-gray-100 dark:border-slate-700 p-3 rounded-xl cursor-pointer hover:border-blue-500 transition-colors flex items-center justify-between">
                                <div>
                                    <p class="font-bold dark:text-white">${o.user_name}</p>
                                    <p class="text-xs text-gray-400">#${o.order_uid}</p>
                                </div>
                                <div class="text-right">
                                    <p class="font-bold text-green-600">$${parseFloat(o.total_price).toFixed(2)}</p>
                                    <p class="text-xs text-gray-400">${new Date(o.created_at).toLocaleDateString()}</p>
                                </div>
                            </div>
                        `).join('');
                    } else {
                        resultsContainer.innerHTML = '<p class="text-center text-gray-400 text-sm py-4">No matching completed orders found.</p>';
                    }
                } catch (e) {
                    console.error(e);
                    resultsContainer.innerHTML = '<p class="text-center text-red-500 text-sm">Search failed.</p>';
                }
            }

            async function selectReturnOrder(orderId, customerName, uid) {
                selectedReturnOrderId = orderId;
                document.getElementById('selected-order-id').textContent = `Order #${uid}`;
                document.getElementById('selected-order-customer').textContent = `Customer: ${customerName}`;

                document.getElementById('return-step-1').classList.add('hidden');
                document.getElementById('return-step-2').classList.remove('hidden');
                document.getElementById('return-actions').classList.remove('hidden');

                // Load items
                const list = document.getElementById('return-items-list');
                list.innerHTML = '<div class="text-center py-6"><i class="fas fa-spinner fa-spin"></i> Loading order items...</div>';

                try {
                    const res = await fetch(`/doctor/returns/order-items/${orderId}`);
                    const data = await res.json();

                    if (data.success) {
                        returnItemsCache = data.items;
                        renderReturnItems();
                    }
                } catch (e) {
                    list.innerHTML = '<p class="text-center text-red-400">Failed to load items</p>';
                }
            }

            function renderReturnItems() {
                const list = document.getElementById('return-items-list');
                list.innerHTML = returnItemsCache.map(item => `
                    <div class="flex items-center justify-between bg-white dark:bg-slate-900 p-3 rounded-xl border border-gray-100 dark:border-slate-700 transition-colors hover:border-blue-200">
                        <div class="flex items-center gap-3">
                            <input type="checkbox" onchange="toggleReturnItem('${item.id}')" class="w-5 h-5 rounded text-blue-600 focus:ring-blue-500" value="${item.id}">
                            <div>
                                <p class="font-bold text-sm dark:text-white">${item.medicine_name}</p>
                                <p class="text-xs text-gray-400">$${parseFloat(item.price).toFixed(2)} / unit</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                             <div class="flex items-center bg-gray-100 dark:bg-slate-800 rounded-lg px-2">
                                <button onclick="adjustReturnQty('${item.id}', -1)" class="text-gray-500 hover:text-red-500 p-1 font-bold">-</button>
                                <span id="qty-display-${item.id}" class="text-sm font-bold w-6 text-center dark:text-white select-none">${item.quantity}</span>
                                <input type="hidden" id="qty-${item.id}" value="${item.quantity}" max="${item.quantity}">
                                <button onclick="adjustReturnQty('${item.id}', 1)" class="text-gray-500 hover:text-green-500 p-1 font-bold">+</button>
                            </div>
                        </div>
                    </div>
                `).join('');
                calculateReturnTotal();
            }

            function adjustReturnQty(itemId, delta) {
                const input = document.getElementById(`qty-${itemId}`);
                const display = document.getElementById(`qty-display-${itemId}`);
                if (!input) return;

                let current = parseInt(input.value);
                let max = parseInt(input.getAttribute('max'));
                let newVal = current + delta;

                if (newVal >= 1 && newVal <= max) {
                    input.value = newVal;
                    display.innerText = newVal;
                    calculateReturnTotal();
                }
            }

            function toggleReturnItem(itemId) {
                calculateReturnTotal();
            }

            function calculateReturnTotal() {
                let total = 0;
                const checkboxes = document.querySelectorAll('#return-items-list input[type="checkbox"]:checked');

                checkboxes.forEach(cb => {
                    const itemId = cb.value;
                    const item = returnItemsCache.find(i => i.id === itemId);
                    const qty = parseInt(document.getElementById(`qty-${itemId}`).value);
                    if (item) {
                        total += parseFloat(item.price) * qty;
                    }
                });

                document.getElementById('return-total-refund').textContent = `$${total.toFixed(2)}`;
            }

            async function submitReturn() {
                if (!selectedReturnOrderId) return;

                const checkboxes = document.querySelectorAll('#return-items-list input[type="checkbox"]:checked');
                if (checkboxes.length === 0) return showToast('error', 'Select at least one item');

                if (!confirm("Confirm Return? \nThis will deduct revenue and update stock (if selected).")) return;

                const selectedItems = [];
                checkboxes.forEach(cb => {
                    const itemId = cb.value;
                    const item = returnItemsCache.find(i => i.id === itemId);
                    const qty = parseInt(document.getElementById(`qty-${itemId}`).value);
                    selectedItems.push({
                        medicine_id: item.medicine_id,
                        quantity: qty,
                        price: item.price
                    });
                });

                const payload = {
                    orderId: selectedReturnOrderId,
                    items: selectedItems,
                    reason: document.getElementById('return-reason').value,
                    condition: document.getElementById('return-condition').value,
                    updateInventory: document.getElementById('return-inventory-update').checked,
                    notes: document.getElementById('return-notes').value
                };

                try {
                    const res = await fetch('/doctor/returns/process', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();

                    if (data.success) {
                        showToast('success', 'Return Processed Successfully');
                        closeReturnModal();
                        loadRecentReturns();
                    } else {
                        showToast('error', data.error || 'Processing Failed');
                    }
                } catch (e) {
                    showToast('error', 'Network Error');
                }
            }

            async function loadRecentReturns() {
                const tbody = document.getElementById('returns-table-body');
                if (!tbody) return;

                try {
                    const res = await fetch('/doctor/returns/recent');
                    const data = await res.json();

                    if (data.success && data.returns.length > 0) {
                        tbody.innerHTML = data.returns.map(r => `
                            <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors">
                                <td class="px-6 py-4 font-mono text-xs dark:text-gray-300">...${r.id.substr(-8)}</td>
                                <td class="px-6 py-4 font-bold text-sm dark:text-white">#${r.order_uid}</td>
                                <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400 capitalize">${(r.reason || '').replace('_', ' ')}</td>
                                <td class="px-6 py-4 text-center">
                                    <span class="px-2 py-1 rounded text-xs font-bold bg-green-100 text-green-600 dark:bg-green-900/30 dark:text-green-400 uppercase">
                                        ${r.status}
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right font-bold text-red-500">-$${parseFloat(r.refund_amount).toFixed(2)}</td>
                            </tr>
                        `).join('');
                    } else {
                        tbody.innerHTML = `<tr><td colspan="5" class="text-center py-8 text-gray-400">No returns in this shift yet.</td></tr>`;
                    }
                } catch (e) {
                    console.error(e);
                }
            }

            // Auto-load returns when module active
            const returnsModule = document.getElementById('module-returns');
            if (returnsModule) {
                const obs = new MutationObserver(() => {
                    if (!returnsModule.classList.contains('hidden')) {
                        loadRecentReturns();
                        loadPendingReturns(); // Load requests too
                    }
                });
                obs.observe(returnsModule, { attributes: true, attributeFilter: ['class'] });
            }

            // ================================================
            // INVENTORY MODULE - Full CRUD
            // ================================================

            let inventoryCache = [];
            let editingProductId = null;

            async function loadInventory() {
                const tbody = document.getElementById('inventory-table-body');
                if (!tbody) return;

                tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-gray-400"><i class="fas fa-spinner fa-spin text-4xl mb-3"></i><p>Loading inventory...</p></td></tr>';

                try {
                    const res = await fetch('/doctor/inventory');
                    const data = await res.json();

                    if (data.success && data.inventory.length > 0) {
                        inventoryCache = data.inventory;
                        filterInventory(); // Apply any active filters
                    } else {
                        tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-gray-400"><i class="fas fa-box-open text-4xl mb-3"></i><p>No products in inventory</p></td></tr>';
                    }
                } catch (e) {
                    console.error('Load inventory error:', e);
                    tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-red-400"><i class="fas fa-exclamation-circle text-4xl mb-3"></i><p>Failed to load inventory</p></td></tr>';
                }
            }

            function filterInventory(sortBy = null) {
                const searchTerm = document.getElementById('inventory-search')?.value.toLowerCase() || '';
                const categoryFilter = document.getElementById('category-filter')?.value || '';
                const stockFilter = document.getElementById('stock-filter')?.value || '';
                const tbody = document.getElementById('inventory-table-body');

                if (!tbody) return;

                let filtered = inventoryCache.filter(item => {
                    const matchesSearch = item.name.toLowerCase().includes(searchTerm) ||
                        (item.category && item.category.toLowerCase().includes(searchTerm));
                    const matchesCategory = !categoryFilter || item.category === categoryFilter;

                    // Stock filter
                    let matchesStock = true;
                    if (stockFilter === 'low') {
                        matchesStock = item.current_stock <= (item.low_stock_threshold || 10);
                    } else if (stockFilter === 'out') {
                        matchesStock = item.current_stock <= 0;
                    } else if (stockFilter === 'available') {
                        matchesStock = item.current_stock > 0;
                    }

                    return matchesSearch && matchesCategory && matchesStock;
                });

                // Sort options
                if (sortBy === 'stock-asc') {
                    filtered.sort((a, b) => a.current_stock - b.current_stock);
                } else if (sortBy === 'stock-desc') {
                    filtered.sort((a, b) => b.current_stock - a.current_stock);
                } else if (sortBy === 'name') {
                    filtered.sort((a, b) => a.name.localeCompare(b.name));
                } else if (sortBy === 'price') {
                    filtered.sort((a, b) => parseFloat(b.price) - parseFloat(a.price));
                }

                // Update low stock analytics
                updateInventoryAnalytics();

                if (filtered.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-gray-400">No items match your filters</td></tr>';
                    return;
                }

                tbody.innerHTML = filtered.map(item => {
                    const isLowStock = item.current_stock <= (item.low_stock_threshold || 10);
                    const stockClass = isLowStock ? 'text-red-500 font-bold' : 'text-gray-500 dark:text-gray-400';

                    return `
                        <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    ${item.image_url ?
                            `<img src="${item.image_url}" class="w-10 h-10 rounded-lg object-cover" alt="${item.name}">` :
                            '<div class="w-10 h-10 rounded-lg bg-gray-200 dark:bg-slate-700 flex items-center justify-center"><i class="fas fa-pills text-gray-400"></i></div>'}
                                    <div>
                                        <p class="font-bold text-sm dark:text-white">${item.name}</p>
                                        <p class="text-xs text-gray-400">${formatCategory(item.category)}</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-center ${stockClass}">
                                ${item.current_stock}
                                ${isLowStock ? '<i class="fas fa-exclamation-triangle ml-1 text-xs"></i>' : ''}
                            </td>
                            <td class="px-6 py-4 text-center font-bold text-green-600">
                                $${parseFloat(item.price).toFixed(2)}
                            </td>
                            <td class="px-6 py-4 text-center text-sm dark:text-gray-300">
                                ${formatCategory(item.category) || 'Uncategorized'}
                            </td>
                            <td class="px-6 py-4 text-right">
                                <button onclick="openEditModal('${item.id}')" 
                                    class="text-blue-500 hover:text-blue-700 mr-3 transition-colors">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button onclick="deleteProduct('${item.id}', '${item.name.replace(/'/g, "\\'")}')" 
                                    class="text-red-500 hover:text-red-700 transition-colors">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

            // Format category name for display
            function formatCategory(category) {
                if (!category) return 'Uncategorized';
                // Convert camelCase to Title Case
                return category
                    .replace(/([A-Z])/g, ' $1')
                    .replace(/^./, str => str.toUpperCase())
                    .trim();
            }

            // Update analytics cards (Most Used, Recently Added, Low Stock)
            // Store analytics data for modal
            let analyticsData = {
                mostUsed: [],
                recentlyEdited: [],
                lowStock: []
            };

            async function updateInventoryAnalytics() {
                // Fetch REAL sales data from API (not assuming low stock = most sold)
                try {
                    const res = await fetch('/doctor/inventory/most-sold');
                    const data = await res.json();
                    if (data.success) {
                        analyticsData.mostUsed = data.mostSold || [];
                    }
                } catch (e) {
                    console.error('Failed to fetch most sold:', e);
                    analyticsData.mostUsed = [];
                }

                // Recently Added (by created_at)
                analyticsData.recentlyEdited = [...inventoryCache]
                    .sort((a, b) => new Date(b.created_at) - new Date(a.created_at))
                    .slice(0, 10); // Limit to 10 for modal

                // Low Stock (ALL items below threshold)
                analyticsData.lowStock = inventoryCache
                    .filter(item => item.current_stock <= (item.low_stock_threshold || 10))
                    .sort((a, b) => a.current_stock - b.current_stock);

                // Update Most Used Preview (show #1 only - REAL sales data)
                const mostUsedPreview = document.getElementById('most-used-preview');
                const mostUsedCount = document.getElementById('most-used-count');
                if (mostUsedCount) mostUsedCount.textContent = analyticsData.mostUsed.length;

                if (mostUsedPreview) {
                    if (analyticsData.mostUsed.length === 0) {
                        mostUsedPreview.innerHTML = `
                            <div class="text-center py-4">
                                <i class="fas fa-shopping-cart text-3xl text-gray-300 mb-2"></i>
                                <p class="text-gray-400 text-sm">No sales this shift yet</p>
                            </div>`;
                    } else {
                        const top = analyticsData.mostUsed[0];
                        mostUsedPreview.innerHTML = `
                            <div class="flex items-center gap-3 p-3 bg-white/70 dark:bg-slate-800/70 rounded-xl">
                                <div class="w-12 h-12 rounded-lg bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center">
                                    <i class="fas fa-fire text-blue-500 text-xl"></i>
                                </div>
                                <div class="flex-1">
                                    <p class="font-bold text-gray-800 dark:text-white">${top.name}</p>
                                    <p class="text-xs text-gray-500">${formatCategory(top.category)}</p>
                                </div>
                                <div class="text-right">
                                    <p class="font-bold text-blue-600">${top.total_sold} sold</p>
                                    <p class="text-xs text-gray-400">${top.order_count} orders</p>
                                </div>
                            </div>`;
                    }
                }

                // Update Recently Added Preview (show #1 only)
                const recentPreview = document.getElementById('recently-edited-preview');
                const recentCount = document.getElementById('recently-edited-count');
                if (recentCount) recentCount.textContent = analyticsData.recentlyEdited.length;

                if (recentPreview) {
                    if (analyticsData.recentlyEdited.length === 0) {
                        recentPreview.innerHTML = `
                            <div class="text-center py-4">
                                <i class="fas fa-inbox text-3xl text-gray-300 mb-2"></i>
                                <p class="text-gray-400 text-sm">No products yet</p>
                            </div>`;
                    } else {
                        const top = analyticsData.recentlyEdited[0];
                        recentPreview.innerHTML = `
                            <div class="flex items-center gap-3 p-3 bg-white/70 dark:bg-slate-800/70 rounded-xl">
                                <div class="w-12 h-12 rounded-lg bg-purple-100 dark:bg-purple-900/50 flex items-center justify-center">
                                    <i class="fas fa-clock text-purple-500 text-xl"></i>
                                </div>
                                <div class="flex-1">
                                    <p class="font-bold text-gray-800 dark:text-white">${top.name}</p>
                                    <p class="text-xs text-gray-500">${formatCategory(top.category)}</p>
                                </div>
                                <div class="text-right">
                                    <p class="font-bold text-purple-600">${new Date(top.created_at).toLocaleDateString()}</p>
                                    <p class="text-xs text-gray-400">added</p>
                                </div>
                            </div>`;
                    }
                }

                // Update Low Stock Preview (show #1 only)
                const lowStockPreview = document.getElementById('low-stock-preview');
                const lowStockCount = document.getElementById('low-stock-count');
                if (lowStockCount) lowStockCount.textContent = analyticsData.lowStock.length;

                if (lowStockPreview) {
                    if (analyticsData.lowStock.length === 0) {
                        lowStockPreview.innerHTML = `
                            <div class="text-center py-4">
                                <i class="fas fa-check-circle text-3xl text-green-400 mb-2"></i>
                                <p class="text-green-500 text-sm font-medium">All products in stock!</p>
                            </div>`;
                    } else {
                        const top = analyticsData.lowStock[0];
                        lowStockPreview.innerHTML = `
                            <div class="flex items-center gap-3 p-3 bg-white/70 dark:bg-slate-800/70 rounded-xl">
                                <div class="w-12 h-12 rounded-lg bg-red-100 dark:bg-red-900/50 flex items-center justify-center">
                                    <i class="fas fa-exclamation-triangle text-red-500 text-xl"></i>
                                </div>
                                <div class="flex-1">
                                    <p class="font-bold text-gray-800 dark:text-white">${top.name}</p>
                                    <p class="text-xs text-gray-500">${formatCategory(top.category)}</p>
                                </div>
                                <div class="text-right">
                                    <p class="font-bold text-red-600">${top.current_stock}</p>
                                    <p class="text-xs text-gray-400">left</p>
                                </div>
                            </div>`;
                    }
                }
            }

            // Show Analytics Modal with full list
            function showAnalyticsModal(type) {
                const modal = document.getElementById('analytics-modal');
                const title = document.getElementById('analytics-modal-title');
                const content = document.getElementById('analytics-modal-content');

                if (!modal || !title || !content) return;

                let items = [];
                let titleText = '';
                let colorClass = '';
                let iconClass = '';

                switch (type) {
                    case 'most-used':
                        items = analyticsData.mostUsed;
                        titleText = 'Most Used Products (This Shift)';
                        colorClass = 'blue';
                        iconClass = 'fa-fire';
                        break;
                    case 'recently-edited':
                        items = analyticsData.recentlyEdited;
                        titleText = 'Recently Added Products';
                        colorClass = 'purple';
                        iconClass = 'fa-clock';
                        break;
                    case 'low-stock':
                        items = analyticsData.lowStock;
                        titleText = `Low Stock Products (${items.length} items)`;
                        colorClass = 'red';
                        iconClass = 'fa-exclamation-triangle';
                        break;
                }

                title.innerHTML = `<i class="fas ${iconClass} text-${colorClass}-500 mr-2"></i>${titleText}`;

                if (items.length === 0) {
                    content.innerHTML = `
                        <div class="text-center py-12">
                            <i class="fas fa-inbox text-5xl text-gray-300 dark:text-gray-600 mb-4"></i>
                            <p class="text-gray-500 dark:text-gray-400">No products to show</p>
                        </div>`;
                } else {
                    content.innerHTML = items.map((item, index) => `
                        <div class="flex items-center gap-4 p-4 ${index % 2 === 0 ? 'bg-gray-50 dark:bg-slate-700/30' : ''} rounded-lg hover:bg-gray-100 dark:hover:bg-slate-700/50 transition-colors">
                            <div class="w-8 h-8 rounded-full bg-${colorClass}-100 dark:bg-${colorClass}-900/30 flex items-center justify-center text-${colorClass}-600 dark:text-${colorClass}-400 font-bold text-sm">
                                ${index + 1}
                            </div>
                            ${item.image_url ?
                            `<img src="${item.image_url}" class="w-12 h-12 rounded-lg object-cover" alt="${item.name}">` :
                            `<div class="w-12 h-12 rounded-lg bg-gray-200 dark:bg-slate-600 flex items-center justify-center"><i class="fas fa-pills text-gray-400"></i></div>`
                        }
                            <div class="flex-1">
                                <p class="font-bold text-gray-800 dark:text-white">${item.name}</p>
                                <p class="text-sm text-gray-500 dark:text-gray-400">${formatCategory(item.category)}</p>
                            </div>
                            <div class="text-right">
                                ${type === 'low-stock' ?
                            `<p class="font-bold text-red-500">${item.current_stock} left</p>
                                     <p class="text-xs text-gray-400">Threshold: ${item.low_stock_threshold || 10}</p>` :
                            type === 'recently-edited' ?
                                `<p class="font-bold text-purple-600 dark:text-purple-400">${new Date(item.created_at).toLocaleDateString()}</p>
                                     <p class="text-xs text-gray-400">Stock: ${item.current_stock}</p>` :
                                `<p class="font-bold text-blue-600 dark:text-blue-400">${item.total_sold || 0} sold</p>
                                     <p class="text-xs text-gray-400">${item.order_count || 0} orders</p>`
                        }
                            </div>
                            <button onclick="openEditModal('${item.id}')" class="text-gray-400 hover:text-blue-500 transition-colors">
                                <i class="fas fa-edit"></i>
                            </button>
                        </div>
                    `).join('');
                }

                modal.classList.remove('hidden');
            }

            function closeAnalyticsModal() {
                document.getElementById('analytics-modal')?.classList.add('hidden');
            }

            function openInventoryModal() {
                editingProductId = null;
                document.getElementById('modal-title').textContent = 'Add Product';
                document.getElementById('inventory-form').reset();
                document.getElementById('product-id').value = '';
                document.getElementById('inventory-modal').classList.remove('hidden');
            }

            function openEditModal(productId) {
                const product = inventoryCache.find(p => p.id === productId);
                if (!product) return;

                editingProductId = productId;
                document.getElementById('modal-title').textContent = 'Edit Product';
                document.getElementById('product-id').value = productId;
                document.getElementById('product-name').value = product.name;
                document.getElementById('product-price').value = product.price;
                document.getElementById('product-quantity').value = product.current_stock;
                document.getElementById('product-category').value = product.category || '';
                document.getElementById('product-low-stock').value = product.low_stock_threshold || 10;
                document.getElementById('product-description').value = product.description || '';
                document.getElementById('product-image').value = product.image_url || '';

                document.getElementById('inventory-modal').classList.remove('hidden');
            }

            function closeInventoryModal() {
                document.getElementById('inventory-modal').classList.add('hidden');
                document.getElementById('inventory-form').reset();
                editingProductId = null;
            }

            // Form submit handler
            document.getElementById('inventory-form')?.addEventListener('submit', async (e) => {
                e.preventDefault();

                const productData = {
                    name: document.getElementById('product-name').value,
                    price: parseFloat(document.getElementById('product-price').value),
                    quantity: parseInt(document.getElementById('product-quantity').value),
                    category: document.getElementById('product-category').value,
                    description: document.getElementById('product-description').value,
                    imageUrl: document.getElementById('product-image').value,
                    lowStockThreshold: parseInt(document.getElementById('product-low-stock').value) || 10
                };

                try {
                    let res;
                    if (editingProductId) {
                        // Update existing
                        res = await fetch(`/doctor/inventory/update/${editingProductId}`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(productData)
                        });
                    } else {
                        // Create new
                        res = await fetch('/doctor/inventory/create', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(productData)
                        });
                    }

                    const data = await res.json();

                    if (data.success) {
                        showToast('success', data.message || 'Product saved successfully');
                        closeInventoryModal();
                        loadInventory(); // Reload table
                    } else {
                        showToast('error', data.error || 'Failed to save product');
                    }
                } catch (err) {
                    console.error('Save product error:', err);
                    showToast('error', 'Network error');
                }
            });

            async function deleteProduct(productId, productName) {
                if (!confirm(`Delete "${productName}"?\n\nThis action cannot be undone.`)) return;

                try {
                    const res = await fetch(`/doctor/inventory/delete/${productId}`, {
                        method: 'DELETE'
                    });

                    const data = await res.json();

                    if (data.success) {
                        showToast('success', 'Product deleted');
                        loadInventory(); // Reload table
                    } else {
                        showToast('error', data.error || 'Failed to delete product');
                    }
                } catch (err) {
                    console.error('Delete product error:', err);
                    showToast('error', 'Network error');
                }
            }

            // Auto-load inventory when module active
            const inventoryModule = document.getElementById('module-inventory');
            if (inventoryModule) {
                const obs = new MutationObserver(() => {
                    if (!inventoryModule.classList.contains('hidden')) {
                        loadInventory();
                    }
                });
                obs.observe(inventoryModule, { attributes: true, attributeFilter: ['class'] });
            }

            // Placeholder for AI Assist (optional future feature)
            function aiAssistFill() {
                showToast('info', 'AI Assist is coming soon!');
            }


            // ================================================
            // ORDERS WORK QUEUE - Real-time Management
            // ================================================
            let currentOrderStatus = 'pending';
            let ordersCache = [];
            let expandedOrders = new Set(); // Track expanded orders
            let currentPage = 1;
            const itemsPerPage = 10;
            let filteredOrders = [];

            async function loadOrders(keepPage = false) {
                try {
                    const res = await fetch('/doctor/orders/all');
                    const data = await res.json();

                    if (data.success) {
                        ordersCache = data.orders;
                        updateOrderCounts(data.orders);
                        filterOrdersByStatus(currentOrderStatus, false, keepPage);
                    }
                } catch (err) {
                    console.error('Failed to load orders:', err);
                }
            }

            function updateOrderCounts(orders) {
                const counts = {
                    pending: 0,
                    scheduled: 0,
                    processing: 0,
                    completed: 0,
                    canceled: 0
                };

                orders.forEach(order => {
                    if (counts.hasOwnProperty(order.status)) {
                        counts[order.status]++;
                    }
                });

                Object.keys(counts).forEach(status => {
                    const el = document.getElementById(`count-${status}`);
                    if (el) el.textContent = counts[status];
                });
            }

            function applyOrderFilters(keepPage = false) {
                const queryInput = document.getElementById('order-search-input');
                const sortInput = document.getElementById('order-sort-input');
                const dateInput = document.getElementById('order-date-input');

                const query = queryInput ? queryInput.value.toLowerCase().trim() : '';
                const sort = sortInput ? sortInput.value : 'newest';
                const dateRange = dateInput ? dateInput.value : 'all';

                filteredOrders = ordersCache.filter(o => o.status === currentOrderStatus);

                // 1. Date Filter
                if (dateRange !== 'all') {
                    const today = new Date();
                    today.setHours(0, 0, 0, 0);

                    const yesterday = new Date(today);
                    yesterday.setDate(yesterday.getDate() - 1);

                    const lastWeek = new Date(today);
                    lastWeek.setDate(lastWeek.getDate() - 7);

                    filteredOrders = filteredOrders.filter(o => {
                        const d = new Date(o.created_at);
                        d.setHours(0, 0, 0, 0);

                        if (dateRange === 'today') return d.getTime() === today.getTime();
                        if (dateRange === 'yesterday') return d.getTime() === yesterday.getTime();
                        if (dateRange === 'week') return d >= lastWeek;
                        return true;
                    });
                }

                // 2. Search Filter
                if (query) {
                    filteredOrders = filteredOrders.filter(o => {
                        const matchesId = o.order_uid && o.order_uid.toLowerCase().includes(query);
                        const matchesName = o.user_name && o.user_name.toLowerCase().includes(query);
                        return matchesId || matchesName;
                    });
                }

                // 3. Sort
                filteredOrders.sort((a, b) => {
                    const da = new Date(a.created_at);
                    const db = new Date(b.created_at);
                    return sort === 'oldest' ? da - db : db - da; // Default to newest
                });

                if (!keepPage) currentPage = 1;
                renderPagination();
            }

            function filterOrdersByStatus(status, shouldLoad = true, keepPage = false) {
                currentOrderStatus = status;

                // Update tab active state
                document.querySelectorAll('.order-status-tab').forEach(tab => {
                    tab.classList.remove('active', 'bg-primary', 'text-white');
                    tab.classList.add('text-gray-600', 'dark:text-gray-400');
                });
                const activeTab = document.querySelector(`[data-status="${status}"]`);
                if (activeTab) {
                    activeTab.classList.add('active', 'bg-primary', 'text-white');
                    activeTab.classList.remove('text-gray-600', 'dark:text-gray-400');
                }

                if (shouldLoad) {
                    loadOrders(keepPage);
                } else {
                    applyOrderFilters(keepPage);
                }
            }

            function changePage(page) {
                if (page < 1 || page > Math.ceil(filteredOrders.length / itemsPerPage)) return;
                currentPage = page;
                renderPagination();
                document.getElementById('module-orders').scrollIntoView({ behavior: 'smooth' });
            }

            function renderPagination() {
                const container = document.getElementById('orders-container');
                const totalPages = Math.ceil(filteredOrders.length / itemsPerPage);

                if (filteredOrders.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-12 text-gray-400">
                            <i class="fas fa-inbox text-5xl mb-3 opacity-30"></i>
                            <p class="text-lg font-bold">No ${currentOrderStatus} orders found</p>
                        </div>
                    `;
                    return;
                }

                const startIndex = (currentPage - 1) * itemsPerPage;
                const slice = filteredOrders.slice(startIndex, startIndex + itemsPerPage);

                let html = slice.map(order => {
                    const isExpanded = expandedOrders.has(order.id);
                    return `
                    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-gray-100 dark:border-slate-700 overflow-hidden transition-all hover:shadow-lg">
                        <!-- Order Header -->
                        <div class="p-6 flex items-center justify-between cursor-pointer" onclick="toggleOrderDetails('${order.id}')">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white font-bold text-lg">
                                    ${order.user_name ? order.user_name.charAt(0).toUpperCase() : 'U'}
                                </div>
                                <div>
                                    <h4 class="font-bold dark:text-white">${order.user_name || 'Unknown'}</h4>
                                    <div class="flex items-center gap-3 text-xs text-gray-400 mt-1">
                                        <span class="font-mono">#${order.order_uid}</span>
                                        <span>•</span>
                                        <span>${new Date(order.created_at).toLocaleString()}</span>
                                        <span>•</span>
                                        <span class="font-bold text-green-600">$${parseFloat(order.total_price).toFixed(2)}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                ${order.shift_id ? `<span class="px-3 py-1 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded-full text-xs font-bold" title="Shift ID: ${order.shift_id}">📍 ${order.doctor_name || 'Shift Assigned'}</span>` : '<span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-500 rounded-full text-xs font-bold">⏳ Unassigned</span>'}
                                <i class="fas fa-chevron-down text-gray-400 transition-transform ${isExpanded ? 'rotate-180' : ''}" id="chevron-${order.id}" style="${isExpanded ? 'transform: rotate(180deg);' : ''}"></i>
                            </div>
                        </div>

                        <!-- Order Details (Hidden by default) -->
                        <div id="details-${order.id}" class="${isExpanded ? '' : 'hidden'} border-t border-gray-100 dark:border-slate-700 bg-gray-50 dark:bg-slate-900/50">
                            <div class="p-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
                                <!-- Order Items -->
                                <div class="lg:col-span-2">
                                    <h5 class="font-bold text-sm text-gray-500 uppercase mb-3">Order Items</h5>
                                    <div class="space-y-2" id="items-${order.id}">
                                        <div class="text-center text-gray-400 py-4">
                                            <i class="fas fa-spinner fa-spin"></i> Loading items...
                                        </div>
                                    </div>
                                </div>

                                <!-- Customer & Actions -->
                                <div class="space-y-4">
                                    <!-- Customer Info -->
                                    <div class="bg-white dark:bg-slate-800 p-4 rounded-xl">
                                        <h5 class="font-bold text-sm text-gray-500 uppercase mb-3">Customer</h5>
                                        <p class="font-bold dark:text-white">${order.user_name || 'N/A'}</p>
                                        <p class="text-sm text-gray-400">${order.user_email || 'No email'}</p>
                                        <p class="text-sm text-gray-400 mt-2">${order.phone_number || order.user_phone || 'No phone'}</p>
                                    </div>

                                    <!-- Prescription Link -->
                                    ${order.prescription_id ? `
                                        <div class="bg-purple-50 dark:bg-purple-900/20 p-4 rounded-xl border-2 border-purple-200 dark:border-purple-800">
                                            <h5 class="font-bold text-sm text-purple-600 uppercase mb-2">Prescription</h5>
                                            <a href="/doctor/prescriptions/${order.prescription_id}/process" 
                                               class="text-sm text-purple-600 dark:text-purple-400 underline hover:text-purple-700 flex items-center gap-2">
                                                <i class="fas fa-file-medical"></i>
                                                View Prescription
                                            </a>
                                        </div>
                                    ` : ''}

                                    <!-- Actions -->
                                    <div class="space-y-2">
                                        ${order.status === 'pending' || order.status === 'scheduled' ? `
                                            <button onclick="changeOrderStatus('${order.id}', 'processing')"
                                                class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 rounded-lg transition-colors flex items-center justify-center gap-2">
                                                <i class="fas fa-play"></i>
                                                Start Processing
                                            </button>
                                        ` : ''}
                                        ${order.status === 'processing' ? `
                                            <button onclick="changeOrderStatus('${order.id}', 'completed')"
                                                class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-2 rounded-lg transition-colors flex items-center justify-center gap-2">
                                                <i class="fas fa-check"></i>
                                                Mark Complete
                                            </button>
                                        ` : ''}
                                        ${(order.status === 'pending' || order.status === 'processing') ? `
                                            <button onclick="changeOrderStatus('${order.id}', 'canceled')"
                                                class="w-full bg-red-500 hover:bg-red-600 text-white font-bold py-2 rounded-lg transition-colors flex items-center justify-center gap-2">
                                                <i class="fas fa-times"></i>
                                                Cancel Order
                                            </button>
                                        ` : ''}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    `;
                }).join('');

                // Pagination Controls
                if (totalPages > 1) {
                    html += `
                        <div class="flex items-center justify-center gap-4 mt-8">
                            <button onclick="changePage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''} 
                                class="w-10 h-10 rounded-xl bg-white dark:bg-slate-800 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-700 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-sm border border-gray-100 dark:border-slate-700">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            
                            <span class="text-sm font-bold text-gray-500">
                                Page <span class="text-primary">${currentPage}</span> of ${totalPages}
                            </span>
                            
                            <button onclick="changePage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''}
                                class="w-10 h-10 rounded-xl bg-white dark:bg-slate-800 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-700 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-sm border border-gray-100 dark:border-slate-700">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    `;
                }

                container.innerHTML = html;

                expandedOrders.forEach(orderId => {
                    if (document.getElementById(`items-${orderId}`)) {
                        loadOrderItems(orderId);
                    }
                });
            }

            function toggleOrderDetails(orderId) {
                const details = document.getElementById(`details-${orderId}`);
                const chevron = document.getElementById(`chevron-${orderId}`);
                const itemsContainer = document.getElementById(`items-${orderId}`);

                if (details.classList.contains('hidden')) {
                    details.classList.remove('hidden');
                    chevron.style.transform = 'rotate(180deg)';
                    expandedOrders.add(orderId); // Track state

                    // Load order items if not loaded yet
                    if (itemsContainer.innerHTML.includes('Loading')) {
                        loadOrderItems(orderId);
                    }
                } else {
                    details.classList.add('hidden');
                    chevron.style.transform = 'rotate(0deg)';
                    expandedOrders.delete(orderId); // Track state
                }
            }

            async function loadOrderItems(orderId) {
                try {
                    const res = await fetch(`/doctor/orders/${orderId}/items`);
                    const data = await res.json();

                    const container = document.getElementById(`items-${orderId}`);
                    if (data.success && data.items.length > 0) {
                        container.innerHTML = data.items.map(item => `
                            <div class="bg-white dark:bg-slate-800 p-3 rounded-lg flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center text-blue-600">
                                        <i class="fas fa-pills text-sm"></i>
                                    </div>
                                    <div>
                                        <p class="font-bold text-sm dark:text-white">${item.medicine_name}</p>
                                        <p class="text-xs text-gray-400">Qty: ${item.quantity}</p>
                                    </div>
                                </div>
                                <span class="font-bold text-sm text-green-600">$${parseFloat(item.price * item.quantity).toFixed(2)}</span>
                            </div>
                        `).join('');
                    } else {
                        container.innerHTML = '<p class="text-center text-gray-400 text-sm">No items found</p>';
                    }
                } catch (err) {
                    console.error('Failed to load items:', err);
                    document.getElementById(`items-${orderId}`).innerHTML = '<p class="text-center text-red-400 text-sm">Error loading items</p>';
                }
            }

            async function changeOrderStatus(orderId, newStatus) {
                if (!confirm(`Are you sure you want to change this order to ${newStatus}?`)) return;

                try {
                    const res = await fetch('/doctor/orders/status', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ orderId, newState: newStatus })
                    });

                    if (res.ok) {
                        showToast('success', `Order ${newStatus}!`);
                        loadOrders(); // Reload to update
                    } else {
                        showToast('error', 'Failed to update order');
                    }
                } catch (err) {
                    console.error(err);
                    showToast('error', 'Failed to update order');
                }
            }

            // Auto-load orders when Orders module is shown
            const ordersObserver = new MutationObserver(() => {
                const ordersModule = document.getElementById('module-orders');
                if (ordersModule && !ordersModule.classList.contains('hidden')) {
                    loadOrders();
                }
            });

            // Start observing
            const ordersModule = document.getElementById('module-orders');
            if (ordersModule) {
                ordersObserver.observe(ordersModule, { attributes: true, attributeFilter: ['class'] });

                // Real-time polling every 3 seconds when module is active
                setInterval(() => {
                    if (!ordersModule.classList.contains('hidden')) {
                        loadOrders(true);
                    }
                }, 3000);
            }
        </script>
        <!-- CHART JS -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

        <script>
            // ================================================
            // REPORTS MODULE LOGIC
            // ================================================
            let revenueChart, ordersChart, returnsChart, requestsChart;

            async function loadReports() {
                const range = document.getElementById('report-range').value;
                const turnoverTbody = document.getElementById('turnover-table-body');
                turnoverTbody.innerHTML = '<tr><td colspan="3" class="text-center py-4"><i class="fas fa-spinner fa-spin"></i> Loading...</td></tr>';

                try {
                    const res = await fetch(`/doctor/reports/analytics?range=${range}`);
                    const data = await res.json();

                    if (data.success) {
                        const { revenueOverTime, ordersOverTime, returnsVsSales, requestsStats, topMovers } = data.analytics;

                        renderRevenueChart(revenueOverTime);
                        renderOrdersChart(ordersOverTime);
                        renderReturnsChart(returnsVsSales);
                        renderRequestsChart(requestsStats);
                        renderTurnoverTable(topMovers);
                    }
                } catch (e) {
                    console.error("Failed to load reports:", e);
                    turnoverTbody.innerHTML = '<tr><td colspan="3" class="text-center py-4 text-red-500">Failed to load data</td></tr>';
                }
            }

            function renderRevenueChart(data) {
                const ctx = document.getElementById('chart-revenue').getContext('2d');
                if (revenueChart) revenueChart.destroy();

                const isDark = document.documentElement.classList.contains('dark');
                const textColor = isDark ? '#cbd5e1' : '#64748b';

                revenueChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: data.map(d => new Date(d.date).toLocaleDateString()),
                        datasets: [{
                            label: 'Revenue ($)',
                            data: data.map(d => d.amount),
                            borderColor: '#3b82f6',
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { grid: { color: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)' }, ticks: { color: textColor } },
                            x: { grid: { display: false }, ticks: { color: textColor } }
                        }
                    }
                });
            }

            function renderOrdersChart(data) {
                const ctx = document.getElementById('chart-orders').getContext('2d');
                if (ordersChart) ordersChart.destroy();
                const isDark = document.documentElement.classList.contains('dark');
                const textColor = isDark ? '#cbd5e1' : '#64748b';

                ordersChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: data.map(d => new Date(d.date).toLocaleDateString()),
                        datasets: [{
                            label: 'Orders',
                            data: data.map(d => d.count),
                            backgroundColor: '#8b5cf6',
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)' }, ticks: { stepSize: 1, color: textColor } },
                            x: { grid: { display: false }, ticks: { color: textColor } }
                        }
                    }
                });
            }

            function renderReturnsChart(data) {
                const ctx = document.getElementById('chart-returns').getContext('2d');
                if (returnsChart) returnsChart.destroy();
                const isDark = document.documentElement.classList.contains('dark');
                const textColor = isDark ? '#cbd5e1' : '#64748b';

                returnsChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Net Sales', 'Start Returns'],
                        datasets: [{
                            data: [data.sales, data.returns],
                            backgroundColor: ['#22c55e', '#ef4444'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: { legend: { position: 'bottom', labels: { color: textColor } } }
                    }
                });
            }

            function renderRequestsChart(data) {
                const ctx = document.getElementById('chart-requests').getContext('2d');
                if (requestsChart) requestsChart.destroy();
                const isDark = document.documentElement.classList.contains('dark');
                const textColor = isDark ? '#cbd5e1' : '#64748b';

                requestsChart = new Chart(ctx, {
                    type: 'pie',
                    data: {
                        labels: data.map(d => d.name),
                        datasets: [{
                            data: data.map(d => d.count),
                            backgroundColor: [
                                '#f59e0b', '#3b82f6', '#ec4899', '#10b981', '#6366f1'
                            ],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'right', labels: { color: textColor } } }
                    }
                });
            }

            function renderTurnoverTable(data) {
                const tbody = document.getElementById('turnover-table-body');
                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="3" class="text-center py-4 text-gray-400">No data available</td></tr>';
                    return;
                }

                tbody.innerHTML = data.map(item => `
                     <tr class="bg-white border-b dark:bg-slate-800 dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700/50">
                        <td class="px-6 py-4 font-medium text-gray-900 dark:text-white whitespace-nowrap">
                            ${item.name}
                        </td>
                         <td class="px-6 py-4 text-center">
                            ${item.total_sold}
                        </td>
                         <td class="px-6 py-4 text-right font-bold text-green-600">
                            $${parseFloat(item.revenue).toFixed(2)}
                        </td>
                     </tr>
                 `).join('');
            }

            // ================================================
            // VIEW SHIFT DETAILS LOGIC
            // ================================================
            async function viewShiftDetails(shiftId) {
                try {
                    const res = await fetch(`/doctor/shift/${shiftId}`);
                    const data = await res.json();

                    if (!data.success) {
                        return showToast('error', data.message || 'Failed to load shift');
                    }

                    const s = data.shift;
                    const startTime = new Date(s.opened_at).toLocaleString();
                    const endTime = s.closed_at ? new Date(s.closed_at).toLocaleString() : 'Active';
                    const duration = s.closed_at ?
                        ((new Date(s.closed_at) - new Date(s.opened_at)) / (1000 * 60 * 60)).toFixed(2) + ' hrs'
                        : 'Currently Running';

                    const modalHtml = `
                        <div id="shift-details-modal" class="fixed inset-0 z-[60] flex items-center justify-center bg-black/50 backdrop-blur-sm animate-fade-in">
                            <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden border border-gray-100 dark:border-slate-800 transform scale-100 transition-transform">
                                <div class="p-6 border-b border-gray-100 dark:border-slate-800 flex justify-between items-center bg-gray-50 dark:bg-slate-800/50">
                                    <h3 class="font-bold text-lg dark:text-white flex items-center gap-2">
                                        <i class="fas fa-history text-primary"></i> Shift Details
                                    </h3>
                                    <button onclick="document.getElementById('shift-details-modal').remove()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors">
                                        <i class="fas fa-times text-xl"></i>
                                    </button>
                                </div>
                                <div class="p-6 space-y-4">
                                    <div class="grid grid-cols-2 gap-4">
                                        <div class="bg-blue-50 dark:bg-slate-800 p-3 rounded-xl border border-blue-100 dark:border-slate-700">
                                            <p class="text-xs text-blue-500 font-bold uppercase mb-1">Total Sales</p>
                                            <p class="text-xl font-black text-gray-800 dark:text-gray-100">$${parseFloat(s.gross_revenue).toFixed(2)}</p>
                                        </div>
                                        <div class="bg-green-50 dark:bg-slate-800 p-3 rounded-xl border border-green-100 dark:border-slate-700">
                                            <p class="text-xs text-green-500 font-bold uppercase mb-1">Net Revenue</p>
                                            <p class="text-xl font-black text-gray-800 dark:text-gray-100">$${parseFloat(s.net_revenue).toFixed(2)}</p>
                                        </div>
                                    </div>
                                    
                                    <div class="space-y-3">
                                        <div class="flex justify-between border-b border-gray-100 dark:border-slate-800 pb-2">
                                            <span class="text-gray-500 text-sm">Status</span>
                                            <span class="font-bold uppercase text-xs px-2 py-0.5 rounded ${s.status === 'open' ? 'bg-green-100 text-green-600' : 'bg-gray-100 text-gray-600'}">${s.status}</span>
                                        </div>
                                        <div class="flex justify-between border-b border-gray-100 dark:border-slate-800 pb-2">
                                            <span class="text-gray-500 text-sm">Start Time</span>
                                            <span class="font-medium dark:text-gray-300 text-sm">${startTime}</span>
                                        </div>
                                        <div class="flex justify-between border-b border-gray-100 dark:border-slate-800 pb-2">
                                            <span class="text-gray-500 text-sm">End Time</span>
                                            <span class="font-medium dark:text-gray-300 text-sm">${endTime}</span>
                                        </div>
                                        <div class="flex justify-between border-b border-gray-100 dark:border-slate-800 pb-2">
                                            <span class="text-gray-500 text-sm">Duration</span>
                                            <span class="font-medium dark:text-gray-300 text-sm">${duration}</span>
                                        </div>
                                        <div class="flex justify-between border-b border-gray-100 dark:border-slate-800 pb-2">
                                            <span class="text-gray-500 text-sm">Orders Processed</span>
                                            <span class="font-bold dark:text-white">${s.total_orders}</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-gray-500 text-sm">Returns Processed</span>
                                            <span class="font-bold text-red-500">${s.total_returns}</span>
                                        </div>
                                    </div>

                                    <div class="pt-4 mt-2">
                                        <a href="/doctor/shift/${s.id}/export-pdf" target="_blank" 
                                           class="web-app-button w-full flex items-center justify-center gap-2 py-3 rounded-xl font-bold bg-primary text-white shadow-lg shadow-primary/30 hover:shadow-primary/50 transition-all">
                                            <i class="fas fa-file-pdf"></i> Download Full Report
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    document.body.insertAdjacentHTML('beforeend', modalHtml);

                } catch (e) {
                    console.error(e);
                    showToast('error', 'Network error');
                }
            }

            // Auto-load reports when module active
            const reportModule = document.getElementById('module-reports');
            if (reportModule) {
                const obs = new MutationObserver(() => {
                    if (!reportModule.classList.contains('hidden')) {
                        loadReports();
                    }
                });
                obs.observe(reportModule, { attributes: true, attributeFilter: ['class'] });
            }
        </script>
    </body>

</html>