                                        <!-- Message -->
                                        <textarea id="annMessage" rows="4"
                                            class="w-full bg-gray-50 dark:bg-slate-900 border-none rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-primary dark:text-white"
                                            placeholder="Message content..." required></textarea>

                                        <!-- Target Audience -->
                                        <div>
                                            <label class="block text-xs font-bold text-gray-500 mb-1 ml-1">Target
                                                Audience</label>
                                            <select id="annTarget"
                                                class="w-full bg-gray-50 dark:bg-slate-900 border-none rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-primary dark:text-white">
                                                <option value="all">All Users</option>
                                                <option value="active_orders">Active Orders only</option>
                                                <option value="staff">Staff Only (Doctors/Admin)</option>
                                            </select>
                                        </div>

                                        <!-- Schedule (Optional) -->
                                        <div>
                                            <label class="block text-xs font-bold text-gray-500 mb-1 ml-1">Schedule Send
                                                (Optional)</label>
                                            <input type="datetime-local" id="annSchedule"
                                                class="w-full bg-gray-50 dark:bg-slate-900 border-none rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-primary dark:text-white">
                                            <p class="text-[10px] text-gray-400 mt-1 ml-1">Leave blank to send
                                                immediately.
                                            </p>
                                        </div>

                                        <button type="submit"
                                            class="w-full bg-blue-600 text-white font-bold py-3 rounded-xl text-sm hover:bg-blue-700 shadow-lg shadow-blue-500/30 transition-all transform active:scale-95">
                                            <i class="fas fa-paper-plane mr-2"></i> Post Announcement
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <div class="lg:col-span-2 space-y-4" id="announcementsList">
                                <!-- Announcements will load here -->
                                <p class="text-center text-gray-400">Loading announcements...</p>
                            </div>
                        </div>
                    </div>

                    <!-- MODULE: REPORTS -->
                    <div id="module-reports" class="module-content hidden animate-fade-in">
                        <div class="mb-6 flex items-center justify-between">
                            <div>
                                <h2 class="text-2xl font-black dark:text-white mb-2">Reports & Analytics</h2>
                                <p class="text-sm text-gray-500">Business performance metrics and insights</p>
                            </div>
                            <div class="flex gap-2">
                                <select id="report-range" onchange="loadReports()"
                                    class="bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-700 rounded-lg text-sm px-3 py-2">
                                    <option value="7">Last 7 Days</option>
                                    <option value="30" selected>Last 30 Days</option>
                                    <option value="90">Last 3 Months</option>
                                </select>
                                <button onclick="loadReports()"
                                    class="bg-primary text-white px-4 py-2 rounded-lg text-sm font-bold">
                                    <i class="fas fa-sync-alt mr-2"></i>Refresh
                                </button>
                            </div>
                        </div>

                        <!-- Charts Grid -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                            <!-- Revenue Chart -->
                            <div
                                class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-gray-100 dark:border-slate-700 shadow-sm">
                                <h3 class="font-bold dark:text-white mb-4">Revenue Trends</h3>
                                <div class="h-64 relative">
                                    <canvas id="chart-revenue"></canvas>
                                </div>
                            </div>

                            <!-- Orders Chart -->
                            <div
                                class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-gray-100 dark:border-slate-700 shadow-sm">
                                <h3 class="font-bold dark:text-white mb-4">Orders Overview</h3>
                                <div class="h-64 relative">
                                    <canvas id="chart-orders"></canvas>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                            <!-- Returns vs Sales -->
                            <div
                                class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-gray-100 dark:border-slate-700 shadow-sm">
                                <h3 class="font-bold dark:text-white mb-4">Returns vs Sales</h3>
                                <div class="h-64 relative">
                                    <canvas id="chart-returns"></canvas>
                                </div>
                            </div>

                            <!-- Category Distribution -->
                            <div
                                class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-gray-100 dark:border-slate-700 shadow-sm">
                                <h3 class="font-bold dark:text-white mb-4">Requested Medicines Stats</h3>
                                <div class="h-64 relative">
                                    <canvas id="chart-requests"></canvas>
                                </div>
                            </div>
                        </div>

                        <div
                            class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-gray-100 dark:border-slate-700 shadow-sm mb-6">
                            <h3 class="font-bold dark:text-white mb-4">Inventory Turnover (Top Movers)</h3>
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm text-left">
                                    <thead
                                        class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-slate-700 dark:text-gray-400">
                                        <tr>
                                            <th class="px-6 py-3">Medicine Name</th>
                                            <th class="px-6 py-3 text-center">Total Sold</th>
                                            <th class="px-6 py-3 text-right">Revenue Generated</th>
                                        </tr>
                                    </thead>
                                    <tbody id="turnover-table-body">
                                        <tr>
                                            <td colspan="3" class="text-center py-4">Loading data...</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </main>
        </div>
        <!-- TOAST NOTIFICATION CONTAINER -->
        <div id="toast-container" class="fixed bottom-6 right-6 z-[60] flex flex-col gap-3"></div>
        <script src="/socket.io/socket.io.js"></script>
        <script>
            const socket = io();
            // 1. Orders
            socket.on('orders:new', (data) => {
                showToast(`New Order #${data.id.substring(0, 8)}`, `Total: $${parseFloat(data.total_price).toFixed(2)}`, 'blue');
                updateBadge('orders', 1);
                // In a full implementation, we would also prepend the new order to the table if the Order module is active
            });
            // 2. Prescriptions
            socket.on('prescription:new', (data) => {
                showToast(`New Prescription`, `Uploaded by ${data.user_name}`, 'purple');
                updateBadge('prescriptions', 1);
            });
            // 3. Announcements
            socket.on('announcement:new', (data) => {
                showToast(`📢 ${data.title}`, data.message.substring(0, 50) + '...', 'indigo');
                // If announcement module is open, prepend it
                const list = document.getElementById('announcementsList');
                if (list && list.offsetParent !== null) {
                    prependAnnouncement(data);
                }
            });
            // 4. Pharmacy Status (Sync across tabs)
            socket.on('pharmacy:status', (data) => {
                const label = document.getElementById('pharmacyStatusLabel');
                const checkbox = document.querySelector('input[onchange="togglePharmacy(this)"]');
                if (label) {
                    label.textContent = data.isOpen ? 'OPEN' : 'CLOSED';
                    label.className = `text-xs font-black uppercase ${data.isOpen ? 'text-green-500' : 'text-red-500'}`;
                }
                if (checkbox) checkbox.checked = data.isOpen;
            });
            function showModule(moduleId) {
                // Hide all
                document.querySelectorAll('.module-content').forEach(el => el.classList.add('hidden'));
                document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('bg-gray-50', 'dark:bg-slate-800', 'text-primary'));
                // Show active
                const activeModule = document.getElementById('module-' + moduleId);
                if (activeModule) activeModule.classList.remove('hidden');
                // Update page title
                document.getElementById('page-title').textContent = moduleId.charAt(0).toUpperCase() + moduleId.slice(1);
                // Scroll to top of content area  
                const contentArea = document.getElementById('content-area');
                if (contentArea) {
                    contentArea.scrollTop = 0; // Force immediate scroll
                    contentArea.scrollTo({ top: 0, behavior: 'instant' }); // Instant, not smooth
                }
            }
            function toggleSidebar() {
                const sb = document.getElementById('sidebar');
                sb.classList.toggle('-translate-x-full');
            }
            function showToast(title, message, color = 'blue') {
                const container = document.getElementById('toast-container');
                const toast = document.createElement('div');
                toast.className = `bg-white dark:bg-slate-800 border-l-4 border-${color}-500 shadow-xl rounded-r-xl p-4 w-72 transform translate-x-full transition-all duration-300 flex items-start gap-3`;
                toast.innerHTML = `
                <div class="text-${color}-500 mt-1"><i class="fas fa-info-circle"></i></div>
                <div>
                    <h4 class="font-bold text-sm dark:text-white">${title}</h4>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">${message}</p>
                </div>
            `;
                container.appendChild(toast);
                // Animate in
                setTimeout(() => toast.classList.remove('translate-x-full'), 100);
                // Animate out
                setTimeout(() => {
                    toast.classList.add('translate-x-full', 'opacity-0');
                    setTimeout(() => toast.remove(), 300);
                }, 5000);
            }
            function updateBadge(type, increment) {
                const badge = document.getElementById(`badge-${type}`);
                if (badge) {
                    let count = parseInt(badge.innerText) || 0;
                    badge.innerText = count + increment;
                    badge.classList.remove('hidden');
                }
            }
            // --- DATA FUNCTIONS ---
            async function togglePharmacy(input) {
                // Optimistic UI update handled by socket, but we trigger the POST here
                try {
                    await fetch('/doctor/pharmacy/toggle', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ isOpen: input.checked })
                    });
                } catch (err) {
                    console.error(err);
                    input.checked = !input.checked; // Revert on error
                    alert('Failed to update status');
                }
            }

            async function updateStatus(orderId, newState) {
                try {
                    const res = await fetch('/doctor/orders/status', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ orderId, newState })
                    });
                    if (res.ok) window.location.reload(); // Simple reload for now, or remove row from DOM
                } catch (e) { console.error(e); }
            }
            // Chat & Announcement Loaders
            async function loadAnnouncements() {
                const list = document.getElementById('announcementsList');
                try {
                    const res = await fetch('/doctor/announcements');
                    const data = await res.json();
                    if (data.success) {
                        list.innerHTML = '';
                        if (data.announcements.length === 0) list.innerHTML = '<p class="text-gray-400 text-sm">No announcements.</p>';
                        data.announcements.forEach(prependAnnouncement);
                    }
                } catch (e) { list.innerHTML = 'Error loading.'; }
            }
            function prependAnnouncement(data) {
                const list = document.getElementById('announcementsList');
                const div = document.createElement('div');
                div.className = 'bg-white dark:bg-slate-800 p-4 rounded-xl border border-gray-100 dark:border-slate-700 shadow-sm animate-fade-in relative overflow-hidden';

                // Status Badge
                let statusBadge = '';
                if (data.status === 'scheduled') {
                    statusBadge = `<span class="bg-yellow-100 text-yellow-700 text-[10px] font-bold px-2 py-0.5 rounded-full ml-auto">SCHEDULED</span>`;
                } else {
                    statusBadge = `<span class="bg-green-100 text-green-700 text-[10px] font-bold px-2 py-0.5 rounded-full ml-auto">SENT</span>`;
                }

                div.innerHTML = `
                <div class="flex justify-between items-start mb-2 gap-2">
                    <div>
                        <h4 class="font-bold text-sm dark:text-white flex items-center gap-2">
                            ${data.title}
                            <span class="text-[10px] bg-gray-100 dark:bg-slate-700 px-1.5 py-0.5 rounded text-gray-500 uppercase">${data.target_audience.replace('_', ' ')}</span>
                        </h4>
                        <span class="text-[10px] text-gray-400">
                            ${data.status === 'scheduled' ? 'Scheduled for: ' + new Date(data.scheduled_for).toLocaleString() : 'Sent: ' + new Date(data.created_at).toLocaleDateString()}
                        </span>
                    </div>
                    ${statusBadge}
                </div>
                <p class="text-xs text-gray-600 dark:text-gray-300 leading-relaxed">${data.message}</p>
             `;
                list.prepend(div);
            }

            async function postAnnouncement() {
                const title = document.getElementById('annTitle').value;
                const message = document.getElementById('annMessage').value;
                const target = document.getElementById('annTarget').value;
                const scheduledFor = document.getElementById('annSchedule').value;

                try {
                    const res = await fetch('/doctor/announcements/create', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ title, message, target, scheduledFor })
                    });
                    const data = await res.json();

                    if (data.success) {
                        document.getElementById('annTitle').value = '';
                        document.getElementById('annMessage').value = '';
                        document.getElementById('annSchedule').value = '';
                        showToast('Success', 'Announcement created', 'green');
                        // Manually prepend locally to show feedback immediately (or reload list)
                        prependAnnouncement(data.announcement);
                    } else {
                        showToast('error', data.error || 'Failed to post');
                    }
                } catch (e) { showToast('error', 'Network Error'); }
            }

            // Auto-load Announcements when module active
            const annModule = document.getElementById('module-announcements');
            if (annModule) {
                const obs = new MutationObserver(() => {
                    if (!annModule.classList.contains('hidden')) {
                        loadAnnouncements();
                    }
                });
                obs.observe(annModule, { attributes: true, attributeFilter: ['class'] });
            }
            // ================================================
            // CHAT MODULE (Realtime)
            // ================================================

            let activeChatId = null;
            let activeOnlineUsers = new Set();
            let activeChatsCache = [];

            // Socket Listeners for Chat
            socket.on('online:users', (users) => {
                activeOnlineUsers = new Set(users);
                updateChatListStatus();
            });

            socket.on('user:online', (data) => {
                activeOnlineUsers.add(data.userId);
                updateChatListStatus();
            });

            socket.on('user:offline', (data) => {
                activeOnlineUsers.delete(data.userId);
                updateChatListStatus();
            });

            socket.on('chat:message', (data) => {
                console.log('Socket received chat:message:', data);
                console.log('ActiveChatId:', activeChatId, 'Type:', typeof activeChatId);

                // If this is the active chat, append message
                // Use loose equality (==) for string vs number comparison
                if (activeChatId && (data.chatId == activeChatId)) {
                    console.log('Appending message to active chat');
                    appendMessage(data.message, false);
                } else {
                    console.log('Message not for active chat, showing toast');
                    // Show notification badge or toast
                    showToast('info', `New message from ${data.senderName}`);
                    // Refresh list to show unread? 
                    loadActiveChats(); // Re-fetch to sort by recent
                }
            });

            async function loadActiveChats() {
                const list = document.getElementById('chatListArea');
                list.innerHTML = '<div class="text-center py-4 text-gray-400"><i class="fas fa-spinner fa-spin"></i> Loading...</div>';

                try {
                    const res = await fetch('/doctor/chats/active');
                    const data = await res.json();
                    if (data.success) {
                        activeChatsCache = data.chats;
                        renderChatList();
                    }
                } catch (e) { list.innerHTML = 'Error loading.'; }
            }

            function renderChatList() {
                const list = document.getElementById('chatListArea');
                if (activeChatsCache.length === 0) {
                    list.innerHTML = '<p class="text-gray-400 text-sm p-4">No active conversations.</p>';
                    return;
                }

                list.innerHTML = activeChatsCache.map(chat => {
                    const isOnline = activeOnlineUsers.has(chat.patient_id);
                    return `
                    <div onclick="openChat('${chat.id}', '${chat.patient_name}', '${chat.patient_id}')" 
                        id="chat-item-${chat.id}"
                        class="p-4 mb-2 rounded-xl bg-gray-50 dark:bg-slate-700/50 hover:bg-white dark:hover:bg-slate-700 border border-transparent hover:border-gray-200 cursor-pointer transition-all relative group">
                        
                        <div class="flex justify-between items-start">
                            <div class="flex items-center gap-3">
                                <div class="relative">
                                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold">
                                        ${chat.patient_name.charAt(0)}
                                    </div>
                                    <span class="absolute bottom-0 right-0 w-3 h-3 border-2 border-white dark:border-slate-800 rounded-full ${isOnline ? 'bg-green-500' : 'bg-gray-400'}" id="status-dot-${chat.patient_id}"></span>
                                </div>
                                <div>
                                    <h4 class="font-bold text-sm dark:text-white">${chat.patient_name}</h4>
                                    <p class="text-[10px] text-gray-400 truncate max-w-[120px]">
                                        ${chat.latest_order_uid ?
                            `<span class="text-blue-500 bg-blue-50 dark:bg-blue-900/30 px-1 rounded">Ordered #${chat.latest_order_uid}</span>`
                            : 'No active orders'}
                                    </p>
                                </div>
                            </div>
                            <span class="text-[9px] text-gray-400 whitespace-nowrap">${formatTime(chat.last_message_at)}</span>
                        </div>
                    </div>
                    `;
                }).join('');
            }

            function updateChatListStatus() {
                // List dots
                activeChatsCache.forEach(chat => {
                    const dot = document.getElementById(`status-dot-${chat.patient_id}`);
                    if (dot) {
                        const isOnline = activeOnlineUsers.has(chat.patient_id);
                        dot.className = `absolute bottom-0 right-0 w-3 h-3 border-2 border-white dark:border-slate-800 rounded-full ${isOnline ? 'bg-green-500' : 'bg-gray-400'}`;
                    }
                });

                // Header label if chat is open
                if (currentPatientId) {
                    const isOnline = activeOnlineUsers.has(currentPatientId);
                    const statusLabel = document.getElementById('activePatientStatus');
                    if (statusLabel) {
                        statusLabel.innerText = isOnline ? 'ONLINE' : 'OFFLINE';
                        statusLabel.className = `text-[10px] font-bold uppercase tracking-wider ${isOnline ? 'text-green-500' : 'text-gray-400'}`;
                    }
                }
            }

            let currentPatientId = null;

            async function openChat(chatId, name, patientId) {
                activeChatId = chatId;
                currentPatientId = patientId;

                document.getElementById('activePatientName').innerText = name;

                // Update header status immediately
                const isOnline = activeOnlineUsers.has(patientId);
                const statusLabel = document.getElementById('activePatientStatus');
                if (statusLabel) {
                    statusLabel.innerText = isOnline ? 'ONLINE' : 'OFFLINE';
                    statusLabel.className = `text-[10px] font-bold uppercase tracking-wider ${isOnline ? 'text-green-500' : 'text-gray-400'}`;
                }

                document.getElementById('chatWindowHeader').classList.remove('hidden');
                document.getElementById('chatInputArea').classList.remove('hidden');

                // Highlight active item
                document.querySelectorAll('#chatListArea > div').forEach(el => el.classList.remove('border-blue-500', 'bg-white', 'dark:bg-slate-700'));
                const activeItem = document.getElementById(`chat-item-${chatId}`);
                if (activeItem) activeItem.classList.add('border-blue-500', 'bg-white', 'dark:bg-slate-700');

                const msgArea = document.getElementById('chatMessagesArea');
                msgArea.innerHTML = '<div class="text-center py-12 text-gray-400"><i class="fas fa-spinner fa-spin"></i> Loading context...</div>';

                try {
                    const res = await fetch(`/doctor/chats/${chatId}/messages`);
                    const data = await res.json();
                    if (data.success) {
                        msgArea.innerHTML = '';
                        data.messages.forEach(msg => {
                            const isMe = msg.sender_id === '<%= user.id %>'; // Doctor ID
                            // Wait, previous code used check msg.sender_id vs user.id. 
                            // Message sender_id for patient messages is 'patient_id'.
                            // Message sender_id for doctor messages is 'doctor_id'.
                            appendMessage(msg.message, isMe);
                        });
                        scrollToBottom();
                    }
                } catch (e) { msgArea.innerHTML = 'Error loading.'; }
            }

            function appendMessage(text, isMe) {
                const msgArea = document.getElementById('chatMessagesArea');
                const div = document.createElement('div');
                div.className = `flex ${isMe ? 'justify-end' : 'justify-start'} animate-fade-in mb-2`;
                div.innerHTML = `
                    <div class="max-w-[75%] p-3 rounded-2xl ${isMe ? 'bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-tr-sm' : 'bg-white dark:bg-slate-700 text-dark dark:text-white rounded-tl-sm shadow-sm'} text-sm shadow-sm">
                        ${text}
                    </div>
                `;
                msgArea.appendChild(div);
                scrollToBottom();
            }

            function scrollToBottom() {
                const msgArea = document.getElementById('chatMessagesArea');
                msgArea.scrollTop = msgArea.scrollHeight;
            }

            async function sendDoctorMessage() {
                const input = document.getElementById('doctorMsgInput');
                const text = input.value.trim();
                if (!text || !activeChatId) return;

                // Optimistic UI
                appendMessage(text, true);
                input.value = '';

                try {
                    await fetch('/doctor/chats/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ chatId: activeChatId, message: text })
                    });
                } catch (e) {
                    alert('Failed to send');
                }
            }

            function formatTime(isoString) {
                const date = new Date(isoString);
                return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            }

            // Auto-load chats when module active
            const chatModule = document.getElementById('module-chats');
            if (chatModule) {
                const obs = new MutationObserver(() => {
                    if (!chatModule.classList.contains('hidden')) {
                        loadActiveChats();
                    }
                });
                obs.observe(chatModule, { attributes: true, attributeFilter: ['class'] });
            }

            // ====================================
            // REAL-TIME DASHBOARD STATS (every 5s)
            // ====================================
            async function updateDashboardStats() {
                try {
                    const res = await fetch('/doctor/dashboard/stats');
                    const data = await res.json();

                    if (data.success) {
                        // Update counters with smooth transition
                        const updateCounter = (id, value) => {
                            const el = document.getElementById(id);
                            if (el) {
                                const currentValue = el.textContent.replace(/[^0-9.]/g, '');
                                if (currentValue !== String(value)) {
                                    el.style.transform = 'scale(1.2)';
                                    setTimeout(() => {
                                        el.textContent = id === 'counter-revenue' ? `$${value}` : value;
                                        el.style.transform = 'scale(1)';
                                    }, 150);
                                }
                            }
                        };

                        // Update all counters
                        updateCounter('counter-revenue', data.data.revenue);
                        updateCounter('counter-orders', data.data.shiftOrdersCount);
                        updateCounter('counter-prescriptions', data.data.shiftPrescriptionsCount);
                        updateCounter('counter-total-requests', data.data.totalRequests);

                        // Update Shift Module Live Stats (if module exists)
                        updateCounter('shift-live-revenue', data.data.revenue);
                        updateCounter('shift-live-orders', data.data.shiftOrdersCount);
                        updateCounter('shift-live-prescriptions', data.data.shiftPrescriptionsCount);
                        updateCounter('shift-live-returns', data.data.shiftReturnsCount);

                        // Update alerts
                        const updateAlert = (id, value) => {
                            const el = document.getElementById(id);
                            if (el) {
                                if (el.textContent !== String(value)) {
                                    el.classList.add('animate-pulse');
                                    el.textContent = value;
                                    setTimeout(() => el.classList.remove('animate-pulse'), 1000);
                                }
                            }
                        };

                        updateAlert('alert-low-stock-count', data.data.lowStockCount);
                        updateAlert('alert-scheduled-count', data.data.scheduledOrdersCount);
                    }
                } catch (err) {
                    console.error('Dashboard stats update failed:', err);
                }
            }

            // Initialize stats polling
            if (document.getElementById('module-overview')) {
                updateDashboardStats(); // Initial load
                setInterval(updateDashboardStats, 5000); // Update every 5 seconds
            }

            // ================================================
            // RETURNS MODULE LOGIC
            // ================================================

            let selectedReturnOrderId = null;
            let returnItemsCache = [];
            let selectedPendingReturn = null; // Store pending return data

            function openReturnModal() {
                document.getElementById('return-modal').classList.remove('hidden');
                resetReturnForm();
            }

            function closeReturnModal() {
                document.getElementById('return-modal').classList.add('hidden');
                resetReturnForm();
            }

            // --- Pending Requests Logic --- //
            async function loadPendingReturns() {
                const container = document.getElementById('pending-returns-container');
                if (!container) return;

                try {
                    const res = await fetch('/doctor/returns/pending');
