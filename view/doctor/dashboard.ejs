            // ================================================
            // PRESCRIPTION MODULE LOGIC
            // ================================================
            let currentPrescriptionId = null;
            let currentPrescriptionMedicines = []; // {id, name, price, quantity}

            async function openPrescriptionViewer(id) {
                currentPrescriptionId = id;
                currentPrescriptionMedicines = [];
                const modal = document.getElementById('prescription-viewer-modal');
                if (!modal) return;

                modal.classList.remove('hidden');

                // Reset UI
                document.getElementById('viewer-patient-name').textContent = 'Loading...';
                document.getElementById('viewer-image').src = '';
                document.getElementById('ai-results-section').classList.add('hidden');
                document.getElementById('ai-actions-section').classList.add('hidden'); // Reset actions
                renderSelectedMedicines();
                updatePrescriptionTotal();

                const approveBtn = document.getElementById('approve-prescription-btn');
                if (approveBtn) approveBtn.disabled = true;

                const checkbox = document.getElementById('manual-review-checkbox');
                if (checkbox) {
                    checkbox.checked = false;
                    checkbox.addEventListener('change', () => {
                        if (approveBtn) approveBtn.disabled = !checkbox.checked || currentPrescriptionMedicines.length === 0;
                    });
                }

                // Fetch details
                try {
                    const res = await fetch(`/doctor/prescriptions/${id}/details`);
                    const data = await res.json();

                    if (data.success) {
                        const p = data.prescription;
                        document.getElementById('viewer-patient-name').textContent = `${p.user_name} • ${new Date(p.created_at).toLocaleString()}`;
                        document.getElementById('viewer-image').src = p.image_url;

                        // AI Results
                        if (data.aiResult) {
                            const ai = data.aiResult;
                            document.getElementById('ai-results-section').classList.remove('hidden');
                            document.getElementById('ai-actions-section').classList.add('hidden'); // Hide analyze button if result exists
                            document.getElementById('ai-confidence').textContent = `${ai.confidence_score}% Confidence`;

                            // Parse suggested meds
                            let meds = [];
                            try {
                                // Handle both stringified JSON and array
                                meds = typeof ai.suggested_meds === 'string' ? JSON.parse(ai.suggested_meds) : ai.suggested_meds;
                            } catch (e) { meds = [] }

                            const aiContainer = document.getElementById('ai-suggested-medicines');
                            if (meds && meds.length > 0) {
                                aiContainer.innerHTML = meds.map(m => {
                                    const name = typeof m === 'object' ? m.name : m;
                                    return `
                                    <div class="flex justify-between items-center text-sm bg-white dark:bg-slate-800 p-2 rounded border border-blue-100 dark:border-blue-800">
                                         <span class="dark:text-gray-300 font-medium">${name}</span>
                                         <button onclick="searchAndAdd('${name.replace(/'/g, "\\'")}')" class="text-xs bg-blue-100 text-blue-600 px-2 py-1 rounded font-bold hover:bg-blue-200">
                                            <i class="fas fa-plus mr-1"></i> Add
                                         </button>
                                    </div>
                                 `}).join('');
                            } else {
                                aiContainer.innerHTML = '<p class="text-xs text-gray-500">No specific medicines identified.</p>';
                            }
                        } else {
                            // No AI result yet, show Analyze button
                            document.getElementById('ai-actions-section').classList.remove('hidden');
                        }
                    } else {
                        showToast('error', data.message || 'Failed to load');
                        closePrescriptionViewer();
                    }
                } catch (e) {
                    console.error(e);
                    showToast('error', 'Network error');
                    closePrescriptionViewer();
                }
            }

            async function analyzePrescription() {
                if (!currentPrescriptionId) return;

                const btn = document.querySelector('#ai-actions-section button');
                const originalHtml = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Analyzing...';

                try {
                    const res = await fetch('/doctor/prescriptions/analyze', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ prescriptionId: currentPrescriptionId })
                    });
                    const data = await res.json();

                    if (data.success && data.aiResult) {
                        // Check for specific AI error (unreadable)
                        if (data.aiResult.error) {
                            showToast('error', data.aiResult.error); // "Unreadable prescription..."
                            btn.disabled = false;
                            btn.innerHTML = originalHtml;
                            return;
                        }

                        showToast('success', 'Analysis Complete');
                        // Reload viewer with new data effectively
                        openPrescriptionViewer(currentPrescriptionId);
                    } else {
                        showToast('error', data.message || 'Analysis failed');
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                    }
                } catch (e) {
                    console.error(e);
                    showToast('error', 'Network error during analysis');
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            }

            function closePrescriptionViewer() {
                const modal = document.getElementById('prescription-viewer-modal');
                if (modal) modal.classList.add('hidden');
                currentPrescriptionId = null;
            }

            // Live Update Logic for Prescriptions
            async function loadPendingPrescriptions() {
                const container = document.getElementById('pending-prescriptions-container');
                if (!container) return; // helper to find container

                // We need a container for the cards. 
                // Currently the EJS loop renders them directly into the grid.
                // We should target the grid container. 
                // Let's assume the grid container has an ID or we add one.
                // Looking at previous view_file, the grid is likely the parent of the cards.

                try {
                    const res = await fetch('/doctor/prescriptions/pending');
                    const data = await res.json();

                    if (data.success) {
                        const grid = document.querySelector('#module-prescriptions .grid');
                        if (grid) {
                            if (data.prescriptions.length === 0) {
                                grid.innerHTML = `
                                <div class="col-span-full text-center py-12">
                                    <div class="bg-gray-50 dark:bg-slate-700/50 rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-4">
                                        <i class="fas fa-check text-3xl text-green-500"></i>
                                    </div>
                                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1">All Caught Up!</h3>
                                    <p class="text-gray-500 dark:text-gray-400">No pending prescriptions to review.</p>
                                </div>`;
                            } else {
                                grid.innerHTML = data.prescriptions.map(p => `
                                <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow border border-gray-100 dark:border-slate-700 relative overflow-hidden group">
                                    <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-100 transition-opacity">
                                        <i class="fas fa-file-medical text-6xl text-blue-500 transform rotate-12"></i>
                                    </div>
                                    <div class="relative z-10">
                                        <div class="flex justify-between items-start mb-4">
                                            <div class="bg-blue-50 dark:bg-blue-900/30 p-3 rounded-xl">
                                                <i class="fas fa-camera text-blue-600 dark:text-blue-400 text-xl"></i>
                                            </div>
                                            <span class="px-3 py-1 rounded-full text-xs font-bold bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400 animate-pulse">
                                                PENDING REVIEW
                                            </span>
                                        </div>
                                        <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-1">${p.user_name}</h3>
                                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
                                            <i class="far fa-clock mr-1"></i> ${new Date(p.created_at).toLocaleString()}
                                        </p>
                                        <div class="flex gap-2">
                                            <button onclick="openPrescriptionViewer('${p.id}')" 
                                                class="flex-1 bg-gray-900 dark:bg-white text-white dark:text-gray-900 py-2 rounded-xl font-bold hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors">
                                                Review
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                `).join('');
                            }
                        }
                    }
                } catch (e) {
                    console.error("Failed to load prescriptions", e);
                }
            }

            // Auto-load prescriptions when module active
            const presModule = document.getElementById('module-prescriptions');
            if (presModule) {
                const obs = new MutationObserver(() => {
                    if (!presModule.classList.contains('hidden')) {
                        loadPendingPrescriptions();
                    }
                });
                obs.observe(presModule, { attributes: true, attributeFilter: ['class'] });

                // Also poll every 30 seconds if visible
                setInterval(() => {
                    if (!presModule.classList.contains('hidden')) {
                        loadPendingPrescriptions();
                    }
                }, 30000);
            }

            // Search Modal Injection & Logic
            function searchMedicine() {
                if (!document.getElementById('med-search-modal')) {
                    const html = `
                        <div id="med-search-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[70] flex items-center justify-center hidden p-4 animate-fade-in">
                             <div class="bg-white dark:bg-slate-800 w-full max-w-lg rounded-2xl p-6 shadow-2xl border border-gray-100 dark:border-slate-700">
                                  <div class="flex justify-between items-center mb-4">
                                       <h3 class="font-bold text-lg dark:text-white">Search Medicine</h3>
                                       <button onclick="document.getElementById('med-search-modal').classList.add('hidden')" class="w-8 h-8 rounded-full bg-gray-100 dark:bg-slate-700 flex items-center justify-center hover:bg-gray-200"><i class="fas fa-times"></i></button>
                                  </div>
                                  <div class="relative mb-4">
                                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                                    <input type="text" id="med-search-input" class="w-full bg-gray-50 dark:bg-slate-900 border-none rounded-xl pl-10 pr-4 py-3 outline-none focus:ring-2 focus:ring-primary dark:text-white" placeholder="Type medicine name..." oninput="performMedSearch()">
                                  </div>
                                  <div id="med-search-results" class="max-h-60 overflow-y-auto space-y-2 pr-1 custom-scrollbar">
                                    <p class="text-center text-gray-400 text-sm py-8">Start typing to search...</p>
                                  </div>
                             </div>
                        </div>
                    `;
                    document.body.insertAdjacentHTML('beforeend', html);
                }
                document.getElementById('med-search-modal').classList.remove('hidden');
                const input = document.getElementById('med-search-input');
                input.value = '';
                input.focus();
                document.getElementById('med-search-results').innerHTML = '<p class="text-center text-gray-400 text-sm py-8">Start typing to search...</p>';
            }

            // Helper to search and auto-fill from AI suggestion
            function searchAndAdd(query) {
                searchMedicine();
                const input = document.getElementById('med-search-input');
                input.value = query;
                performMedSearch();
            }

            let searchDebounce;
            async function performMedSearch() {
                const query = document.getElementById('med-search-input').value.trim();
                const resultsContainer = document.getElementById('med-search-results');

                if (query.length < 2) return;

                clearTimeout(searchDebounce);
                searchDebounce = setTimeout(async () => {
                    resultsContainer.innerHTML = '<div class="text-center py-4"><i class="fas fa-spinner fa-spin text-gray-400"></i></div>';

                    try {
                        const res = await fetch(`/doctor/medicines/search?query=${encodeURIComponent(query)}`);
                        const data = await res.json();

                        if (data.success && data.medicines.length > 0) {
                            resultsContainer.innerHTML = data.medicines.map(m => `
                                <div onclick="addMedicineToRxList('${m.id}', '${m.name.replace(/'/g, "\\'")}', ${m.price})" 
                                    class="flex items-center justify-between p-3 bg-gray-50 dark:bg-slate-700/50 rounded-xl cursor-pointer hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:border-blue-200 border border-transparent transition-colors">
                                    <div class="flex items-center gap-3">
                                        ${m.image_url ? `<img src="${m.image_url}" class="w-10 h-10 rounded-lg object-cover">` : `<div class="w-10 h-10 rounded-lg bg-white dark:bg-slate-600 flex items-center justify-center"><i class="fas fa-pills text-gray-300"></i></div>`}
                                        <div>
                                            <p class="font-bold text-sm dark:text-white">${m.name}</p>
                                            <p class="text-xs text-gray-400">$${parseFloat(m.price).toFixed(2)}</p>
                                        </div>
                                    </div>
                                    <span class="text-xs font-bold text-blue-600 dark:text-blue-400 bg-blue-100 dark:bg-blue-900/30 px-2 py-1 rounded">Select</span>
                                </div>
                            `).join('');
                        } else {
                            resultsContainer.innerHTML = '<p class="text-center text-gray-400 text-sm py-4">No medicines found</p>';
                        }
                    } catch (e) {
                        resultsContainer.innerHTML = '<p class="text-center text-red-400 text-sm">Search failed</p>';
                    }
                }, 300);
            }

            function addMedicineToRxList(id, name, price) {
                // Check dupes
                if (currentPrescriptionMedicines.find(m => m.id == id)) {
                    showToast('info', 'Medicine already added');
                    return;
                }

                currentPrescriptionMedicines.push({ id, name, price, quantity: 1 });
                renderSelectedMedicines();
                updatePrescriptionTotal();
                document.getElementById('med-search-modal').classList.add('hidden');

                // Keep approve button sync
                const checkbox = document.getElementById('manual-review-checkbox');
                const btn = document.getElementById('approve-prescription-btn');
                if (btn && checkbox) btn.disabled = !checkbox.checked;
            }

            function removeRxMedicine(index) {
                currentPrescriptionMedicines.splice(index, 1);
                renderSelectedMedicines();
                updatePrescriptionTotal();

                // Keep approve button sync
                const checkbox = document.getElementById('manual-review-checkbox');
                const btn = document.getElementById('approve-prescription-btn');
                if (btn) btn.disabled = currentPrescriptionMedicines.length === 0 || (checkbox && !checkbox.checked);
            }

            function renderSelectedMedicines() {
                const container = document.getElementById('selected-medicines');
                if (currentPrescriptionMedicines.length === 0) {
                    container.innerHTML = '<p class="text-center text-gray-400 text-sm py-4">No medicines selected yet</p>';
                    return;
                }

                container.innerHTML = currentPrescriptionMedicines.map((m, idx) => `
                    <div class="flex items-center justify-between bg-gray-50 dark:bg-slate-700/50 p-2 rounded-lg">
                        <div class="flex-1">
                            <p class="font-bold text-sm dark:text-white">${m.name}</p>
                            <div class="flex items-center gap-2 mt-1">
                                <span class="text-xs text-gray-400">$${parseFloat(m.price).toFixed(2)}</span>
                                <input type="number" min="1" value="${m.quantity}" 
                                    onchange="updateRxQty(${idx}, this.value)"
                                    class="w-16 text-xs bg-white dark:bg-slate-800 border-none rounded px-2 py-1 outline-none">
                            </div>
                        </div>
                        <button onclick="removeRxMedicine(${idx})" class="text-red-500 hover:text-red-600 p-2"><i class="fas fa-trash"></i></button>
                    </div>
                `).join('');
            }

            function updateRxQty(idx, val) {
                if (val < 1) val = 1;
                currentPrescriptionMedicines[idx].quantity = parseInt(val);
                updatePrescriptionTotal();
            }

            function updatePrescriptionTotal() {
                const total = currentPrescriptionMedicines.reduce((sum, m) => sum + (m.price * m.quantity), 0);
                document.getElementById('prescription-total').textContent = `$${total.toFixed(2)}`;
            }

            async function rejectPrescription() {
                if (!confirm('Are you sure you want to reject this prescription? This action cannot be undone.')) return;

                if (!currentPrescriptionId) return;

                const btn = document.querySelector('button[onclick="rejectPrescription()"]');
                const originalHtml = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Rejecting...';

                try {
                    const res = await fetch('/doctor/prescriptions/decision', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            prescriptionId: currentPrescriptionId,
                            action: 'reject'
                        })
                    });
                    const data = await res.json();

                    if (data.success) {
                        showToast('success', 'Prescription Rejected');
                        closePrescriptionViewer();
                        window.location.reload();
                    } else {
                        showToast('error', data.message || 'Failed to reject');
                    }
                } catch (e) {
                    showToast('error', 'Network error');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            }

            // Approve Action with Event Listener binding?
            // The button id is approve-prescription-btn
            document.addEventListener('DOMContentLoaded', () => {
                const btn = document.getElementById('approve-prescription-btn');
                if (btn) {
                    btn.addEventListener('click', async () => {
                        if (!currentPrescriptionId) return;
                        if (currentPrescriptionMedicines.length === 0) return showToast('error', 'Select at least one medicine');
                        if (!document.getElementById('manual-review-checkbox').checked) return showToast('error', 'Please confirm manual review');

                        btn.disabled = true;
                        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

                        try {
                            const res = await fetch('/doctor/prescriptions/decision', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    prescriptionId: currentPrescriptionId,
                                    action: 'approve',
                                    medicines: currentPrescriptionMedicines,
                                    notes: 'Approved via Doctor Dashboard'
                                })
                            });
                            const data = await res.json();

                            if (data.success) {
                                showToast('success', 'Prescription Approved & Order Created');
                                closePrescriptionViewer();
                                window.location.reload(); // To update lists
                            } else {
                                showToast('error', data.message || 'Failed');
                                btn.disabled = false;
                                btn.innerHTML = '<i class="fas fa-check-circle"></i> Create Invoice & Approve';
                            }
                        } catch (e) {
                            showToast('error', 'Network error');
                            btn.disabled = false;
                            btn.innerHTML = '<i class="fas fa-check-circle"></i> Create Invoice & Approve';
                        }
                    });
                }
            });


            // ================================================
            // PRODUCT REQUESTS MODULE
            // ================================================
            async function loadProductRequests() {
                try {
                    const res = await fetch('/doctor/requests');
                    const data = await res.json();

                    if (data.success) {
                        renderPendingRequests(data.pending);
                        renderRequestHistory(data.history);

                        // Update badge
                        const badge = document.getElementById('badge-requests');
                        if (badge) {
                            if (data.pending.length > 0) {
                                badge.textContent = data.pending.length;
                                badge.classList.remove('hidden');
                            } else {
                                badge.classList.add('hidden');
                            }
                        }
                    }
                } catch (err) {
                    console.error("Failed to load requests:", err);
                }
            }

            function renderPendingRequests(requests) {
                const container = document.getElementById('requests-pending-view');
                if (!container) return;

                if (requests.length === 0) {
                    container.innerHTML = `
                        <div class="col-span-full py-12 flex flex-col items-center justify-center text-gray-400">
                            <i class="fas fa-check-circle text-4xl mb-4 text-green-100 dark:text-green-900"></i>
                            <p>No pending requests. Good job!</p>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = requests.map(req => `
                    <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-slate-700 hover:shadow-md transition-all relative group">
                        <div class="absolute top-4 right-4 text-xs font-bold text-amber-500 bg-amber-50 dark:bg-amber-900/20 px-2 py-1 rounded-lg">
                            Pending
                        </div>
                        
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-10 h-10 rounded-full bg-gray-100 dark:bg-slate-700 flex items-center justify-center overflow-hidden">
                                <img src="${req.avatar || '/images/default-avatar.png'}" class="w-full h-full object-cover">
                            </div>
                            <div>
                                <p class="text-sm font-bold dark:text-white capitalize">${req.full_name}</p>
                                <p class="text-xs text-gray-500">${new Date(req.created_at).toLocaleDateString()}</p>
                            </div>
                        </div>

                        <h3 class="text-lg font-black text-gray-800 dark:text-white mb-2">${req.product_name}</h3>
                        <p class="text-sm text-gray-500 mb-6 bg-gray-50 dark:bg-slate-900/50 p-3 rounded-xl italic">
                            "${req.description || 'No description provided'}"
                        </p>

                        <button onclick="fulfillRequest('${req.id}', '${req.product_name.replace(/'/g, "\\'")}', '${(req.description || '').replace(/'/g, "\\'").replace(/\n/g, " ")}')" 
                            class="w-full bg-primary text-white py-3 rounded-xl font-bold text-sm hover:translate-y-[-2px] hover:shadow-lg hover:shadow-primary/30 transition-all flex items-center justify-center gap-2">
                            <i class="fas fa-plus-circle"></i>
                            Add to Site (Fulfill)
                        </button>
                    </div>
                `).join('');
            }

            function renderRequestHistory(requests) {
                const tbody = document.getElementById('requests-history-table');
                if (!tbody) return;

                tbody.innerHTML = requests.map(req => `
                    <tr class="border-b border-gray-50 dark:border-slate-700/50 hover:bg-gray-50 dark:hover:bg-slate-700/20 transition-colors">
                        <td class="px-4 py-3 font-medium dark:text-white">${req.product_name}</td>
                        <td class="px-4 py-3 text-gray-500 capitalize">${req.full_name}</td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-1 rounded-md text-xs font-bold ${req.status === 'fulfilled' ? 'bg-green-100 text-green-600' : 'bg-gray-100 text-gray-500'
                    }">${req.status}</span>
                        </td>
                        <td class="px-4 py-3 text-gray-500">${new Date(req.created_at).toLocaleDateString()}</td>
                    </tr>
                `).join('');
            }

            function switchRequestTab(tab) {
                const pendingView = document.getElementById('requests-pending-view');
                const historyView = document.getElementById('requests-history-view');
                const tabPending = document.getElementById('tab-req-pending');
                const tabHistory = document.getElementById('tab-req-history');

                if (tab === 'pending') {
                    pendingView.classList.remove('hidden');
                    historyView.classList.add('hidden');
                    tabPending.className = "px-4 py-2 rounded-lg text-sm font-bold bg-white dark:bg-slate-700 shadow-sm transition-all text-primary";
                    tabHistory.className = "px-4 py-2 rounded-lg text-sm font-bold text-gray-500 hover:text-gray-700 dark:text-gray-400 transition-all";
                } else {
                    pendingView.classList.add('hidden');
                    historyView.classList.remove('hidden');
                    tabHistory.className = "px-4 py-2 rounded-lg text-sm font-bold bg-white dark:bg-slate-700 shadow-sm transition-all text-primary";
                    tabPending.className = "px-4 py-2 rounded-lg text-sm font-bold text-gray-500 hover:text-gray-700 dark:text-gray-400 transition-all";
                }
            }

            // Fulfill Logic
            let activeRequestId = null;

            function fulfillRequest(reqId, productName, description) {
                console.log('Fulfilling request:', reqId);
                activeRequestId = reqId;

                // Ensure modal opens
                try {
                    openInventoryModal();
                    console.log('Modal opened');
                } catch (e) {
                    console.error('Failed to open modal:', e);
                    showToast('error', 'Error opening validation form');
                    return;
                }

                // Pre-fill fields
                const nameInput = document.getElementById('product-name');
                const descInput = document.getElementById('product-description');

                if (nameInput) nameInput.value = productName;
                if (descInput) descInput.value = description;

                // Scroll to top of the scrollable container, not the wrapper
                const scrollContainer = document.querySelector('#inventory-modal > div.overflow-y-auto');
                if (scrollContainer) scrollContainer.scrollTo(0, 0);

                showToast('info', 'Fill details to add product and notify user.');
            }

            async function saveProduct(e) {
                e.preventDefault();
                const btn = e.target.querySelector('button[type="submit"]');
                const originalText = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

                // Use optional chaining for safety
                const getVal = (id) => document.getElementById(id)?.value || '';
                const getCheck = (id) => document.getElementById(id)?.checked || false;

                const formData = {
                    name: getVal('product-name'),
                    category: getVal('product-category'),
                    price: getVal('product-price'),
                    quantity: getVal('product-quantity'),
                    lowStockThreshold: getVal('product-low-stock'),
                    description: getVal('product-description'),
                    imageUrl: getVal('product-image'),
                    benefits: getVal('product-benefits'),
                    sideEffects: getVal('product-side-effects'),
                    aiReviewed: getCheck('ai-reviewed')
                };

                // Add id if editing
                const pid = getVal('product-id');
                if (pid) formData.id = pid;

                try {
                    const url = pid ? `/doctor/inventory/update/${pid}` : '/doctor/inventory/create';
                    const method = pid ? 'PUT' : 'POST';

                    const res = await fetch(url, {
                        method: method,
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(formData)
                    });
                    const data = await res.json();

                    if (data.success) {
                        showToast('success', pid ? 'Product updated' : 'Product added successfully');
                        closeInventoryModal();

                        // Fulfill request if active and this is a NEW product
                        if (activeRequestId && !pid) {
                            await fulfillProductRequestAfterSave(activeRequestId, data.product.id);
                        }

                        // Reload inventory/requests if functions exist
                        if (typeof loadInventory === 'function') loadInventory();
                        if (typeof loadProductRequests === 'function') loadProductRequests();

                    } else {
                        showToast('error', data.message || 'Failed to save');
                    }
                } catch (err) {
                    console.error('Save error:', err);
                    showToast('error', 'Network error occurred');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            }

            async function fulfillProductRequestAfterSave(reqId, productId) {
                try {
                    const res = await fetch('/doctor/requests/fulfill', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ requestId: reqId, matchedMedicineId: productId })
                    });
                    const d = await res.json();
                    if (d.success) {
                        showToast('success', 'Request fulfilled & User notified!');
                        activeRequestId = null;
                        loadProductRequests(); // Refresh request list to show status change
                    }
                } catch (e) {
                    console.error("Fulfillment error", e);
                }
            }

            async function aiAssistFill() {
                const nameInput = document.getElementById('product-name');
                const name = nameInput.value.trim();

                if (!name) {
                    showToast('warning', 'Please enter a product name first');
                    nameInput.focus();
                    return;
                }

                // Find button regardless of where it is (banner or inline)
                const btn = document.querySelector('button[onclick="aiAssistFill()"]');
                const originalText = btn ? btn.innerHTML : 'AI Assist';
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Analyzing...';
                }

                try {
                    const res = await fetch('/doctor/product/ai-assist', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productName: name })
                    });
                    const data = await res.json();

                    if (data.data) {
                        const p = data.data;
                        const setVal = (id, val) => {
                            const el = document.getElementById(id);
                            if (el && val) el.value = val;
                        }

                        if (p.description) setVal('product-description', p.description);
                        if (p.category) setVal('product-category', p.category);
                        if (p.price) setVal('product-price', p.price);

                        // Handle benefits/side effects 
                        const formatList = (list) => {
                            if (!list) return '';
                            return Array.isArray(list) ? '- ' + list.join('\n- ') : list;
                        };

                        if (p.benefits) setVal('product-benefits', formatList(p.benefits));
                        if (p.side_effects) setVal('product-side-effects', formatList(p.side_effects));

                    } else {
                        showToast('info', 'AI could not find details for this product.');
                    }
                } catch (err) {
                    console.error("AI Assist Error:", err);
                    showToast('error', 'AI service unavailable');
                } finally {
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = originalText;
                    }
                }
            }

            function closeInventoryModal() {
                const modal = document.getElementById('inventory-modal');
                if (modal) {
                    modal.classList.add('hidden');
                    modal.style.display = ''; // Clear inline display if used
                }
                document.getElementById('inventory-form')?.reset();
            }
        </script>

        <!-- CHAT ORDER MODAL -->
        <div id="chat-order-modal"
            class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[70] flex items-center justify-center hidden p-4 animate-fade-in">
            <div
                class="bg-white dark:bg-slate-800 w-full max-w-2xl rounded-2xl flex flex-col shadow-2xl border border-gray-100 dark:border-slate-700 max-h-[90vh]">
                <div class="p-6 border-b border-gray-100 dark:border-slate-700 flex justify-between items-center">
                    <div>
                        <h3 class="font-bold text-lg dark:text-white">Create Order for Customer</h3>
                        <p class="text-xs text-gray-500" id="chat-order-customer-name">Customer: ...</p>
                    </div>
                    <button onclick="closeChatOrderModal()"
                        class="w-10 h-10 rounded-full bg-gray-100 dark:bg-slate-700 flex items-center justify-center hover:bg-gray-200 transition-colors">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <div class="p-6 overflow-y-auto flex-1 space-y-6 custom-scrollbar">
                    <!-- Search -->
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Search Medicines</label>
                        <div class="relative">
                            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                            <input type="text" id="chat-med-search"
                                class="w-full bg-gray-50 dark:bg-slate-900 border-none rounded-xl pl-10 pr-4 py-3 outline-none focus:ring-2 focus:ring-primary dark:text-white shadow-sm"
                                placeholder="Type name to search..." oninput="performChatMedSearch()">
                            <div id="chat-med-results"
                                class="absolute left-0 right-0 top-full mt-2 bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl shadow-xl z-10 hidden max-h-60 overflow-y-auto p-2 custom-scrollbar">
                                <!-- Results go here -->
                            </div>
                        </div>
                    </div>

                    <!-- Selected Items -->
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Selected Items</label>
                        <div id="chat-order-items" class="space-y-2">
                            <p
                                class="text-center text-gray-400 text-sm py-4 bg-gray-50 dark:bg-slate-900/50 rounded-xl border-2 border-dashed border-gray-100 dark:border-slate-700">
                                No items added yet</p>
                        </div>
                    </div>

                    <!-- Summary -->
                    <div class="bg-gray-50 dark:bg-slate-900/50 p-4 rounded-xl space-y-2">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500 font-medium">Subtotal</span>
                            <span class="font-bold dark:text-white" id="chat-order-subtotal">$0.00</span>
                        </div>
                        <div
                            class="flex justify-between text-lg border-t border-gray-200 dark:border-slate-700 pt-2 mt-2">
                            <span class="font-black dark:text-white">Total</span>
                            <span class="font-black text-primary" id="chat-order-total">$0.00</span>
                        </div>
                    </div>
                </div>

                <div
                    class="p-6 border-t border-gray-100 dark:border-slate-700 flex justify-end gap-3 bg-gray-50 dark:bg-slate-900/30 rounded-b-2xl">
                    <button onclick="closeChatOrderModal()"
                        class="px-6 py-2 font-bold text-gray-500 hover:bg-gray-100 dark:hover:bg-slate-700 rounded-xl transition-colors">Cancel</button>
                    <button onclick="submitChatOrder()" id="submit-chat-order-btn" disabled
                        class="px-8 py-2 bg-primary text-white font-bold rounded-xl shadow-lg shadow-blue-500/30 hover:translate-y-[-2px] hover:shadow-xl transition-all disabled:opacity-50 disabled:translate-y-0 disabled:shadow-none">
                        Create Order
                    </button>
                </div>
            </div>
        </div>

        <script>
            // ================================================
            // CHAT ORDER LOGIC
            // ================================================
            let chatOrderItems = [];

            function openChatOrderModal() {
                if (!currentPatientId) return showToast('error', 'No active patient selected');

                document.getElementById('chat-order-customer-name').textContent = `Customer: ${document.getElementById('activePatientName').innerText}`;
                document.getElementById('chat-order-modal').classList.remove('hidden');
                chatOrderItems = [];
                renderChatOrderItems();
            }

            function closeChatOrderModal() {
                document.getElementById('chat-order-modal').classList.add('hidden');
            }

            let chatSearchDebounce;
            function performChatMedSearch() {
                const query = document.getElementById('chat-med-search').value.trim();
                const resultsCont = document.getElementById('chat-med-results');

                if (query.length < 2) {
                    resultsCont.classList.add('hidden');
                    return;
                }

                clearTimeout(chatSearchDebounce);
                chatSearchDebounce = setTimeout(async () => {
                    try {
                        const res = await fetch(`/doctor/medicines/search?query=${encodeURIComponent(query)}`);
                        const data = await res.json();

                        if (data.success && data.medicines.length > 0) {
                            resultsCont.innerHTML = data.medicines.map(m => {
                                const isOutOfStock = m.current_stock <= 0;
                                return `
                                <div onclick="${isOutOfStock ? '' : `addItemToChatOrder('${m.id}', '${m.name.replace(/'/g, "\\'")}', ${m.price}, ${m.current_stock})`}" 
                                    class="p-3 hover:bg-blue-50 dark:hover:bg-blue-900/30 cursor-pointer rounded-lg flex items-center justify-between border-b border-gray-50 dark:border-slate-700 last:border-0 transition-colors ${isOutOfStock ? 'opacity-50 grayscale cursor-not-allowed' : ''}">
                                    <div>
                                        <p class="font-bold text-sm dark:text-white">${m.name}</p>
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs text-gray-400">$${parseFloat(m.price).toFixed(2)}</span>
                                            <span class="text-[10px] font-bold ${m.current_stock < 5 ? 'text-red-500' : 'text-green-500'}">
                                                Stock: ${m.current_stock}
                                            </span>
                                        </div>
                                    </div>
                                    ${isOutOfStock ?
                                        '<span class="text-[10px] font-bold text-red-500 bg-red-100 px-2 py-1 rounded">OUT</span>' :
                                        '<i class="fas fa-plus-circle text-primary"></i>'
                                    }
                                </div>
                            `}).join('');
                            resultsCont.classList.remove('hidden');
                        } else {
                            resultsCont.innerHTML = '<p class="p-4 text-center text-gray-400 text-sm">No medicines found</p>';
                            resultsCont.classList.remove('hidden');
                        }
                    } catch (e) {
                        console.error('Search failed', e);
                    }
                }, 300);
            }

            function addItemToChatOrder(id, name, price, stock) {
                const existing = chatOrderItems.find(item => item.id === id);
                if (existing) {
                    if (existing.quantity >= stock) {
                        return showToast('error', `Only ${stock} units available in stock`);
                    }
                    existing.quantity++;
                } else {
                    chatOrderItems.push({ id, name, price, quantity: 1, stock });
                }

                document.getElementById('chat-med-search').value = '';
                document.getElementById('chat-med-results').classList.add('hidden');
                renderChatOrderItems();
            }

            function updateChatItemQty(id, delta) {
                const item = chatOrderItems.find(i => i.id === id);
                if (item) {
                    if (delta > 0 && item.quantity >= item.stock) {
                        return showToast('error', `Only ${item.stock} units available in stock`);
                    }
                    item.quantity += delta;
                    if (item.quantity <= 0) {
                        chatOrderItems = chatOrderItems.filter(i => i.id !== id);
                    }
                    renderChatOrderItems();
                }
            }

            function renderChatOrderItems() {
                const cont = document.getElementById('chat-order-items');
                if (chatOrderItems.length === 0) {
                    cont.innerHTML = '<p class="text-center text-gray-400 text-sm py-4 bg-gray-50 dark:bg-slate-900/50 rounded-xl border-2 border-dashed border-gray-100 dark:border-slate-700">No items added yet</p>';
                    document.getElementById('chat-order-subtotal').textContent = '$0.00';
                    document.getElementById('chat-order-total').textContent = '$0.00';
                    document.getElementById('submit-chat-order-btn').disabled = true;
                    return;
                }

                cont.innerHTML = chatOrderItems.map(item => `
                    <div class="flex items-center justify-between bg-white dark:bg-slate-900 p-3 rounded-xl border border-gray-100 dark:border-slate-700">
                        <div class="flex-1">
                            <p class="font-bold text-sm dark:text-white">${item.name}</p>
                            <p class="text-xs text-gray-400">$${parseFloat(item.price).toFixed(2)} each</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="flex items-center bg-gray-50 dark:bg-slate-800 rounded-lg px-2 py-1">
                                <button onclick="updateChatItemQty('${item.id}', -1)" class="w-6 h-6 flex items-center justify-center text-gray-400 hover:text-red-500 font-bold">-</button>
                                <span class="text-sm font-bold w-6 text-center dark:text-white">${item.quantity}</span>
                                <button onclick="updateChatItemQty('${item.id}', 1)" class="w-6 h-6 flex items-center justify-center text-gray-400 hover:text-green-500 font-bold">+</button>
                            </div>
                            <span class="font-bold text-sm min-w-[60px] text-right">$${(item.price * item.quantity).toFixed(2)}</span>
                        </div>
                    </div>
                `).join('');

                const total = chatOrderItems.reduce((sum, i) => sum + (i.price * i.quantity), 0);
                document.getElementById('chat-order-subtotal').textContent = `$${total.toFixed(2)}`;
                document.getElementById('chat-order-total').textContent = `$${total.toFixed(2)}`;
                document.getElementById('submit-chat-order-btn').disabled = false;
            }

            async function submitChatOrder() {
                if (chatOrderItems.length === 0 || !currentPatientId) return;

                const btn = document.getElementById('submit-chat-order-btn');
                const originalText = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Creating...';

                try {
                    const res = await fetch('/doctor/orders/create-manual', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            userId: currentPatientId,
                            medicines: chatOrderItems.map(i => ({ id: i.id, quantity: i.quantity, price: i.price })),
                            notes: `Created via Chat with Dr. <%= user.full_name %>`
                        })
                    });

                    const data = await res.json();
                    if (data.success) {
                        showToast('success', 'Order created successfully');
                        closeChatOrderModal();

                        // Inform patient in chat
                        const input = document.getElementById('doctorMsgInput');
                        if (input) {
                            input.value = `I have created an order for you (#${data.order_uid}). You can check it in your orders page.`;
                            sendDoctorMessage();
                        }

                        if (typeof loadOrders === 'function') loadOrders();
                    } else {
                        showToast('error', data.message || 'Failed to create order');
                    }
                } catch (e) {
                    showToast('error', 'Network error');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            }
        </script>
        <script src="/doctor/dashboard_stats_script.js"></script>
    </body>

</html>