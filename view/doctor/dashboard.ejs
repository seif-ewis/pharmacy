            async function submitRequestAction(action) {
                if (!selectedPendingReturn) return;

                const itemConditions = {};
                selectedPendingReturn.items.forEach(item => {
                    const val = document.getElementById(`condition-${item.id}`).value;
                    itemConditions[item.id] = val;
                });

                const notes = document.getElementById('admin-notes').value;
                const modal = document.getElementById('process-request-modal');

                // Visual loading state
                const btns = modal.querySelectorAll('button');
                btns.forEach(b => b.disabled = true);

                try {
                    const res = await fetch('/doctor/returns/action', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            return_id: selectedPendingReturn.id,
                            action: action,
                            admin_notes: notes,
                            item_conditions: itemConditions
                        })
                    });

                    // We expect a redirect from backend usually, but since it's fetch:
                    if (res.redirected) {
                        window.location.href = res.url;
                        return;
                    }

                    // Or if JSON response
                    const data = await res.json().catch(() => ({}));

                    modal.remove();
                    showToast('success', `Request ${action}ed`);
                    loadPendingReturns();
                    loadRecentReturns();

                } catch (e) {
                    // If response was actually a redirect (HTML), fetch might have 'failed' JSON parse
                    // Just reload to be safe or inspect
                    window.location.reload();
                }
            }

            // --- End Pending Logic --- //

            function resetReturnForm() {
                selectedReturnOrderId = null;
                returnItemsCache = [];
                document.getElementById('return-step-1').classList.remove('hidden');
                document.getElementById('return-step-2').classList.add('hidden');
                document.getElementById('return-actions').classList.add('hidden');
                document.getElementById('return-order-search').value = '';
                document.getElementById('return-order-results').innerHTML = '';
                document.getElementById('return-items-list').innerHTML = '';
                document.getElementById('return-total-refund').textContent = '$0.00';
                document.getElementById('return-notes').value = '';
            }

            async function searchReturnOrder() {
                const query = document.getElementById('return-order-search').value.trim();
                if (query.length < 3) return showToast('error', 'Enter at least 3 characters');

                const resultsContainer = document.getElementById('return-order-results');
                resultsContainer.innerHTML = '<div class="text-center py-4"><i class="fas fa-spinner fa-spin"></i> Finding orders...</div>';

                try {
                    const res = await fetch(`/doctor/returns/search-order?query=${encodeURIComponent(query)}`);
                    const data = await res.json();

                    if (data.success && data.orders.length > 0) {
                        resultsContainer.innerHTML = data.orders.map(o => `
                            <div onclick="selectReturnOrder('${o.id}', '${o.user_name}', '${o.order_uid}')" 
                                class="bg-white dark:bg-slate-900 border border-gray-100 dark:border-slate-700 p-3 rounded-xl cursor-pointer hover:border-blue-500 transition-colors flex items-center justify-between">
                                <div>
                                    <p class="font-bold dark:text-white">${o.user_name}</p>
                                    <p class="text-xs text-gray-400">#${o.order_uid}</p>
                                </div>
                                <div class="text-right">
                                    <p class="font-bold text-green-600">$${parseFloat(o.total_price).toFixed(2)}</p>
                                    <p class="text-xs text-gray-400">${new Date(o.created_at).toLocaleDateString()}</p>
                                </div>
                            </div>
                        `).join('');
                    } else {
                        resultsContainer.innerHTML = '<p class="text-center text-gray-400 text-sm py-4">No matching completed orders found.</p>';
                    }
                } catch (e) {
                    console.error(e);
                    resultsContainer.innerHTML = '<p class="text-center text-red-500 text-sm">Search failed.</p>';
                }
            }

            async function selectReturnOrder(orderId, customerName, uid) {
                selectedReturnOrderId = orderId;
                document.getElementById('selected-order-id').textContent = `Order #${uid}`;
                document.getElementById('selected-order-customer').textContent = `Customer: ${customerName}`;

                document.getElementById('return-step-1').classList.add('hidden');
                document.getElementById('return-step-2').classList.remove('hidden');
                document.getElementById('return-actions').classList.remove('hidden');

                // Load items
                const list = document.getElementById('return-items-list');
                list.innerHTML = '<div class="text-center py-6"><i class="fas fa-spinner fa-spin"></i> Loading order items...</div>';

                try {
                    const res = await fetch(`/doctor/returns/order-items/${orderId}`);
                    const data = await res.json();

                    if (data.success) {
                        returnItemsCache = data.items;
                        renderReturnItems();
                    }
                } catch (e) {
                    list.innerHTML = '<p class="text-center text-red-400">Failed to load items</p>';
                }
            }

            function renderReturnItems() {
                const list = document.getElementById('return-items-list');
                list.innerHTML = returnItemsCache.map(item => `
                    <div class="flex items-center justify-between bg-white dark:bg-slate-900 p-3 rounded-xl border border-gray-100 dark:border-slate-700 transition-colors hover:border-blue-200">
                        <div class="flex items-center gap-3">
                            <input type="checkbox" onchange="toggleReturnItem('${item.id}')" class="w-5 h-5 rounded text-blue-600 focus:ring-blue-500" value="${item.id}">
                            <div>
                                <p class="font-bold text-sm dark:text-white">${item.medicine_name}</p>
                                <p class="text-xs text-gray-400">$${parseFloat(item.price).toFixed(2)} / unit</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                             <div class="flex items-center bg-gray-100 dark:bg-slate-800 rounded-lg px-2">
                                <button onclick="adjustReturnQty('${item.id}', -1)" class="text-gray-500 hover:text-red-500 p-1 font-bold">-</button>
                                <span id="qty-display-${item.id}" class="text-sm font-bold w-6 text-center dark:text-white select-none">${item.quantity}</span>
                                <input type="hidden" id="qty-${item.id}" value="${item.quantity}" max="${item.quantity}">
                                <button onclick="adjustReturnQty('${item.id}', 1)" class="text-gray-500 hover:text-green-500 p-1 font-bold">+</button>
                            </div>
                        </div>
                    </div>
                `).join('');
                calculateReturnTotal();
            }

            function adjustReturnQty(itemId, delta) {
                const input = document.getElementById(`qty-${itemId}`);
                const display = document.getElementById(`qty-display-${itemId}`);
                if (!input) return;

                let current = parseInt(input.value);
                let max = parseInt(input.getAttribute('max'));
                let newVal = current + delta;

                if (newVal >= 1 && newVal <= max) {
                    input.value = newVal;
                    display.innerText = newVal;
                    calculateReturnTotal();
                }
            }

            function toggleReturnItem(itemId) {
                calculateReturnTotal();
            }

            function calculateReturnTotal() {
                let total = 0;
                const checkboxes = document.querySelectorAll('#return-items-list input[type="checkbox"]:checked');

                checkboxes.forEach(cb => {
                    const itemId = cb.value;
                    const item = returnItemsCache.find(i => i.id === itemId);
                    const qty = parseInt(document.getElementById(`qty-${itemId}`).value);
                    if (item) {
                        total += parseFloat(item.price) * qty;
                    }
                });

                document.getElementById('return-total-refund').textContent = `$${total.toFixed(2)}`;
            }

            async function submitReturn() {
                if (!selectedReturnOrderId) return;

                const checkboxes = document.querySelectorAll('#return-items-list input[type="checkbox"]:checked');
                if (checkboxes.length === 0) return showToast('error', 'Select at least one item');

                if (!confirm("Confirm Return? \nThis will deduct revenue and update stock (if selected).")) return;

                const selectedItems = [];
                checkboxes.forEach(cb => {
                    const itemId = cb.value;
                    const item = returnItemsCache.find(i => i.id === itemId);
                    const qty = parseInt(document.getElementById(`qty-${itemId}`).value);
                    selectedItems.push({
                        medicine_id: item.medicine_id,
                        quantity: qty,
                        price: item.price
                    });
                });

                const payload = {
                    orderId: selectedReturnOrderId,
                    items: selectedItems,
                    reason: document.getElementById('return-reason').value,
                    condition: document.getElementById('return-condition').value,
                    updateInventory: document.getElementById('return-inventory-update').checked,
                    notes: document.getElementById('return-notes').value
                };

                try {
                    const res = await fetch('/doctor/returns/process', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();

                    if (data.success) {
                        showToast('success', 'Return Processed Successfully');
                        closeReturnModal();
                        loadRecentReturns();
                        loadOrders(true); // Refresh orders list to show new return labels
                    } else {
                        showToast('error', data.error || 'Processing Failed');
                    }
                } catch (e) {
                    showToast('error', 'Network Error');
                }
            }

            async function loadRecentReturns() {
                const tbody = document.getElementById('returns-table-body');
                if (!tbody) return;

                try {
                    const res = await fetch('/doctor/returns/recent');
                    const data = await res.json();

                    if (data.success && data.returns.length > 0) {
                        tbody.innerHTML = data.returns.map(r => `
                            <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors">
                                <td class="px-6 py-4 font-mono text-xs dark:text-gray-300">...${r.id.substr(-8)}</td>
                                <td class="px-6 py-4 font-bold text-sm dark:text-white">#${r.order_uid}</td>
                                <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400 capitalize">${(r.reason || '').replace('_', ' ')}</td>
                                <td class="px-6 py-4 text-center">
                                    <span class="px-2 py-1 rounded text-xs font-bold bg-green-100 text-green-600 dark:bg-green-900/30 dark:text-green-400 uppercase">
                                        ${r.status}
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right font-bold text-red-500">-$${parseFloat(r.refund_amount).toFixed(2)}</td>
                            </tr>
                        `).join('');
                    } else {
                        tbody.innerHTML = `<tr><td colspan="5" class="text-center py-8 text-gray-400">No returns in this shift yet.</td></tr>`;
                    }
                } catch (e) {
                    console.error(e);
                }
            }

            // Auto-load returns when module active
            const returnsModule = document.getElementById('module-returns');
            if (returnsModule) {
                const obs = new MutationObserver(() => {
                    if (!returnsModule.classList.contains('hidden')) {
                        loadRecentReturns();
                        loadPendingReturns(); // Load requests too
                    }
                });
                obs.observe(returnsModule, { attributes: true, attributeFilter: ['class'] });
            }

            // ================================================
            // INVENTORY MODULE - Full CRUD
            // ================================================

            let inventoryCache = [];
            let editingProductId = null;

            async function loadInventory() {
                const tbody = document.getElementById('inventory-table-body');
                if (!tbody) return;

                tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-gray-400"><i class="fas fa-spinner fa-spin text-4xl mb-3"></i><p>Loading inventory...</p></td></tr>';

                try {
                    const res = await fetch('/doctor/inventory');
                    const data = await res.json();

                    if (data.success && data.inventory.length > 0) {
                        inventoryCache = data.inventory;
                        filterInventory(); // Apply any active filters
                    } else {
                        tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-gray-400"><i class="fas fa-box-open text-4xl mb-3"></i><p>No products in inventory</p></td></tr>';
                    }
                } catch (e) {
                    console.error('Load inventory error:', e);
                    tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-red-400"><i class="fas fa-exclamation-circle text-4xl mb-3"></i><p>Failed to load inventory</p></td></tr>';
                }
            }

            function filterInventory(sortBy = null) {
                const searchTerm = document.getElementById('inventory-search')?.value.toLowerCase() || '';
                const categoryFilter = document.getElementById('category-filter')?.value || '';
                const stockFilter = document.getElementById('stock-filter')?.value || '';
                const tbody = document.getElementById('inventory-table-body');

                if (!tbody) return;

                let filtered = inventoryCache.filter(item => {
                    const matchesSearch = item.name.toLowerCase().includes(searchTerm) ||
                        (item.category && item.category.toLowerCase().includes(searchTerm));
                    const matchesCategory = !categoryFilter || item.category === categoryFilter;

                    // Stock filter
                    let matchesStock = true;
                    if (stockFilter === 'low') {
                        matchesStock = item.current_stock <= (item.low_stock_threshold || 10);
                    } else if (stockFilter === 'out') {
                        matchesStock = item.current_stock <= 0;
                    } else if (stockFilter === 'available') {
                        matchesStock = item.current_stock > 0;
                    }

                    return matchesSearch && matchesCategory && matchesStock;
                });

                // Sort options
                if (sortBy === 'stock-asc') {
                    filtered.sort((a, b) => a.current_stock - b.current_stock);
                } else if (sortBy === 'stock-desc') {
                    filtered.sort((a, b) => b.current_stock - a.current_stock);
                } else if (sortBy === 'name') {
                    filtered.sort((a, b) => a.name.localeCompare(b.name));
                } else if (sortBy === 'price') {
                    filtered.sort((a, b) => parseFloat(b.price) - parseFloat(a.price));
                }

                // Update low stock analytics
                updateInventoryAnalytics();

                if (filtered.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-gray-400">No items match your filters</td></tr>';
                    return;
                }

                tbody.innerHTML = filtered.map(item => {
                    const isLowStock = item.current_stock <= (item.low_stock_threshold || 10);
                    const stockClass = isLowStock ? 'text-red-500 font-bold' : 'text-gray-500 dark:text-gray-400';

                    return `
                        <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    ${item.image_url ?
                            `<img src="${item.image_url}" class="w-10 h-10 rounded-lg object-cover" alt="${item.name}">` :
                            '<div class="w-10 h-10 rounded-lg bg-gray-200 dark:bg-slate-700 flex items-center justify-center"><i class="fas fa-pills text-gray-400"></i></div>'}
                                    <div>
                                        <p class="font-bold text-sm dark:text-white">${item.name}</p>
                                        <p class="text-xs text-gray-400">${formatCategory(item.category)}</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-center ${stockClass}">
                                ${item.current_stock}
                                ${isLowStock ? '<i class="fas fa-exclamation-triangle ml-1 text-xs"></i>' : ''}
                            </td>
                            <td class="px-6 py-4 text-center font-bold text-green-600">
                                $${parseFloat(item.price).toFixed(2)}
                            </td>
                            <td class="px-6 py-4 text-center text-sm dark:text-gray-300">
                                ${formatCategory(item.category) || 'Uncategorized'}
                            </td>
                            <td class="px-6 py-4 text-right">
                                <button onclick="openEditModal('${item.id}')" 
                                    class="text-blue-500 hover:text-blue-700 mr-3 transition-colors">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button onclick="deleteProduct('${item.id}', '${item.name.replace(/'/g, "\\'")}')" 
                                    class="text-red-500 hover:text-red-700 transition-colors">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

            // Format category name for display
            function formatCategory(category) {
                if (!category) return 'Uncategorized';
                // Convert camelCase to Title Case
                return category
                    .replace(/([A-Z])/g, ' $1')
                    .replace(/^./, str => str.toUpperCase())
                    .trim();
            }

            // Update analytics cards (Most Used, Recently Added, Low Stock)
            // Store analytics data for modal
            let analyticsData = {
                mostUsed: [],
                recentlyEdited: [],
                lowStock: []
            };
            let aiUsed = false; // Track AI usage

            async function updateInventoryAnalytics() {
                // Fetch REAL sales data from API (not assuming low stock = most sold)
                try {
                    const res = await fetch('/doctor/inventory/most-sold');
                    const data = await res.json();
                    if (data.success) {
                        analyticsData.mostUsed = data.mostSold || [];
                    }
                } catch (e) {
                    console.error('Failed to fetch most sold:', e);
                    analyticsData.mostUsed = [];
                }

                // Recently Added (by created_at)
                analyticsData.recentlyEdited = [...inventoryCache]
                    .sort((a, b) => new Date(b.created_at) - new Date(a.created_at))
                    .slice(0, 10); // Limit to 10 for modal

                // Low Stock (ALL items below threshold)
                analyticsData.lowStock = inventoryCache
                    .filter(item => item.current_stock <= (item.low_stock_threshold || 10))
                    .sort((a, b) => a.current_stock - b.current_stock);

                // Update Most Used Preview (show #1 only - REAL sales data)
                const mostUsedPreview = document.getElementById('most-used-preview');
                const mostUsedCount = document.getElementById('most-used-count');
                if (mostUsedCount) mostUsedCount.textContent = analyticsData.mostUsed.length;

                if (mostUsedPreview) {
                    if (analyticsData.mostUsed.length === 0) {
                        mostUsedPreview.innerHTML = `
                            <div class="text-center py-4">
                                <i class="fas fa-shopping-cart text-3xl text-gray-300 mb-2"></i>
                                <p class="text-gray-400 text-sm">No sales this shift yet</p>
                            </div>`;
                    } else {
                        const top = analyticsData.mostUsed[0];
                        mostUsedPreview.innerHTML = `
                            <div class="flex items-center gap-3 p-3 bg-white/70 dark:bg-slate-800/70 rounded-xl">
                                <div class="w-12 h-12 rounded-lg bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center">
                                    <i class="fas fa-fire text-blue-500 text-xl"></i>
                                </div>
                                <div class="flex-1">
                                    <p class="font-bold text-gray-800 dark:text-white">${top.name}</p>
                                    <p class="text-xs text-gray-500">${formatCategory(top.category)}</p>
                                </div>
                                <div class="text-right">
                                    <p class="font-bold text-blue-600">${top.total_sold} sold</p>
                                    <p class="text-xs text-gray-400">${top.order_count} orders</p>
                                </div>
                            </div>`;
                    }
                }

                // Update Recently Added Preview (show #1 only)
                const recentPreview = document.getElementById('recently-edited-preview');
                const recentCount = document.getElementById('recently-edited-count');
                if (recentCount) recentCount.textContent = analyticsData.recentlyEdited.length;

                if (recentPreview) {
                    if (analyticsData.recentlyEdited.length === 0) {
                        recentPreview.innerHTML = `
                            <div class="text-center py-4">
                                <i class="fas fa-inbox text-3xl text-gray-300 mb-2"></i>
                                <p class="text-gray-400 text-sm">No products yet</p>
                            </div>`;
                    } else {
                        const top = analyticsData.recentlyEdited[0];
                        recentPreview.innerHTML = `
                            <div class="flex items-center gap-3 p-3 bg-white/70 dark:bg-slate-800/70 rounded-xl">
                                <div class="w-12 h-12 rounded-lg bg-purple-100 dark:bg-purple-900/50 flex items-center justify-center">
                                    <i class="fas fa-clock text-purple-500 text-xl"></i>
                                </div>
                                <div class="flex-1">
                                    <p class="font-bold text-gray-800 dark:text-white">${top.name}</p>
                                    <p class="text-xs text-gray-500">${formatCategory(top.category)}</p>
                                </div>
                                <div class="text-right">
                                    <p class="font-bold text-purple-600">${new Date(top.created_at).toLocaleDateString()}</p>
                                    <p class="text-xs text-gray-400">added</p>
                                </div>
                            </div>`;
                    }
                }

                // Update Low Stock Preview (show #1 only)
                const lowStockPreview = document.getElementById('low-stock-preview');
                const lowStockCount = document.getElementById('low-stock-count');
                if (lowStockCount) lowStockCount.textContent = analyticsData.lowStock.length;

                if (lowStockPreview) {
                    if (analyticsData.lowStock.length === 0) {
                        lowStockPreview.innerHTML = `
                            <div class="text-center py-4">
                                <i class="fas fa-check-circle text-3xl text-green-400 mb-2"></i>
                                <p class="text-green-500 text-sm font-medium">All products in stock!</p>
                            </div>`;
                    } else {
