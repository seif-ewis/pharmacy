<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

    <body
        class="bg-gray-50 dark:bg-[#0f172a] text-slate-800 dark:text-gray-100 font-sans antialiased transition-colors duration-300">
        <div class="flex h-screen overflow-hidden">
            <!-- SIDEBAR -->
            <aside
                class="w-64 bg-white dark:bg-slate-900 border-r border-gray-100 dark:border-slate-800 flex flex-col z-50 transition-all duration-300 transform -translate-x-full md:translate-x-0 fixed md:relative h-full"
                id="sidebar">
                <div class="p-6 flex items-center justify-between">
                    <a href="/doctor/dashboard" class="flex items-center gap-2">
                        <div
                            class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center text-white font-black text-lg">
                            H</div>
                        <span class="text-lg font-black tracking-tight dark:text-white">HOSAM<span
                                class="text-primary">DOC</span></span>
                    </a>
                    <button onclick="toggleSidebar()" class="md:hidden text-gray-400 hover:text-primary"><i
                            class="fas fa-times"></i></button>
                </div>
                <nav class="flex-1 overflow-y-auto px-4 space-y-1 custom-scrollbar">
                    <p class="px-4 text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-2 mt-4">Core</p>
                    <a onclick="showModule('overview')"
                        class="nav-item active flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-800 hover:text-primary transition-all cursor-pointer group">
                        <div class="flex items-center gap-3">
                            <i class="fas fa-th-large w-5 text-center group-hover:scale-110 transition-transform"></i>
                            <span>Overview</span>
                        </div>
                    </a>
                    <a onclick="showModule('shifts')"
                        class="nav-item flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-800 hover:text-primary transition-all cursor-pointer group">
                        <div class="flex items-center gap-3">
                            <i class="fas fa-clock w-5 text-center group-hover:scale-110 transition-transform"></i>
                            <span>Shifts</span>
                        </div>

                        <span id="badge-shift" class="hidden w-2 h-2 bg-red-500 rounded-full"></span>
                    </a>

                    <p class="px-4 text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-2 mt-6">Pharmacy</p>
                    <a onclick="showModule('orders')"
                        class="nav-item flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-800 hover:text-primary transition-all cursor-pointer group">
                        <div class="flex items-center gap-3">
                            <i
                                class="fas fa-shopping-bag w-5 text-center group-hover:scale-110 transition-transform"></i>
                            <span>Orders</span>
                        </div>
                        <span id="badge-orders"
                            class="bg-primary text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow-sm shadow-primary/30">
                            <%= activeOrders.length %>
                        </span>
                    </a>
                    <a onclick="showModule('prescriptions')"
                        class="nav-item flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-800 hover:text-primary transition-all cursor-pointer group">
                        <div class="flex items-center gap-3">
                            <i
                                class="fas fa-file-medical w-5 text-center group-hover:scale-110 transition-transform"></i>
                            <span>Prescriptions</span>
                        </div>
                        <span id="badge-prescriptions"
                            class="bg-purple-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow-sm shadow-purple-500/30">
                            <%= pendingPrescriptions.length %>
                        </span>
                    </a>
                    <a onclick="showModule('requests'); loadProductRequests();"
                        class="nav-item flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-800 hover:text-primary transition-all cursor-pointer group">
                        <div class="flex items-center gap-3">
                            <i
                                class="fas fa-hand-holding-medical w-5 text-center group-hover:scale-110 transition-transform"></i>
                            <span>Requests</span>
                        </div>
                        <span id="badge-requests"
                            class="hidden bg-amber-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow-sm shadow-amber-500/30">
                            0
                        </span>
                    </a>
                    <a onclick="showModule('inventory')"
                        class="nav-item flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-800 hover:text-primary transition-all cursor-pointer group">
                        <div class="flex items-center gap-3">
                            <i class="fas fa-boxes w-5 text-center group-hover:scale-110 transition-transform"></i>
                            <span>Inventory</span>
                        </div>
                    </a>
                    <a onclick="showModule('returns')"
                        class="nav-item flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-800 hover:text-primary transition-all cursor-pointer group">
                        <div class="flex items-center gap-3">
                            <i class="fas fa-undo w-5 text-center group-hover:scale-110 transition-transform"></i>
                            <span>Returns</span>
                        </div>
                    </a>


                    <p class="px-4 text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-2 mt-6">Communication
                    </p>
                    <a onclick="showModule('chats'); loadActiveChats();"
                        class="nav-item flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-800 hover:text-primary transition-all cursor-pointer group">
                        <div class="flex items-center gap-3">
                            <i class="fas fa-comments w-5 text-center group-hover:scale-110 transition-transform"></i>
                            <span>Chat</span>
                        </div>
                        <span id="badge-chats"
                            class="hidden bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full animate-pulse">New</span>
                    </a>
                    <a onclick="showModule('announcements'); loadAnnouncements();"
                        class="nav-item flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-slate-800 hover:text-primary transition-all cursor-pointer group">
                        <div class="flex items-center gap-3">
                            <i class="fas fa-bullhorn w-5 text-center group-hover:scale-110 transition-transform"></i>
                            <span>Announcements</span>
                        </div>
                        <span id="badge-announcements" class="hidden w-2 h-2 bg-blue-500 rounded-full"></span>
                    </a>

                    <div class="mt-auto pt-6 border-t border-gray-100 dark:border-slate-800 mt-6">
                        <a href="/auth/logout"
                            class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-red-500 hover:bg-red-50 dark:hover:bg-red-900/10 transition-all cursor-pointer">
                            <i class="fas fa-sign-out-alt w-5 text-center"></i>
                            <span>Logout</span>
                        </a>
                    </div>
                </nav>
            </aside>
            <!-- MAIN CONTENT -->
            <main class="flex-1 flex flex-col h-full relative">
                <!-- Header -->
                <header
                    class="h-16 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-gray-100 dark:border-slate-800 flex items-center justify-between px-6 sticky top-0 z-40">
                    <div class="flex items-center gap-4">
                        <button onclick="toggleSidebar()" class="md:hidden text-gray-500 hover:text-primary"><i
                                class="fas fa-bars text-xl"></i></button>
                        <h2 id="page-title" class="text-xl font-bold dark:text-white">Overview</h2>
                    </div>
                    <div class="flex items-center gap-6">
                        <!-- Pharmacy Status Toggle -->
                        <div
                            class="flex items-center gap-3 bg-gray-50 dark:bg-slate-800 px-3 py-1.5 rounded-full border border-gray-200 dark:border-slate-700">
                            <span id="pharmacyStatusLabel"
                                class="text-xs font-black uppercase <%= pharmacySettings && pharmacySettings.is_open ? 'text-green-500' : 'text-red-500' %>">
                                <%= pharmacySettings && pharmacySettings.is_open ? 'OPEN' : 'CLOSED' %>
                            </span>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" class="sr-only peer" <%=pharmacySettings &&
                                    pharmacySettings.is_open ? ' checked' : '' %> onchange="togglePharmacy(this)">
                                <div
                                    class="w-9 h-5 bg-gray-300 peer-focus:outline-none rounded-full peer dark:bg-slate-600 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-green-500">
                                </div>
                            </label>
                        </div>
                        <div class="flex items-center gap-3">
                            <div
                                class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-primary font-bold text-xs uppercase">
                                <%= user.full_name.charAt(0) %>
                            </div>
                            <span class="text-xs font-bold dark:text-gray-300 hidden sm:inline">Dr. <%= user.full_name
                                    %></span>
                        </div>
                    </div>
                </header>
                <!-- Modules Container -->
                <div class="flex-1 overflow-y-auto p-6 scroll-smooth custom-scrollbar" id="content-area">
                    <!-- MODULE: OVERVIEW -->
                    <!-- MODULE: PRODUCT REQUESTS -->
                    <div id="module-requests" class="module-content hidden animate-fade-in">
                        <div class="flex items-center justify-between mb-8">
                            <div>
                                <h2 class="text-2xl font-black dark:text-white">Product Requests</h2>
                                <p class="text-gray-500 text-sm">Manage user requests and market demand</p>
                            </div>
                            <div class="flex bg-gray-100 dark:bg-slate-800 p-1 rounded-xl">
                                <button onclick="switchRequestTab('pending')" id="tab-req-pending"
                                    class="px-4 py-2 rounded-lg text-sm font-bold bg-white dark:bg-slate-700 shadow-sm transition-all text-primary">
                                    Actionable (Pending)
                                </button>
                                <button onclick="switchRequestTab('history')" id="tab-req-history"
                                    class="px-4 py-2 rounded-lg text-sm font-bold text-gray-500 hover:text-gray-700 dark:text-gray-400 transition-all">
                                    Demand History
                                </button>
                            </div>
                        </div>

                        <!-- Pending Requests Grid -->
                        <div id="requests-pending-view" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <!-- Populated by JS -->
                        </div>

                        <!-- History List -->
                        <div id="requests-history-view"
                            class="hidden bg-white dark:bg-slate-800 rounded-2xl p-6 shadow-sm">
                            <h3 class="font-bold mb-4 dark:text-white">Request History</h3>
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm text-left">
                                    <thead class="text-xs text-gray-500 uppercase bg-gray-50 dark:bg-slate-700/50">
                                        <tr>
                                            <th class="px-4 py-3 rounded-l-lg">Product</th>
                                            <th class="px-4 py-3">User</th>
                                            <th class="px-4 py-3">Status</th>
                                            <th class="px-4 py-3 rounded-r-lg">Date</th>
                                        </tr>
                                    </thead>
                                    <tbody id="requests-history-table">
                                        <!-- Populated by JS -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div id="module-overview" class="module-content animate-fade-in">

                        <!-- Shift Status Banner -->
                        <% if (activeShift) { %>
                            <div id="shift-status-banner"
                                class="bg-gradient-to-r from-green-500 to-emerald-600 rounded-2xl p-6 text-white shadow-lg mb-6 flex items-center justify-between">
                                <div class="flex items-center gap-4">
                                    <div
                                        class="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center">
                                        <i class="fas fa-clock text-2xl"></i>
                                    </div>
                                    <div>
                                        <h3 class="font-black text-lg">Shift Active</h3>
                                        <p class="text-white/80 text-sm" id="shift-duration">Started at <%= new
                                                Date(activeShift.opened_at).toLocaleTimeString() %>
                                        </p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4">
                                    <div class="flex items-center gap-2">
                                        <span class="w-3 h-3 rounded-full bg-white animate-pulse"></span>
                                        <span class="font-bold text-sm uppercase tracking-wider">LIVE</span>
                                    </div>
                                    <button onclick="showModule('shifts')"
                                        class="bg-white/20 hover:bg-white/30 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors">
                                        View Report
                                    </button>
                                </div>
                            </div>
                            <% } else if (typeof globalActiveShift !=='undefined' && globalActiveShift) { %>
                                <div id="shift-status-banner"
                                    class="bg-gradient-to-r from-amber-600 to-orange-600 rounded-2xl p-6 text-white shadow-lg mb-6 flex items-center justify-between animate-pulse">
                                    <div class="flex items-center gap-4">
                                        <div
                                            class="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center">
                                            <i class="fas fa-lock text-2xl"></i>
                                        </div>
                                        <div>
                                            <h3 class="font-black text-lg">System Locked</h3>
                                            <p class="text-white/90 text-sm font-bold">Shift in progress by Dr. <%=
                                                    globalActiveShift.doctor_name || 'Unknown' %>
                                            </p>
                                            <p class="text-white/70 text-xs">Only one active shift is allowed at a time.
                                            </p>
                                        </div>
                                    </div>
                                    <button disabled
                                        class="bg-white/20 cursor-not-allowed text-white px-4 py-2 rounded-lg text-xs font-bold">
                                        Wait for End of Shift
                                    </button>
                                </div>
                                <% } else { %>
                                    <div id="shift-status-banner"
                                        class="bg-gradient-to-r from-slate-600 to-slate-700 rounded-2xl p-6 text-white shadow-lg mb-6 flex items-center justify-between">
                                        <div class="flex items-center gap-4">
                                            <div
                                                class="w-12 h-12 bg-white/10 backdrop-blur-sm rounded-full flex items-center justify-center">
                                                <i class="fas fa-moon text-2xl"></i>
                                            </div>
                                            <div>
                                                <h3 class="font-black text-lg">No Active Shift</h3>
                                                <p class="text-white/70 text-sm">Start a shift to begin monitoring</p>
                                            </div>
                                        </div>
                                        <form action="/doctor/shift/start" method="POST" class="inline">
                                            <button type="submit"
                                                class="bg-white/20 hover:bg-white/30 backdrop-blur-sm px-6 py-2 rounded-lg font-bold text-sm transition-all">
                                                Start Shift
                                            </button>
                                        </form>
                                    </div>
                                    <% } %>

                                        <!-- Live Counters Grid (4 cards) -->
                                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
                                            <!-- Revenue -->
                                            <div
                                                class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700/50">
                                                <div class="flex items-center gap-3 mb-3">
                                                    <div
                                                        class="w-10 h-10 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center text-green-600">
                                                        <i class="fas fa-dollar-sign"></i>
                                                    </div>
                                                    <span
                                                        class="text-xs font-bold text-gray-400 uppercase">Revenue</span>
                                                </div>
                                                <h3 id="counter-revenue" class="text-3xl font-black dark:text-white">$
                                                    <%= activeShift ? parseFloat(activeShift.net_revenue ||
                                                        0).toFixed(2) : '0.00' %>
                                                </h3>
                                                <div class="flex items-center gap-2 mt-1">
                                                    <span class="text-[10px] text-gray-400">Net</span>
                                                    <span id="counter-gross-revenue"
                                                        class="text-[9px] text-green-500 font-bold">(G: $<%= activeShift
                                                            ? activeShift.gross_revenue : '0' %>)</span>
                                                    <span id="counter-refunds"
                                                        class="text-[9px] text-red-500 font-bold">(R: $<%= activeShift ?
                                                            activeShift.total_refunds : '0' %>)</span>
                                                </div>
                                            </div>

                                            <!-- Orders -->
                                            <div
                                                class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700/50">
                                                <div class="flex items-center gap-3 mb-3">
                                                    <div
                                                        class="w-10 h-10 bg-blue-100 dark:bg-blue-900/30 rounded-xl flex items-center justify-center text-blue-600">
                                                        <i class="fas fa-shopping-bag"></i>
                                                    </div>
                                                    <span
                                                        class="text-xs font-bold text-gray-400 uppercase">Orders</span>
                                                </div>
                                                <h3 id="counter-orders" class="text-3xl font-black dark:text-white">
                                                    <%= activeShift ? (activeShift.total_orders || 0) : 0 %>
                                                </h3>
                                                <p class="text-[10px] text-gray-400 mt-1">Pending</p>
                                            </div>

                                            <!-- Prescriptions -->
                                            <div
                                                class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700/50">
                                                <div class="flex items-center gap-3 mb-3">
                                                    <div
                                                        class="w-10 h-10 bg-purple-100 dark:bg-purple-900/30 rounded-xl flex items-center justify-center text-purple-600">
                                                        <i class="fas fa-file-medical"></i>
                                                    </div>
                                                    <span
                                                        class="text-xs font-bold text-gray-400 uppercase">Prescriptions</span>
                                                </div>
                                                <h3 id="counter-prescriptions"
                                                    class="text-3xl font-black dark:text-white">
                                                    <%= activeShift ? (activeShift.total_prescriptions || 0) : 0 %>
                                                </h3>
                                                <p class="text-[10px] text-gray-400 mt-1">Reviewing</p>
                                            </div>

                                            <!-- Total Requests -->
                                            <div
                                                class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700/50">
                                                <div class="flex items-center gap-3 mb-3">
                                                    <div
                                                        class="w-10 h-10 bg-orange-100 dark:bg-orange-900/30 rounded-xl flex items-center justify-center text-orange-600">
                                                        <i class="fas fa-chart-line"></i>
                                                    </div>
                                                    <span
                                                        class="text-xs font-bold text-gray-400 uppercase">Requests</span>
                                                </div>
                                                <h3 id="counter-total-requests"
                                                    class="text-3xl font-black dark:text-white">
                                                    0</h3>
                                                <p class="text-[10px] text-gray-400 mt-1">All-Time</p>
                                            </div>
                                        </div>

                                        <!-- Alerts Section -->
                                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                                            <!-- Low Stock Alert -->
                                            <div class="bg-gradient-to-br from-yellow-50 to-amber-50 dark:from-yellow-900/20 dark:to-amber-900/20 border-2 border-yellow-200 dark:border-yellow-800 rounded-2xl p-6 relative overflow-hidden group cursor-pointer hover:scale-[1.02] transition-all"
                                                onclick="showModule('inventory')">
                                                <div class="relative z-10">
                                                    <div class="flex items-center justify-between mb-3">
                                                        <div class="flex items-center gap-3">
                                                            <div
                                                                class="w-10 h-10 bg-yellow-500 rounded-xl flex items-center justify-center text-white">
                                                                <i class="fas fa-exclamation-triangle"></i>
                                                            </div>
                                                            <h4 class="font-black text-dark dark:text-white">Low Stock
                                                                Alert
                                                            </h4>
                                                        </div>
                                                        <span id="alert-low-stock-count"
                                                            class="text-2xl font-black text-yellow-600 dark:text-yellow-400">0</span>
                                                    </div>
                                                    <p class="text-sm text-gray-600 dark:text-gray-400">Items running
                                                        low in
                                                        inventory</p>
                                                </div>
                                                <i
                                                    class="fas fa-boxes absolute -right-6 -bottom-6 text-8xl text-yellow-400/10 group-hover:rotate-12 transition-transform"></i>
                                            </div>

                                            <!-- Scheduled Orders Alert -->
                                            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 border-2 border-blue-200 dark:border-blue-800 rounded-2xl p-6 relative overflow-hidden group cursor-pointer hover:scale-[1.02] transition-all"
                                                onclick="showModule('orders')">
                                                <div class="relative z-10">
                                                    <div class="flex items-center justify-between mb-3">
                                                        <div class="flex items-center gap-3">
                                                            <div
                                                                class="w-10 h-10 bg-blue-500 rounded-xl flex items-center justify-center text-white">
                                                                <i class="fas fa-clock"></i>
                                                            </div>
                                                            <h4 class="font-black text-dark dark:text-white">Scheduled
                                                                Orders</h4>
                                                        </div>
                                                        <span id="alert-scheduled-count"
                                                            class="text-2xl font-black text-blue-600 dark:text-blue-400">0</span>
                                                    </div>
                                                    <p class="text-sm text-gray-600 dark:text-gray-400">Orders waiting
                                                        for
                                                        pharmacy</p>
                                                </div>
                                                <i
                                                    class="fas fa-calendar-alt absolute -right-6 -bottom-6 text-8xl text-blue-400/10 group-hover:rotate-12 transition-transform"></i>
                                            </div>
                                        </div>

                                        <!-- Trending Requested Medicines -->
                                        <div
                                            class="bg-white dark:bg-slate-800 rounded-2xl border border-gray-100 dark:border-slate-700 p-6">
                                            <h3 class="font-bold dark:text-white mb-4 flex items-center gap-2">
                                                <i class="fas fa-fire text-orange-500"></i>
                                                Trending Requests
                                            </h3>
                                            <div class="space-y-3">
                                                <% if (trendingRequests && trendingRequests.length> 0) { %>
                                                    <% trendingRequests.forEach((req, index)=> { %>
                                                        <div
                                                            class="flex items-center justify-between p-3 bg-gray-50 dark:bg-slate-700/50 rounded-xl hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors">
                                                            <div class="flex items-center gap-3">
                                                                <span
                                                                    class="w-6 h-6 rounded-full bg-primary text-white text-xs flex items-center justify-center font-bold">
                                                                    <%= index + 1 %>
                                                                </span>
                                                                <span class="text-sm font-bold dark:text-gray-200">
                                                                    <%= req.product_name %>
                                                                </span>
                                                            </div>
                                                            <span class="text-xs font-black text-gray-400">
                                                                <%= req.count %> REQ
                                                            </span>
                                                        </div>
                                                        <% }); %>
                                                            <% } else { %>
                                                                <p class="text-center text-gray-400 text-sm py-4">No
                                                                    trending requests yet</p>
                                                                <% } %>
                                            </div>
                                        </div>

                    </div>

                    <!-- MODULE: SHIFTS (REPORTS VIEW) -->
                    <div id="module-shifts" class="module-content hidden animate-fade-in">
                        <div class="mb-6 flex items-center justify-between">
                            <div>
                                <h2 class="text-2xl font-black dark:text-white mb-2">Shift Reports</h2>
                                <p class="text-sm text-gray-500">Manage daily shifts and view detailed performance
                                    reports.</p>
                            </div>
                            <!-- Open/Close Actions -->
                            <% if (activeShift) { %>
                                <form action="/doctor/shift/end" method="POST"
                                    onsubmit="return confirm('End current shift? This will generate a final report.');">
                                    <input type="hidden" name="shiftId" value="<%= activeShift.id %>">
                                    <button type="submit"
                                        class="bg-red-500 hover:bg-red-600 text-white px-6 py-3 rounded-xl font-bold shadow-lg shadow-red-500/30 transition-all flex items-center gap-2">
                                        <i class="fas fa-stop-circle"></i> End Shift
                                    </button>
                                </form>
                                <% } else { %>
                                    <form action="/doctor/shift/start" method="POST">
                                        <button type="submit"
                                            class="bg-green-500 hover:bg-green-600 text-white px-6 py-3 rounded-xl font-bold shadow-lg shadow-green-500/30 transition-all flex items-center gap-2">
                                            <i class="fas fa-play-circle"></i> Start New Shift
                                        </button>
                                    </form>
                                    <% } %>
                        </div>

                        <% if (activeShift) { %>
                            <!-- Live Report Card -->
                            <div
                                class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-gray-100 dark:border-slate-700 shadow-sm mb-8 relative overflow-hidden">
                                <div class="absolute top-0 right-0 p-4 opacity-5">
                                    <i class="fas fa-chart-line text-9xl"></i>
                                </div>

                                <div class="relative z-10">
                                    <div class="flex items-center justify-between mb-6">
                                        <div>
                                            <span
                                                class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">Active
                                                Now</span>
                                            <h3 class="text-xl font-black dark:text-white mt-2">Current Shift Summary
                                            </h3>
                                            <p class="text-sm text-gray-500">Started: <%= new
                                                    Date(activeShift.opened_at).toLocaleTimeString() %>
                                            </p>
                                        </div>
                                        <!-- Export Button -->
                                        <a href="/doctor/shift/<%= activeShift.id %>/export-pdf" target="_blank"
                                            class="bg-white dark:bg-slate-700 border border-gray-200 dark:border-slate-600 hover:bg-gray-50 dark:hover:bg-slate-600 text-gray-600 dark:text-white px-4 py-2 rounded-lg text-xs font-bold flex items-center gap-2 transition-colors">
                                            <i class="fas fa-file-pdf text-red-500"></i> Report (Live)
                                        </a>
                                    </div>

                                    <!-- Stats Grid -->
                                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
                                        <!-- Revenue -->
                                        <div
                                            class="bg-gray-50 dark:bg-slate-700/50 p-4 rounded-xl border border-gray-100 dark:border-slate-600">
                                            <div class="flex items-center gap-3 mb-2">
                                                <div
                                                    class="w-8 h-8 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center text-green-600">
                                                    <i class="fas fa-dollar-sign"></i>
                                                </div>
                                                <span class="text-xs font-bold text-gray-500 uppercase">Revenue</span>
                                            </div>
                                            <p id="shift-live-revenue" class="text-2xl font-black dark:text-white">$<%=
                                                    parseFloat(activeShift.gross_revenue || 0).toFixed(2) %>
                                            </p>
                                        </div>

                                        <!-- Orders -->
                                        <div
                                            class="bg-gray-50 dark:bg-slate-700/50 p-4 rounded-xl border border-gray-100 dark:border-slate-600">
                                            <div class="flex items-center gap-3 mb-2">
                                                <div
                                                    class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600">
                                                    <i class="fas fa-shopping-bag"></i>
                                                </div>
                                                <span class="text-xs font-bold text-gray-500 uppercase">Orders</span>
                                            </div>
                                            <p id="shift-live-orders" class="text-2xl font-black dark:text-white">
                                                <%= activeShift.total_orders || 0 %>
                                            </p>
                                        </div>

                                        <!-- Prescriptions -->
                                        <div
                                            class="bg-gray-50 dark:bg-slate-700/50 p-4 rounded-xl border border-gray-100 dark:border-slate-600">
                                            <div class="flex items-center gap-3 mb-2">
                                                <div
                                                    class="w-8 h-8 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600">
                                                    <i class="fas fa-file-medical"></i>
                                                </div>
                                                <span
                                                    class="text-xs font-bold text-gray-500 uppercase">Prescriptions</span>
                                            </div>
                                            <p id="shift-live-prescriptions"
                                                class="text-2xl font-black dark:text-white">
                                                <%= activeShift.total_prescriptions || 0 %>
                                            </p>
                                        </div>

                                        <!-- Returns -->
                                        <div
                                            class="bg-gray-50 dark:bg-slate-700/50 p-4 rounded-xl border border-gray-100 dark:border-slate-600">
                                            <div class="flex items-center gap-3 mb-2">
                                                <div
                                                    class="w-8 h-8 rounded-lg bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center text-orange-600">
                                                    <i class="fas fa-undo"></i>
                                                </div>
                                                <span class="text-xs font-bold text-gray-500 uppercase">Returns</span>
                                            </div>
                                            <p id="shift-live-returns" class="text-2xl font-black dark:text-white">
                                                <%= activeShift.total_returns || 0 %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% } %>

                                <!-- Previous Shifts -->
                                <div
                                    class="bg-white dark:bg-slate-800 rounded-2xl border border-gray-100 dark:border-slate-700 overflow-hidden">
                                    <div class="p-6 border-b border-gray-100 dark:border-slate-700">
                                        <h3 class="text-xl font-black dark:text-white">Shift History</h3>
                                        <p class="text-sm text-gray-500">View and export previous shift reports</p>
                                    </div>
                                    <div class="overflow-x-auto">
                                        <table class="w-full">
                                            <thead
                                                class="bg-gray-50 dark:bg-slate-700/50 text-xs text-gray-400 uppercase font-bold">
                                                <tr>
                                                    <th class="px-6 py-4 text-left">Shift Period</th>
                                                    <th class="px-6 py-4 text-center">Orders</th>
                                                    <th class="px-6 py-4 text-center">Prescriptions</th>
                                                    <th class="px-6 py-4 text-center">Returns</th>
                                                    <th class="px-6 py-4 text-center">Revenue</th>
                                                    <th class="px-6 py-4 text-right">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody class="divide-y divide-gray-100 dark:divide-slate-700">
                                                <% if (typeof previousShifts !=='undefined' && previousShifts.length> 0)
                                                    { %>
                                                    <% previousShifts.forEach(shift=> { %>
                                                        <tr
                                                            class="hover:bg-gray-50 dark:hover:bg-slate-700/30 transition-colors">
                                                            <td class="px-6 py-4">
                                                                <div>
                                                                    <p class="font-bold text-sm dark:text-white">
                                                                        <%= new
                                                                            Date(shift.opened_at).toLocaleDateString()
                                                                            %>
                                                                    </p>
                                                                    <p class="text-xs text-gray-400">
                                                                        <%= new
                                                                            Date(shift.opened_at).toLocaleTimeString()
                                                                            %> -
                                                                            <%= shift.closed_at ? new
                                                                                Date(shift.closed_at).toLocaleTimeString()
                                                                                : 'Ongoing' %>
                                                                    </p>
                                                                </div>
                                                            </td>
                                                            <td class="px-6 py-4 text-center">
                                                                <span
                                                                    class="inline-flex items-center gap-1 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 px-3 py-1 rounded-full text-sm font-bold">
                                                                    <i class="fas fa-shopping-bag text-xs"></i>
                                                                    <%= shift.total_orders || 0 %>
                                                                </span>
                                                            </td>
                                                            <td class="px-6 py-4 text-center">
                                                                <span
                                                                    class="inline-flex items-center gap-1 bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 px-3 py-1 rounded-full text-sm font-bold">
                                                                    <i class="fas fa-file-medical text-xs"></i>
                                                                    <%= shift.total_prescriptions || 0 %>
                                                                </span>
                                                            </td>
                                                            <td class="px-6 py-4 text-center">
                                                                <span
                                                                    class="inline-flex items-center gap-1 bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 px-3 py-1 rounded-full text-sm font-bold">
                                                                    <i class="fas fa-undo text-xs"></i>
                                                                    <%= shift.total_returns || 0 %>
                                                                </span>
                                                            </td>
                                                            <td class="px-6 py-4 text-center">
                                                                <span
                                                                    class="text-lg font-black text-green-600 dark:text-green-400">
                                                                    $<%= parseFloat(shift.gross_revenue || 0).toFixed(2)
                                                                        %>
                                                                </span>
                                                            </td>
                                                            <td class="px-6 py-4 text-right">
                                                                <div class="flex items-center justify-end gap-2">
                                                                    <button
                                                                        onclick="viewShiftDetails('<%= shift.id %>')"
                                                                        class="px-4 py-2 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 rounded-lg text-xs font-bold hover:bg-indigo-100 dark:hover:bg-indigo-900/50 transition-colors flex items-center gap-2">
                                                                        <i class="fas fa-eye"></i>
                                                                        View
                                                                    </button>
                                                                    <a href="/doctor/shift/<%= shift.id %>/export-pdf"
                                                                        target="_blank"
                                                                        class="px-4 py-2 bg-red-50 dark:bg-red-900/30 text-red-600 dark:text-red-400 rounded-lg text-xs font-bold hover:bg-red-100 dark:hover:bg-red-900/50 transition-colors flex items-center gap-2">
                                                                        <i class="fas fa-file-pdf"></i>
                                                                        PDF
                                                                    </a>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                            <% } else { %>
                                                                <tr>
                                                                    <td colspan="6" class="px-6 py-12 text-center">
                                                                        <i
                                                                            class="fas fa-clock text-gray-300 dark:text-gray-600 text-4xl mb-3"></i>
                                                                        <p class="text-gray-400 text-sm">No previous
                                                                            shifts found</p>
                                                                    </td>
                                                                </tr>
                                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                    </div>

                    <!-- MODULE: ORDERS (Work Queue) -->
                    <div id="module-orders" class="module-content hidden animate-fade-in">
                        <!-- Header -->
                        <div class="mb-6">
                            <h2 class="text-2xl font-black dark:text-white mb-2">Orders Work Queue</h2>
                            <p class="text-sm text-gray-500">Real-time order processing and management</p>
                        </div>

                        <% if (!activeShift) { %>
                            <!-- Missing Shift Warning -->
                            <div
                                class="bg-amber-50 dark:bg-amber-900/20 border-l-4 border-amber-500 p-4 mb-6 rounded-r-xl animate-pulse">
                                <div class="flex items-center gap-3">
                                    <i class="fas fa-exclamation-triangle text-amber-500 text-xl"></i>
                                    <div>
                                        <h4 class="font-bold text-amber-900 dark:text-amber-200">No Active Shift</h4>
                                        <p class="text-sm text-amber-800 dark:text-amber-300">
                                            You must <strong>Start a Shift</strong> to "Complete" or "Deliver" orders.
                                            Orders can still be "Processed", but revenue attribution requires an open
                                            shift.
                                        </p>
                                    </div>
                                    <button onclick="showModule('shifts')"
                                        class="ml-auto bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors">
                                        Open Shifts
                                    </button>
                                </div>
                            </div>
                            <% } %>

                                <!-- Status Tabs -->
                                <div class="flex flex-col md:flex-row items-center justify-between mb-4 gap-4">
                                    <!-- Search -->
                                    <div class="relative flex-1 w-full md:max-w-md">
                                        <i
                                            class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                                        <input type="text" id="order-search-input" oninput="applyOrderFilters()"
                                            class="w-full bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl pl-10 pr-4 py-3 outline-none focus:ring-2 focus:ring-primary dark:text-white transition-all shadow-sm"
                                            placeholder="Search by Order ID or Customer Name...">
                                    </div>

                                    <!-- Filters -->
                                    <div class="flex items-center gap-2 w-full md:w-auto">
                                        <select id="order-sort-input" onchange="applyOrderFilters()"
                                            class="bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary dark:text-white shadow-sm text-sm">
                                            <option value="newest">Newest First</option>
                                            <option value="oldest">Oldest First</option>
                                        </select>

                                        <select id="order-date-input" onchange="applyOrderFilters()"
                                            class="bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary dark:text-white shadow-sm text-sm">
                                            <option value="today">Today</option>
                                            <option value="yesterday">Yesterday</option>
                                            <option value="week">Last 7 Days</option>
                                            <option value="all" selected>All Time</option>
                                        </select>
                                    </div>
                                </div>

                                <div
                                    class="bg-white dark:bg-slate-800 rounded-2xl border border-gray-100 dark:border-slate-700 mb-6 p-2 overflow-x-auto">
                                    <div class="flex gap-2 min-w-max">
                                        <button onclick="filterOrdersByStatus('pending')"
                                            class="order-status-tab active px-6 py-3 rounded-xl font-bold text-sm transition-all"
                                            data-status="pending">
                                            <i class="fas fa-clock mr-2"></i>Pending
                                            <span
                                                class="ml-2 px-2 py-0.5 bg-amber-500 text-white rounded-full text-[10px]"
                                                id="count-pending">0</span>
                                        </button>
                                        <button onclick="filterOrdersByStatus('scheduled')"
                                            class="order-status-tab px-6 py-3 rounded-xl font-bold text-sm transition-all"
                                            data-status="scheduled">
                                            <i class="fas fa-calendar mr-2"></i>Scheduled
                                            <span
                                                class="ml-2 px-2 py-0.5 bg-purple-500 text-white rounded-full text-[10px]"
                                                id="count-scheduled">0</span>
                                        </button>
                                        <button onclick="filterOrdersByStatus('processing')"
                                            class="order-status-tab px-6 py-3 rounded-xl font-bold text-sm transition-all"
                                            data-status="processing">
                                            <i class="fas fa-spinner mr-2"></i>Processing
                                            <span
                                                class="ml-2 px-2 py-0.5 bg-blue-500 text-white rounded-full text-[10px]"
                                                id="count-processing">0</span>
                                        </button>
                                        <button onclick="filterOrdersByStatus('completed')"
                                            class="order-status-tab px-6 py-3 rounded-xl font-bold text-sm transition-all"
                                            data-status="completed">
                                            <i class="fas fa-check-circle mr-2"></i>Completed
                                            <span
                                                class="ml-2 px-2 py-0.5 bg-green-500 text-white rounded-full text-[10px]"
                                                id="count-completed">0</span>
                                        </button>
                                        <button onclick="filterOrdersByStatus('canceled')"
                                            class="order-status-tab px-6 py-3 rounded-xl font-bold text-sm transition-all"
                                            data-status="canceled">
                                            <i class="fas fa-times-circle mr-2"></i>Cancelled
                                            <span
                                                class="ml-2 px-2 py-0.5 bg-red-500 text-white rounded-full text-[10px]"
                                                id="count-canceled">0</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Orders Container -->
                                <div id="orders-container" class="space-y-4">
                                    <!-- Orders will be loaded here dynamically -->
                                    <div class="text-center py-12 text-gray-400">
                                        <i class="fas fa-spinner fa-spin text-4xl mb-3"></i>
                                        <p>Loading orders...</p>
                                    </div>
                                </div>
                    </div>

                    <!-- MODULE: PRESCRIPTIONS -->
                    <div id="module-prescriptions" class="module-content hidden animate-fade-in">
                        <!-- AI Warning Banner -->
                        <div
                            class="bg-gradient-to-r from-yellow-500 to-amber-600 rounded-2xl p-6 text-white shadow-xl mb-6 flex items-start gap-4">
                            <div
                                class="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center shrink-0">
                                <i class="fas fa-exclamation-triangle text-2xl"></i>
                            </div>
                            <div>
                                <h3 class="font-black text-lg mb-2">⚠️ AI Suggestions Require Manual Review</h3>
                                <p class="text-white/90 text-sm">AI-assisted prescription reading is a tool to help you
                                    work faster. <strong>You must manually verify all suggestions before
                                        approval.</strong> Never approve without reviewing the prescription image and AI
                                    results.</p>
                            </div>
                        </div>

                        <!-- Header -->
                        <div class="mb-6 flex items-center justify-between">
                            <div>
                                <h2 class="text-2xl font-black dark:text-white mb-2">Prescriptions Queue</h2>
                                <p class="text-sm text-gray-500">Review and process prescription requests</p>
                            </div>
                            <div
                                class="flex items-center gap-2 bg-purple-100 dark:bg-purple-900/30 px-4 py-2 rounded-full">
                                <i class="fas fa-file-medical text-purple-600"></i>
                                <span class="font-bold text-purple-600 dark:text-purple-400" id="rx-count">
                                    <%= pendingPrescriptions.length %>
                                </span>
                                <span class="text-sm text-purple-600 dark:text-purple-400">Pending</span>
                            </div>
                        </div>

                        <!-- Prescriptions Grid -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
                            <% pendingPrescriptions.forEach(rx=> { %>
                                <div
                                    class="bg-white dark:bg-slate-800 rounded-2xl border-2 border-gray-100 dark:border-slate-700 overflow-hidden group hover:shadow-xl hover:border-purple-300 dark:hover:border-purple-700 transition-all">
                                    <!-- Prescription Image Preview -->
                                    <div class="aspect-video bg-gray-100 dark:bg-slate-900 relative overflow-hidden cursor-pointer"
                                        onclick="openPrescriptionViewer('<%= rx.id %>')">
                                        <img src="<%= rx.image_url %>" alt="Prescription"
                                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent">
                                        </div>
                                        <div
                                            class="absolute top-3 right-3 bg-black/60 backdrop-blur-sm text-white text-xs font-bold px-3 py-1 rounded-full">
                                            <%= rx.timeAgo %>
                                        </div>
                                        <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
                                            <span class="text-white font-bold text-sm">Click to review</span>
                                            <i class="fas fa-search-plus text-white"></i>
                                        </div>
                                    </div>

                                    <!-- Prescription Info -->
                                    <div class="p-5">
                                        <div class="flex items-start justify-between mb-3">
                                            <div>
                                                <h4 class="font-black dark:text-white text-lg">
                                                    <%= rx.user_name %>
                                                </h4>
                                                <p class="text-xs text-gray-400 mt-1">Patient ID: <%=
                                                        rx.user_id.substring(0, 8) %>
                                                </p>
                                            </div>
                                            <% if (rx.has_ai_result) { %>
                                                <span
                                                    class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-lg text-[10px] font-bold flex items-center gap-1">
                                                    <i class="fas fa-robot"></i>AI
                                                </span>
                                                <% } %>
                                        </div>

                                        <div class="flex gap-2">
                                            <button onclick="openPrescriptionViewer('<%= rx.id %>')"
                                                class="flex-1 bg-gradient-to-r from-purple-500 to-indigo-600 hover:from-purple-600 hover:to-indigo-700 text-white font-bold py-3 rounded-xl transition-all flex items-center justify-center gap-2 shadow-lg shadow-purple-500/30">
                                                <i class="fas fa-eye"></i>
                                                Review
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>

                                    <% if(pendingPrescriptions.length===0) { %>
                                        <div class="col-span-full py-20 text-center text-gray-400">
                                            <i class="fas fa-check-circle text-6xl mb-4 opacity-20"></i>
                                            <p class="text-lg font-bold">No pending prescriptions</p>
                                            <p class="text-sm">All prescriptions have been reviewed</p>
                                        </div>
                                        <% } %>
                        </div>
                    </div>

                    <!-- Prescription Viewer Modal (Full Screen) -->
                    <div id="prescription-viewer-modal"
                        class="fixed inset-0 bg-black/95 backdrop-blur-sm z-50 hidden flex items-center justify-center p-6">
                        <div class="w-full max-w-7xl h-full flex flex-col">
                            <!-- Modal Header -->
                            <div class="flex items-center justify-between mb-6 text-white">
                                <div>
                                    <h2 class="text-2xl font-black">Prescription Review</h2>
                                    <p class="text-sm text-gray-400" id="viewer-patient-name">Loading...</p>
                                </div>
                                <button onclick="closePrescriptionViewer()"
                                    class="w-12 h-12 bg-white/10 hover:bg-white/20 rounded-full flex items-center justify-center transition-colors">
                                    <i class="fas fa-times text-xl"></i>
                                </button>
                            </div>

                            <!-- Content Grid -->
                            <div class="flex-1 grid grid-cols-1 lg:grid-cols-2 gap-6 overflow-hidden min-h-0">
                                <!-- LEFT: Prescription Image Viewer -->
                                <div class="bg-white/5 rounded-2xl p-6 flex flex-col">
                                    <h3 class="text-white font-bold mb-4 flex items-center gap-2">
                                        <i class="fas fa-file-medical"></i>
                                        Prescription Document
                                    </h3>
                                    <div class="bg-white rounded-xl overflow-hidden h-[500px]">
                                        <img id="viewer-image" src="" alt="Prescription"
                                            class="w-full h-full object-contain">
                                    </div>
                                </div>

                                <!-- RIGHT: Review Panel -->
                                <div
                                    class="bg-white dark:bg-slate-800 rounded-2xl p-6 flex flex-col overflow-y-auto min-h-0">
                                    <!-- AI Analysis Actions -->
                                    <div id="ai-actions-section" class="hidden mb-6">
                                        <button onclick="analyzePrescription()"
                                            class="w-full bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white font-bold py-3 rounded-xl transition-all flex items-center justify-center gap-2 shadow-lg shadow-blue-500/30">
                                            <i class="fas fa-magic"></i> Analyze with AI
                                        </button>
                                        <p class="text-xs text-center text-gray-400 mt-2">Get medicine suggestions from
                                            the prescription image</p>
                                    </div>

                                    <!-- AI Results (if available) -->
                                    <div id="ai-results-section" class="hidden mb-6">
                                        <div
                                            class="bg-blue-50 dark:bg-blue-900/20 border-2 border-blue-200 dark:border-blue-800 rounded-xl p-4 mb-4">
                                            <div class="flex items-center justify-between mb-3">
                                                <h4
                                                    class="font-bold text-blue-900 dark:text-blue-200 flex items-center gap-2">
                                                    <i class="fas fa-robot"></i>
                                                    AI-Assisted Reading
                                                </h4>
                                                <span id="ai-confidence"
                                                    class="px-3 py-1 bg-blue-200 dark:bg-blue-800 text-blue-900 dark:text-blue-200 rounded-full text-xs font-bold"></span>
                                            </div>
                                            <div id="ai-suggested-medicines" class="space-y-2"></div>
                                        </div>
                                        <div
                                            class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-3 mb-4 flex items-start gap-2">
                                            <i class="fas fa-exclamation-triangle text-yellow-600 mt-1"></i>
