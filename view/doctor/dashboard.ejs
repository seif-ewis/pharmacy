                                     <p class="text-gray-500 mb-2 font-bold uppercase">Items:</p>
                                     <ul class="space-y-1">
                                        ${r.items.map(i => `
                                            <li class="flex justify-between">
                                                <span class="dark:text-gray-300">• ${i.medicine_name} (x${i.quantity})</span>
                                            </li>
