<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">

<head>
    <%- include('partials/head') %>
        <title>
            <%= title %> | PharmaOS
        </title>
</head>

<body class="bg-[#F8FAFC] dark:bg-[#020617] min-h-screen flex flex-col transition-colors duration-300">

    <%- include('partials/header') %>

        <main class="flex-grow pt-28 pb-16">
            <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h1 class="text-3xl md:text-4xl font-extrabold text-dark dark:text-white mb-4 tracking-tight">
                        <%= typeof t !=='undefined' ? t('browse_categories') : 'Browse Categories' %>
                    </h1>
                    <p class="text-gray-500 dark:text-gray-400 max-w-2xl mx-auto text-lg">
                        Explore our wide range of pharmaceutical products and services designed for your health and
                        wellness.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    <% categories.forEach(cat=> { %>
                        <a href="/category/<%= cat.slug %>"
                            class="group relative bg-white dark:bg-slate-900 rounded-3xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-slate-800 overflow-hidden text-center flex flex-col items-center h-full">
                            <div
                                class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-gradient-to-br from-transparent to-primary/5 dark:to-blue-500/10 pointer-events-none">
                            </div>

                            <div
                                class="w-20 h-20 rounded-2xl flex items-center justify-center mb-6 text-3xl transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3 shadow-lg <%= cat.color %>">
                                <i class="fas <%= cat.icon %>"></i>
                            </div>

                            <h2
                                class="text-xl font-bold text-dark dark:text-white mb-3 group-hover:text-primary dark:group-hover:text-blue-400 transition-colors">
                                <%= cat.name %>
                            </h2>

                            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-6">
                                <%= cat.description %>
                            </p>

                            <div class="mt-auto w-full flex justify-center">
                                <span
                                    class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-gray-50 dark:bg-slate-800 text-gray-400 group-hover:bg-primary group-hover:text-white dark:group-hover:bg-blue-500 transition-all duration-300 shadow-sm">
                                    <i
                                        class="fas fa-arrow-right transform group-hover:translate-x-1 transition-transform"></i>
                                </span>
                            </div>
                        </a>
                        <% }) %>
                </div>
            </div>
        </main>

        <%- include('partials/footer') %>

</body>

</html>