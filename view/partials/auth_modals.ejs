<!-- Auth Modal (Hidden by Default) -->
<div id="auth-modal" class="fixed inset-0 z-[60] hidden">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-dark/60 backdrop-blur-sm transition-opacity opacity-0" id="modal-backdrop">
    </div>

    <!-- Modal Content -->
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-md p-6 scale-95 opacity-0 transition-all duration-300"
        id="modal-panel">
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl overflow-hidden relative">
            <button onclick="closeAuthModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 z-10">
                <i class="fas fa-times text-xl"></i>
            </button>

            <div class="p-8">
                <!-- Auth Tabs -->
                <div id="auth-tabs" class="flex border-b border-gray-100 dark:border-slate-700 mb-6">
                    <button onclick="switchTab('login')" id="tab-login"
                        class="flex-1 pb-3 text-sm font-bold text-center border-b-2 border-primary text-primary transition-colors">Log
                        In</button>
                    <button onclick="switchTab('register')" id="tab-register"
                        class="flex-1 pb-3 text-sm font-bold text-center border-b-2 border-transparent text-gray-400 hover:text-gray-600 transition-colors">Join
                        Now</button>
                </div>

                <!-- Login Form -->
                <div id="view-login" class="animate-fade-in-down">
                    <div class="text-center mb-6">
                        <h3 class="text-2xl font-bold text-dark dark:text-white">Welcome Back</h3>
                        <p class="text-gray-500 dark:text-gray-400 text-sm">Please login to access your account.</p>
                    </div>

                    <form id="login-form" action="/auth/login" method="POST" class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Email</label>
                            <input type="email" name="email" required placeholder="user@gmail.com"
                                class="w-full px-4 py-2 border border-gray-200 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all dark:bg-slate-700 dark:text-white">
                        </div>
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label
                                    class="block text-sm font-medium text-gray-700 dark:text-gray-300">Password</label>
                                <button type="button" onclick="switchTab('forgot-password')"
                                    class="text-[10px] text-primary hover:underline font-bold">Forgot Password?</button>
                            </div>
                            <input type="password" name="password" required
                                class="w-full px-4 py-2 border border-gray-200 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all dark:bg-slate-700 dark:text-white">
                        </div>
                        <button type="submit"
                            class="w-full bg-primary hover:bg-blue-800 text-white font-bold py-3 rounded-lg shadow-lg shadow-blue-900/20 transition-all transform active:scale-95">
                            Log In
                        </button>
                    </form>

                    <div class="relative my-6">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-gray-200 dark:border-slate-700"></div>
                        </div>
                        <div class="relative flex justify-center text-sm">
                            <span class="px-2 bg-white dark:bg-slate-800 text-gray-500">Or continue with</span>
                        </div>
                    </div>

                    <a href="/auth/google"
                        class="w-full bg-white dark:bg-slate-700 border border-gray-200 dark:border-slate-600 text-gray-700 dark:text-gray-200 font-bold py-2.5 rounded-lg flex items-center justify-center gap-3 hover:bg-gray-100 dark:hover:bg-slate-600 transition-colors">
                        <img src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-5 h-5" alt="Google">
                        Google
                    </a>

                    <p class="text-center text-sm text-gray-500 mt-6">
                        Don't have an account?
                        <button onclick="switchTab('register')" class="text-primary font-bold hover:underline">Join
                            Now</button>
                    </p>
                </div>

                <!-- Register Form -->
                <div id="view-register" class="hidden animate-fade-in-down">
                    <div class="text-center mb-6">
                        <h3 class="text-2xl font-bold text-dark dark:text-white">Create Account</h3>
                        <p class="text-gray-500 dark:text-gray-400 text-sm">Start your health journey with us. (Gmail
                            Only)</p>
                    </div>

                    <form id="register-form" action="/auth/register" method="POST" class="space-y-3">
                        <div>
                            <label
                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Username</label>
                            <input type="text" name="username" required
                                class="w-full px-4 py-2 border border-gray-200 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all dark:bg-slate-700 dark:text-white">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Email (Gmail
                                Required)</label>
                            <input type="email" name="email" required placeholder="example@gmail.com"
                                class="w-full px-4 py-2 border border-gray-200 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all dark:bg-slate-700 dark:text-white">
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label
                                    class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Password</label>
                                <input type="password" name="password" required
                                    class="w-full px-4 py-2 border border-gray-200 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all dark:bg-slate-700 dark:text-white">
                            </div>
                            <div>
                                <label
                                    class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Confirm</label>
                                <input type="password" name="confirm_password" required
                                    class="w-full px-4 py-2 border border-gray-200 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all dark:bg-slate-700 dark:text-white">
                            </div>
                        </div>
                        <button type="submit"
                            class="w-full bg-primary hover:bg-blue-800 text-white font-bold py-3 rounded-lg shadow-lg shadow-blue-900/20 transition-all transform active:scale-95 mt-2">
                            Create Account
                        </button>
                    </form>

                    <p class="text-center text-sm text-gray-500 mt-4">
                        Already have an account?
                        <button onclick="switchTab('login')" class="text-primary font-bold hover:underline">Log
                            In</button>
                    </p>
                </div>

                <!-- Forgot Password View -->
                <div id="view-forgot-password" class="hidden animate-fade-in-down">
                    <div class="text-center mb-6">
                        <h3 class="text-2xl font-bold text-dark dark:text-white">Reset Password</h3>
                        <p class="text-gray-500 dark:text-gray-400 text-sm">Enter your Gmail and we'll send you a
                            verification code.</p>
                    </div>
                    <form id="forgot-password-form" class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Gmail
                                Address</label>
                            <input type="email" id="reset-email" required placeholder="user@gmail.com"
                                class="w-full px-4 py-2 border border-gray-200 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all dark:bg-slate-700 dark:text-white">
                        </div>
                        <button type="submit" id="forgot-pass-btn"
                            class="w-full bg-primary hover:bg-blue-800 text-white font-bold py-3 rounded-lg shadow-lg transition-all transform active:scale-95">
                            Send Verification Code
                        </button>
                    </form>
                    <button onclick="switchTab('login')"
                        class="w-full mt-4 text-sm text-gray-500 hover:text-dark font-medium font-bold italic underline">Back
                        to Login</button>
                </div>

                <!-- Verify OTP View -->
                <div id="view-verify-otp" class="hidden animate-fade-in-down">
                    <div class="text-center mb-6">
                        <h3 class="text-2xl font-bold text-dark dark:text-white" id="otp-title">Verify Code</h3>
                        <p class="text-gray-500 dark:text-gray-400 text-sm" id="otp-subtitle">Enter the 6-digit code
                            sent to your email.</p>
                    </div>
                    <form id="verify-otp-form" class="space-y-4">
                        <div>
                            <input type="text" id="otp-code" maxlength="6" placeholder="000000"
                                class="w-full text-center tracking-[0.5em] text-2xl font-black px-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all dark:bg-slate-700 dark:text-white">
                        </div>
                        <button type="submit" id="verify-otp-btn"
                            class="w-full bg-primary hover:bg-blue-800 text-white font-bold py-3 rounded-lg shadow-lg transition-all transform active:scale-95">
                            Verify Code
                        </button>
                    </form>
                    <button onclick="handleOtpBack()"
                        class="w-full mt-4 text-sm text-gray-500 hover:text-dark font-medium font-bold italic underline"
                        id="otp-back-btn">Go Back</button>
                </div>

                <!-- Reset Password View -->
                <div id="view-reset-password" class="hidden animate-fade-in-down">
                    <div class="text-center mb-6">
                        <h3 class="text-2xl font-bold text-dark dark:text-white">New Password</h3>
                        <p class="text-gray-500 dark:text-gray-400 text-sm">Create a secure new password for your
                            account.</p>
                    </div>
                    <form id="new-password-form" class="space-y-4">
                        <input type="hidden" id="reset-token-input">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">New
                                Password</label>
                            <input type="password" id="new-password" required minlength="8"
                                class="w-full px-4 py-2 border border-gray-200 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all dark:bg-slate-700 dark:text-white">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Confirm New
                                Password</label>
                            <input type="password" id="confirm-new-password" required minlength="8"
                                class="w-full px-4 py-2 border border-gray-200 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all dark:bg-slate-700 dark:text-white">
                        </div>
                        <button type="submit" id="reset-pw-btn"
                            class="w-full bg-primary hover:bg-blue-800 text-white font-bold py-3 rounded-lg shadow-lg transition-all transform active:scale-95">
                            Update Password
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // --- AUTH FLOW LOGIC ---
    let currentEmail = '';
    let otpMode = 'reset'; // 'reset' or 'verify'
    const gmailRegex = /^[a-zA-Z0-9._%+-]+@gmail\.com$/;

    function handleOtpBack() {
        if (otpMode === 'verify') {
            switchTab('register');
        } else {
            switchTab('forgot-password');
        }
    }

    // 1. Forgot Password Submission
    const forgotForm = document.getElementById('forgot-password-form');
    if (forgotForm) {
        forgotForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('reset-email').value;

            if (!gmailRegex.test(email) && email !== 'admin@hosam.com') {
                showToast('warning', 'Invalid email address. Only Gmail is allowed.');
                return;
            }

            const btn = document.getElementById('forgot-pass-btn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Sending...';

            try {
                const res = await fetch('/auth/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });
                const data = await res.json();

                if (data.success) {
                    currentEmail = email;
                    otpMode = 'reset';
                    document.getElementById('otp-title').innerText = 'Reset Code';
                    document.getElementById('otp-subtitle').innerText = 'Enter the 6-digit code sent to your Gmail.';
                    switchTab('verify-otp');
                } else {
                    showToast('error', data.message || 'Error occurred');
                }
            } catch (err) {
                showToast('error', 'An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerText = 'Send Verification Code';
            }
        });
    }

    // 2. Register Submission
    const registerForm = document.getElementById('register-form');
    if (registerForm) {
        registerForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(registerForm);
            const data = Object.fromEntries(formData.entries());

            if (!gmailRegex.test(data.email)) {
                showToast('warning', 'Invalid email address. Only Gmail is allowed.');
                return;
            }

            const btn = registerForm.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerText = 'Creating account...';

            try {
                const response = await fetch('/auth/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();

                if (result.success) {
                    currentEmail = data.email;
                    otpMode = 'verify';
                    document.getElementById('otp-title').innerText = 'Verify Email';
                    document.getElementById('otp-subtitle').innerText = 'A code has been sent to your Gmail for activation.';
                    switchTab('verify-otp');
                } else {
                    showToast('error', result.message || 'Registration failed');
                }
            } catch (err) {
                showToast('error', 'An error occurred');
            } finally {
                btn.disabled = false;
                btn.innerText = 'Create Account';
            }
        });
    }

    // 3. Verify OTP Submission (Unified)
    const verifyForm = document.getElementById('verify-otp-form');
    if (verifyForm) {
        verifyForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const code = document.getElementById('otp-code').value;
            const btn = document.getElementById('verify-otp-btn');

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Verifying...';

            const endpoint = otpMode === 'verify' ? '/auth/verify-email' : '/auth/verify-reset-code';

            try {
                const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: currentEmail, code })
                });
                const data = await res.json();

                if (data.success) {
                    if (otpMode === 'verify') {
                        showToast('success', 'Email verified successfully! You can now log in.');
                        switchTab('login');
                    } else {
                        document.getElementById('reset-token-input').value = data.resetToken;
                        switchTab('reset-password');
                    }
                } else {
                    showToast('error', data.message || 'Verification failed');
                }
            } catch (err) {
                showToast('error', 'An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerText = 'Verify Code';
            }
        });
    }

    // 4. New Password Submission
    const resetPwForm = document.getElementById('new-password-form');
    if (resetPwForm) {
        resetPwForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const newPassword = document.getElementById('new-password').value;
            const confirmPassword = document.getElementById('confirm-new-password').value;
            const resetToken = document.getElementById('reset-token-input').value;
            const btn = document.getElementById('reset-pw-btn');

            if (newPassword !== confirmPassword) {
                showToast('warning', 'Passwords do not match');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Updating...';

            try {
                const res = await fetch('/auth/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ resetToken, newPassword })
                });
                const data = await res.json();

                if (data.success) {
                    showToast('success', 'Password successfully reset! You can now log in.');
                    switchTab('login');
                } else {
                    showToast('error', data.message || 'Reset failed');
                }
            } catch (err) {
                showToast('error', 'An error occurred. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerText = 'Update Password';
            }
        });
    }

    // --- LOGIN AJAX LOGIC ---
    const loginForm = document.getElementById('login-form');
    if (loginForm) {
        loginForm.addEventListener('submit', async function (e) {
            e.preventDefault();
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            if (!gmailRegex.test(data.email) && data.email !== 'admin@hosam.com') {
                showToast('warning', 'Invalid email address. Only Gmail is allowed.');
                return;
            }

            const btn = this.querySelector('button[type="submit"]');
            const originalText = btn.innerText;
            btn.innerText = 'Logging in...';
            btn.disabled = true;

            try {
                const response = await fetch('/auth/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    window.location.reload();
                } else if (result.unverified) {
                    currentEmail = result.email;
                    otpMode = 'verify';
                    document.getElementById('otp-title').innerText = 'Verify Email';
                    document.getElementById('otp-subtitle').innerText = 'Your account is not activated. Enter the code sent to your Gmail.';
                    switchTab('verify-otp');
                } else {
                    showToast('error', result.message || 'Login failed');
                }
            } catch (err) {
                showToast('error', 'An error occurred');
            } finally {
                btn.innerText = originalText;
                btn.disabled = false;
            }
        });
    }

    // --- AUTH MODAL LOGIC ---
    function openAuthModal(mode = 'login') {
        const modal = document.getElementById('auth-modal');
        const backdrop = document.getElementById('modal-backdrop');
        const panel = document.getElementById('modal-panel');

        modal.classList.remove('hidden');
        backdrop.classList.remove('opacity-0');
        panel.classList.remove('scale-95', 'opacity-0');

        switchTab(mode);
    }

    function switchTab(tab) {
        const views = ['view-login', 'view-register', 'view-forgot-password', 'view-verify-otp', 'view-reset-password'];
        const tabs = document.getElementById('auth-tabs');

        // Hide all views
        views.forEach(v => {
            const el = document.getElementById(v);
            if (el) el.classList.add('hidden');
        });

        // Show targets
        const targetView = document.getElementById(`view-${tab}`);
        if (targetView) targetView.classList.remove('hidden');

        // Manage tab visibility (Join/Login tabs only for those views)
        if (tab === 'login' || tab === 'register') {
            tabs.classList.remove('hidden');
            const tabLogin = document.getElementById('tab-login');
            const tabRegister = document.getElementById('tab-register');

            if (tab === 'login') {
                tabLogin.className = 'flex-1 pb-3 text-sm font-bold text-center border-b-2 border-primary text-primary transition-colors';
                tabRegister.className = 'flex-1 pb-3 text-sm font-bold text-center border-b-2 border-transparent text-gray-400 hover:text-gray-600 transition-colors';
            } else {
                tabRegister.className = 'flex-1 pb-3 text-sm font-bold text-center border-b-2 border-primary text-primary transition-colors';
                tabLogin.className = 'flex-1 pb-3 text-sm font-bold text-center border-b-2 border-transparent text-gray-400 hover:text-gray-600 transition-colors';
            }
        } else {
            tabs.classList.add('hidden');
        }
    }

    function closeAuthModal() {
        const modal = document.getElementById('auth-modal');
        modal.classList.add('hidden');
    }
</script>