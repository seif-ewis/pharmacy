            </section>

            <!-- Auth Modals are included via footer.ejs partial -->

            <!-- ========================================================================= -->
            <!-- START PARTIAL: views/partials/footer.ejs                                  -->
            <!-- ========================================================================= -->

            <%- include('partials/footer') %>

                <!-- Chat Component -->
                <% if (typeof user !=='undefined' && user) { %>
                    <!-- Draggable Waving Chat FAB -->
                    <div id="draggable-chat" class="fixed bottom-8 right-8 z-[100] cursor-move select-none">
                        <button onclick="toggleChatModal()"
                            class="w-16 h-16 bg-primary text-white rounded-full shadow-2xl flex items-center justify-center hover:scale-110 transition-transform group relative overflow-hidden">
                            <div class="absolute inset-0 bg-blue-400/20 animate-ping opacity-20">
                            </div>
                            <i class="fas fa-user-md text-3xl animate-wave origin-bottom"></i>
                            <!-- Notification Badge (Initially Hidden) -->
                            <span id="chat-notification-badge"
                                class="absolute top-0 right-0 w-4 h-4 bg-red-500 rounded-full border-2 border-white transform scale-0 transition-transform duration-300"></span>
                        </button>
                    </div>

                    <!-- Notification Sound -->
                    <audio id="chat-sound-source"
                        src="data:audio/mp3;base64,"></audio>

                    <!-- Chat Modal -->
                    <div id="chat-modal"
                        class="fixed bottom-24 right-8 w-96 max-w-[calc(100vw-2rem)] h-[550px] bg-white dark:bg-slate-900 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.2)] z-[100] flex flex-col hidden overflow-hidden transition-all duration-300 transform scale-95 opacity-0 origin-bottom-right border border-gray-100 dark:border-slate-800">
                        <!-- Header -->
                        <div class="bg-primary p-5 text-white flex justify-between items-center shrink-0">
                            <div class="flex items-center gap-3">
                                <div
                                    class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center backdrop-blur-sm">
                                    <i class="fas fa-user-md"></i>
                                </div>
                                <div>
                                    <p class="font-bold text-sm tracking-tight">
                                        <%= (typeof activeChat !=='undefined' && activeChat &&
                                            activeChat.pharmacist_name) ? activeChat.pharmacist_name :
                                            t('chat_doctor_default') %>
                                    </p>
                                    <p class="text-[10px] text-blue-100/80 flex items-center gap-1 font-medium">
                                        <% if (typeof pharmacySettings !=='undefined' && pharmacySettings.is_open) { %>
                                            <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span>
                                            <%= t('chat_operational') %>
                                                <% } else { %>
                                                    <span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span>
                                                    <%= t('chat_on_call') %>
                                                        <% } %>
                                    </p>
                                </div>
                            </div>
                            <button onclick="toggleChatModal()"
                                class="hover:bg-white/10 w-8 h-8 rounded-full flex items-center justify-center transition-colors">
                                <i class="fas fa-times text-sm"></i>
                            </button>
                        </div>

                        <!-- Messages -->
                        <div class="flex-1 overflow-y-auto p-5 space-y-4 bg-gray-50 dark:bg-slate-950/50 relative custom-scrollbar scroll-smooth"
                            id="chat-messages">
                            <div class="flex gap-3">
                                <div
                                    class="w-8 h-8 bg-primary/10 dark:bg-blue-500/20 rounded-full flex items-center justify-center text-primary dark:text-blue-400 shrink-0 self-end">
                                    <i class="fas fa-user-md text-xs"></i>
                                </div>
                                <div
                                    class="bg-white dark:bg-slate-800 p-4 rounded-2xl rounded-bl-none shadow-sm text-sm text-gray-700 dark:text-gray-200 max-w-[85%] border border-gray-100 dark:border-slate-700/50">
                                    <%= t('chat_welcome_msg_start') %>
                                        <%= user.full_name %>
                                            <%= t('chat_welcome_msg_end') %>
                                </div>
                            </div>

                            <!-- Typing Indicator (Hidden) -->
                            <div id="typing-indicator" class="hidden flex gap-3 animate-pulse pb-2">
                                <div
                                    class="w-8 h-8 bg-primary/5 rounded-full flex items-center justify-center text-primary/40 shrink-0 self-end">
                                    <i class="fas fa-user-md text-xs"></i>
                                </div>
                                <div
                                    class="bg-white dark:bg-slate-800 p-3 rounded-2xl rounded-bl-none shadow-sm text-[10px] text-gray-400 dark:text-gray-500 flex items-center gap-1 italic">
                                    <%= t('chat_typing') %> <span class="flex gap-0.5 items-center ml-1"><span
                                                class="w-1 h-1 bg-current rounded-full animate-bounce"></span><span
                                                class="w-1 h-1 bg-current rounded-full animate-bounce [animation-delay:0.2s]"></span><span
                                                class="w-1 h-1 bg-current rounded-full animate-bounce [animation-delay:0.4s]"></span></span>
                                </div>
                            </div>
                        </div>

                        <!-- Input Area -->
                        <div
                            class="p-5 bg-white dark:bg-slate-900 border-t border-gray-100 dark:border-slate-800 flex gap-3 items-center shrink-0">
                            <div class="flex-1 relative">
                                <input type="text" id="chat-input" placeholder="<%= t('chat_placeholder') %>"
                                    class="w-full bg-gray-50 dark:bg-slate-800 border-none rounded-2xl px-5 py-3 text-sm focus:ring-2 focus:ring-primary outline-none transition-all dark:text-white dark:placeholder-gray-500 shadow-inner"
                                    onkeypress="if(event.key === 'Enter') sendMessage()">
                            </div>
                            <button onclick="sendMessage()"
                                class="w-12 h-12 bg-primary text-white rounded-2xl flex items-center justify-center hover:bg-blue-800 hover:scale-105 active:scale-95 transition-all shadow-lg shadow-primary/20">
                                <i class="fas fa-paper-plane size-5"></i>
                            </button>
                        </div>
                    </div>


                    <script>
                        // Use the global socket instance initialized in footer if user is logged in
                        const chatSocket = socket;
                        const chatMessagesDiv = document.getElementById('chat-messages');
                        const chatInput = document.getElementById('chat-input');
                        const typingIndicator = document.getElementById('typing-indicator');
                        const chatSound = document.getElementById('chat-sound-source');
                        const notificationBadge = document.getElementById('chat-notification-badge');

                        // Pre-populate chat history if available
                        <% if (typeof chatMessages !== 'undefined' && chatMessages.length > 0) { %>
                            <% chatMessages.forEach(function (msg) { %>
                            appendMessage(<% - JSON.stringify(msg.message) %>, "<%= (msg.sender_id === user.id) ? 'me' : 'other' %>");
                            <% }); %>
                        <% } %>

                            let typingTimeout;

                        chatInput.addEventListener('input', () => {
                            chatSocket.emit('typing');
                            clearTimeout(typingTimeout);
                            typingTimeout = setTimeout(() => {
                                chatSocket.emit('stop typing');
                            }, 2000);
                        });

                        function sendMessage() {
                            const msg = chatInput.value;
                            if (msg.trim()) {
                                chatSocket.emit('chat message', msg);
                                chatSocket.emit('stop typing');
                                appendMessage(msg, 'me');
                                chatInput.value = '';
                            }
                        }

                        // Incoming messages
                        chatSocket.on('chat:message', function (msg) {
                            const modal = document.getElementById('chat-modal');

                            // Always append the message so it's there when opened
                            if (msg.message) {
                                appendMessage(msg.message, 'other');
                            }

                            // If modal is hidden, show notification
                            if (modal.classList.contains('hidden')) {
                                // Play sound
                                if (chatSound) {
                                    chatSound.currentTime = 0;
                                    chatSound.play().catch(e => { });
                                }
                                // Show red dot
                                if (notificationBadge) {
                                    notificationBadge.classList.remove('scale-0');
                                    notificationBadge.classList.add('scale-100');
                                    notificationBadge.classList.add('animate-pulse');
                                }
                            }
                        });

                        // Typing states from doctor (simulated for now)
                        chatSocket.on('doctor typing', () => {
                            typingIndicator.classList.remove('hidden');
                            chatMessagesDiv.scrollTop = chatMessagesDiv.scrollHeight;
                        });

                        chatSocket.on('doctor stop typing', () => {
                            typingIndicator.classList.add('hidden');
                        });

                        function toggleChatModal() {
                            const modal = document.getElementById('chat-modal');
                            if (modal.classList.contains('hidden')) {
                                modal.classList.remove('hidden');
                                // Hide badge when opening
                                if (notificationBadge) {
                                    notificationBadge.classList.remove('scale-100', 'animate-pulse');
                                    notificationBadge.classList.add('scale-0');
                                }
                                setTimeout(() => {
                                    modal.classList.remove('scale-95', 'opacity-0');
                                    modal.classList.add('scale-100', 'opacity-100');
                                    // Scroll to bottom
                                    chatMessagesDiv.scrollTop = chatMessagesDiv.scrollHeight;
                                }, 10);
                            } else {
                                modal.classList.remove('scale-100', 'opacity-100');
                                modal.classList.add('scale-95', 'opacity-0');
                                setTimeout(() => {
                                    modal.classList.add('hidden');
                                }, 300);
                            }
                        }

                        function appendMessage(text, sender) {
                            const div = document.createElement('div');
                            div.className = 'flex gap-3 ' + (sender === 'me' ? 'flex-row-reverse' : '') + ' animate-in fade-in slide-in-from-bottom-2 duration-300';
                            const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                            if (sender === 'me') {
                                div.innerHTML = `
                                    <div class="w-8 h-8 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center text-blue-600 dark:text-blue-400 shrink-0 self-end">
                                        <i class="fas fa-user text-xs"></i>
                                    </div>
                                    <div class="bg-primary text-white p-4 rounded-2xl rounded-br-none shadow-md text-sm max-w-[85%]">
                                        <p class="leading-relaxed font-medium">${text}</p>
                                        <p class="text-[9px] mt-2 opacity-70 text-right">${time}</p>
                                    </div>
                                `;
                            } else {
                                div.innerHTML = `
                                    <div class="w-8 h-8 bg-primary/10 dark:bg-blue-500/20 rounded-full flex items-center justify-center text-primary dark:text-blue-400 shrink-0 self-end">
                                        <i class="fas fa-user-md text-xs"></i>
                                    </div>
                                    <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl rounded-bl-none shadow-sm text-sm text-gray-700 dark:text-gray-200 max-w-[85%] border border-gray-100 dark:border-slate-700/50">
                                        <p class="leading-relaxed">${text}</p>
                                        <p class="text-[9px] mt-2 text-gray-400 dark:text-gray-500">${time}</p>
                                    </div>
                                `;
                            }
                            // Insert before typing indicator
                            chatMessagesDiv.insertBefore(div, typingIndicator);
                            chatMessagesDiv.scrollTop = chatMessagesDiv.scrollHeight;
                        }
                    </script>
                    <% } %>

                        <!-- ========================================================================= -->
                        <!-- END PARTIAL: views/partials/footer.ejs                                    -->
                        <!-- ========================================================================= -->


                        <!-- Interactive Scripts & Anime.js Logic -->
                        <script>
                            // --- 1. SESSION / CART LOGIC ---
                            let cart = JSON.parse(sessionStorage.getItem('guestCart')) || [];

                            function updateCartUI() {
                                if (window.updateCartCount) window.updateCartCount();
                            }

                            function addToCart(id, name, price, stock = 9999) {
                                // Re-fetch cart state to ensure it's up to date (e.g. after deletion)
                                cart = JSON.parse(sessionStorage.getItem('guestCart')) || [];
                                const qty = 1; // Default to 1 from home page

                                const existingItem = cart.find(item => item.id === id);
                                const currentQty = existingItem ? (existingItem.qty || 1) : 0;

                                if (currentQty + qty > stock) {
                                    showToast('warning', `Sorry, we only have ${stock} items left in stock.`);
                                    return;
                                }

                                if (existingItem) {
                                    existingItem.qty = (existingItem.qty || 1) + 1;
                                } else {
                                    cart.push({ id, name, price, qty: 1, maxStock: stock });
                                }
                                sessionStorage.setItem('guestCart', JSON.stringify(cart));
                                updateCartUI();

                                // Dispatch for header update
                                window.dispatchEvent(new Event('storage'));


                            }



                            // --- 4. CAROUSEL LOGIC ---
                            const intervals = {};

                            function scrollCarousel(id, direction) {
                                const el = document.getElementById(id);
                                if (!el) return;
                                const scrollAmount = window.innerWidth > 768 ? 400 : 300;

                                el.scrollBy({
                                    left: direction * scrollAmount,
                                    behavior: 'smooth'
                                });
                            }

                            function startAutoScroll(id) {
                                if (intervals[id]) clearInterval(intervals[id]);
                                intervals[id] = setInterval(() => {
                                    scrollCarousel(id, 1);
                                }, 3500);
                            }

                            function stopAutoScroll(id) {
                                if (intervals[id]) clearInterval(intervals[id]);
                            }

                            function initCarousel(id) {
                                const el = document.getElementById(id);
                                if (!el) return;
                                el.addEventListener('mouseenter', () => stopAutoScroll(id));
                                el.addEventListener('mouseleave', () => startAutoScroll(id));
                                startAutoScroll(id);
                            }
                            document.addEventListener('DOMContentLoaded', () => {
                                updateCartUI();

                                const heroTimeline = anime.timeline({ easing: 'easeOutExpo', duration: 1000 });

                                // Ensure targets are set to 0 initially in JS to avoid screen flicker or non-reveal if JS fails early
                                anime.set('.hero-content, .hero-image', { opacity: 0 });

                                heroTimeline
                                    .add({ targets: '.hero-content', opacity: [0, 1], translateY: [50, 0], delay: 200 })
                                    .add({ targets: '.hero-image', opacity: [0, 1], translateX: [50, 0] }, '-=800')
                                    .add({ targets: '.cta-btn', scale: [0.9, 1], opacity: [0, 1], delay: anime.stagger(100) }, '-=600')
                                    .add({ targets: '.float-card', translateY: [20, 0], opacity: [0, 1] }, '-=800');

                                const observer = new IntersectionObserver((entries) => {
                                    entries.forEach(entry => {
                                        if (entry.isIntersecting) {
                                            anime({
                                                targets: '.med-card',
                                                opacity: [0, 1],
                                                translateY: [30, 0],
                                                delay: anime.stagger(100),
                                                easing: 'easeOutQuad'
                                            });
                                            observer.unobserve(entry.target);
                                        }
                                    });
                                }, { threshold: 0.1 });

                                ['medicine-carousel', 'essentials-carousel', 'wellness-carousel', 'services-carousel'].forEach(id => {
                                    const el = document.getElementById(id);
                                    if (el) {
                                        observer.observe(el);
                                        initCarousel(id);
                                    }
                                });

                                const addButtons = document.querySelectorAll('.add-btn');
                                addButtons.forEach(btn => {
                                    btn.addEventListener('mouseenter', () => anime({ targets: btn, rotate: '90deg', duration: 300 }));
                                    btn.addEventListener('mouseleave', () => anime({ targets: btn, rotate: '0deg', duration: 300 }));
                                });

                                // --- 6. DRAGGABLE CHAT LOGIC ---
                                const draggableChat = document.getElementById('draggable-chat');
                                if (draggableChat) {
                                    let isDragging = false;
                                    let offset = { x: 0, y: 0 };

                                    draggableChat.addEventListener('mousedown', (e) => {
                                        isDragging = true;
                                        offset = {
                                            x: draggableChat.offsetLeft - e.clientX,
                                            y: draggableChat.offsetTop - e.clientY
                                        };
                                        draggableChat.style.transition = 'none';
                                    });

                                    document.addEventListener('mousemove', (e) => {
                                        if (!isDragging) return;
                                        draggableChat.style.left = (e.clientX + offset.x) + 'px';
                                        draggableChat.style.top = (e.clientY + offset.y) + 'px';
                                        draggableChat.style.right = 'auto';
                                        draggableChat.style.bottom = 'auto';
                                    });

                                    document.addEventListener('mouseup', () => {
                                        isDragging = false;
                                        draggableChat.style.transition = 'all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
                                    });

                                    // Touch support
                                    draggableChat.addEventListener('touchstart', (e) => {
                                        isDragging = true;
                                        const touch = e.touches[0];
                                        offset = {
                                            x: draggableChat.offsetLeft - touch.clientX,
                                            y: draggableChat.offsetTop - touch.clientY
                                        };
                                        draggableChat.style.transition = 'none';
                                    });

                                    document.addEventListener('touchmove', (e) => {
                                        if (!isDragging) return;
                                        const touch = e.touches[0];
                                        draggableChat.style.left = (touch.clientX + offset.x) + 'px';
                                        draggableChat.style.top = (touch.clientY + offset.y) + 'px';
                                        draggableChat.style.right = 'auto';
                                        draggableChat.style.bottom = 'auto';
                                    });

                                    document.addEventListener('touchend', () => isDragging = false);
                                }

                                // --- 7. AUTH AUTO-OPEN ON MESSAGE ---
                                const hasAuthError = "<%= (locals.error && error.length > 0) ? 'true' : 'false' %>" === "true";
                                const hasAuthSuccess = "<%= (locals.success && success.length > 0) ? 'true' : 'false' %>" === "true";
                                const isUserLoggedIn = "<%= (locals.user) ? 'true' : 'false' %>" === "true";

                                if (!isUserLoggedIn && (hasAuthError || hasAuthSuccess)) {
                                    window.addEventListener('load', () => {
                                        setTimeout(() => {
                                            if (typeof openAuthModal === 'function') {
                                                openAuthModal('login');
                                            }
                                        }, 500);
                                    });
                                }
                            });
                        </script>
    </body>

</html>

<!-- ISOLATED AUTH CHECK SCRIPT -->
<script>
    (function () {
        try {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('openLogin') === 'true') {

                // Backup: Save returnTo from URL if present (still useful for initial load)
                const returnTo = urlParams.get('returnTo');
                if (returnTo) {
                    // We'll keep this simple storage for now as a passive backup, 
                    // but NOT injection.
                    sessionStorage.setItem('authReturnTo', returnTo);
                }

                // Wait for DOM to be ready, independent of other listeners
                if (document.readyState === 'complete' || document.readyState === 'interactive') {
                    openAuthModalSafe();
                } else {
                    document.addEventListener('DOMContentLoaded', openAuthModalSafe);
                }
            }

            function openAuthModalSafe() {
                setTimeout(() => {
                    if (typeof openAuthModal === 'function') {
                        openAuthModal('login');
                    } else {
                        console.warn('Auth modal function not found');
                    }
                }, 800);
            }
        } catch (e) {
            console.error('Safe Auth Check Error:', e);
        }
    })();
</script>