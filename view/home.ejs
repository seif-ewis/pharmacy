                                class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 rounded-full border-2 border-white flex items-center justify-center text-[10px] font-bold">1</span>
                        </button>
                    </div>

                    <!-- Chat Modal -->
                    <div id="chat-modal"
                        class="fixed bottom-24 right-8 w-96 max-w-[calc(100vw-2rem)] h-[500px] bg-white rounded-2xl shadow-2xl z-[100] flex flex-col hidden overflow-hidden transition-all duration-300 transform scale-95 opacity-0 origin-bottom-right border border-gray-100">
                        <!-- Header -->
                        <div class="bg-primary p-4 text-white flex justify-between items-center shrink-0">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
                                    <i class="fas fa-user-md"></i>
                                </div>
                                <div>
                                    <p class="font-bold text-sm">
                                        <%= (typeof activeChat !=='undefined' && activeChat &&
                                            activeChat.pharmacist_name) ? activeChat.pharmacist_name : 'Pharmacy Doctor'
                                            %>
                                    </p>
                                    <p class="text-[10px] text-blue-100 flex items-center gap-1">
                                        <% if (typeof pharmacySettings !=='undefined' && pharmacySettings.is_open) { %>
                                            <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span>
                                            Online
                                            <% } else { %>
                                                <span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span> Offline
                                                <% } %>
                                    </p>
                                </div>
                            </div>
                            <button onclick="toggleChatModal()"
                                class="hover:bg-white/10 p-2 rounded-lg transition-colors">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>

                        <!-- Messages -->
                        <div class="flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50 relative" id="chat-messages">
                            <div class="flex gap-2">
                                <div
                                    class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center text-primary shrink-0 self-end">
                                    <i class="fas fa-user-md text-xs"></i>
                                </div>
                                <div
                                    class="bg-white p-3 rounded-2xl rounded-bl-none shadow-sm text-sm text-gray-700 max-w-[80%]">
                                    Hello <%= user.full_name %>! I'm here to help with your health queries.
                                </div>
                            </div>

                            <!-- Typing Indicator (Hidden) -->
                            <div id="typing-indicator" class="hidden flex gap-2 animate-pulse mb-4">
                                <div
                                    class="w-8 h-8 bg-primary/5 rounded-full flex items-center justify-center text-primary/40 shrink-0 self-end">
                                    <i class="fas fa-user-md text-xs"></i>
                                </div>
                                <div
                                    class="bg-white p-3 rounded-2xl rounded-bl-none shadow-sm text-[10px] text-gray-400">
                                    <span class="font-bold">Doctor</span> is typing...
                                </div>
                            </div>
                        </div>

                        <!-- Input -->
                        <div class="p-4 bg-white border-t border-gray-100 flex gap-2 items-center shrink-0">
                            <input type="text" id="chat-input" placeholder="Type your message..."
                                class="flex-1 bg-gray-50 border-none rounded-full px-4 py-2 text-sm focus:ring-2 focus:ring-primary outline-none transition-all"
                                onkeypress="if(event.key === 'Enter') sendMessage()">
                            <button onclick="sendMessage()"
                                class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center hover:bg-blue-800 transition-colors shadow-lg">
                                <i class="fas fa-paper-plane size-4"></i>
                            </button>
                        </div>
                    </div>

                    <script>
                        // Use the global socket instance initialized in footer if user is logged in
                        const chatSocket = socket;
                        const chatMessagesDiv = document.getElementById('chat-messages');
                        const chatInput = document.getElementById('chat-input');
                        const typingIndicator = document.getElementById('typing-indicator');

                        // Pre-populate chat history if available
                        <% if (typeof chatMessages !== 'undefined' && chatMessages.length > 0) { %>
                            <% chatMessages.forEach(function (msg) { %>
                            appendMessage("<%= msg.message %>", "<%= (msg.sender_id === user.id) ? 'me' : 'other' %>");
                            <% }); %>
                        <% } %>

                            let typingTimeout;

                        chatInput.addEventListener('input', () => {
                            chatSocket.emit('typing');
                            clearTimeout(typingTimeout);
                            typingTimeout = setTimeout(() => {
                                chatSocket.emit('stop typing');
                            }, 2000);
                        });

                        function sendMessage() {
                            const msg = chatInput.value;
                            if (msg.trim()) {
                                chatSocket.emit('chat message', msg);
                                chatSocket.emit('stop typing');
                                appendMessage(msg, 'me');
                                chatInput.value = '';
                            }
                        }

                        // Incoming messages
                        chatSocket.on('chat message', function (msg) {
                            appendMessage(msg, 'other');
                        });

                        // Typing states from doctor (simulated for now)
                        chatSocket.on('doctor typing', () => {
                            typingIndicator.classList.remove('hidden');
                            chatMessagesDiv.scrollTop = chatMessagesDiv.scrollHeight;
                        });

                        chatSocket.on('doctor stop typing', () => {
                            typingIndicator.classList.add('hidden');
                        });

                        function appendMessage(text, sender) {
                            const div = document.createElement('div');
                            div.className = 'flex gap-2 ' + (sender === 'me' ? 'flex-row-reverse' : '');

                            if (sender === 'me') {
                                div.innerHTML = `
                                    <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 shrink-0">
                                        <i class="fas fa-user text-xs"></i>
                                    </div>
                                    <div class="bg-primary text-white p-3 rounded-2xl rounded-br-none shadow-sm text-sm max-w-[80%]">
                                        ${text}
                                    </div>
                                `;
                            } else {
                                div.innerHTML = `
                                    <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center text-primary shrink-0 self-end">
                                        <i class="fas fa-user-md text-xs"></i>
                                    </div>
                                    <div class="bg-white p-3 rounded-2xl rounded-bl-none shadow-sm text-sm text-gray-700 max-w-[80%]">
                                        ${text}
                                    </div>
                                `;
                            }
                            // Insert before typing indicator
                            chatMessagesDiv.insertBefore(div, typingIndicator);
                            chatMessagesDiv.scrollTop = chatMessagesDiv.scrollHeight;
                        }
                    </script>
                    <% } %>

                        <!-- ========================================================================= -->
                        <!-- END PARTIAL: views/partials/footer.ejs                                    -->
                        <!-- ========================================================================= -->


                        <!-- Interactive Scripts & Anime.js Logic -->
                        <script>
                            // --- 1. SESSION / CART LOGIC ---
                            let cart = JSON.parse(sessionStorage.getItem('guestCart')) || [];

                            function updateCartUI() {
                                const count = cart.length;
                                const badge = document.getElementById('header-cart-count');
                                if (badge) {
                                    badge.innerText = count;
                                    anime({
                                        targets: badge,
                                        scale: [1, 1.5, 1],
                                        duration: 400,
                                        easing: 'easeOutElastic(1, .8)'
                                    });
                                }
                            }

                            function addToCart(id, name, price) {
                                const existingItem = cart.find(item => item.id === id);
                                if (existingItem) {
                                    existingItem.qty = (existingItem.qty || 1) + 1;
                                } else {
                                    cart.push({ id, name, price, qty: 1 });
                                }
                                sessionStorage.setItem('guestCart', JSON.stringify(cart));
                                updateCartUI();
                                console.log(`Added ${name} to cart`);
                            }

                            // --- LOGIN AJAX LOGIC (Restored) ---
                            const loginForm = document.getElementById('login-form');
                            if (loginForm) {
                                loginForm.addEventListener('submit', async function (e) {
                                    e.preventDefault();
                                    const formData = new FormData(this);
                                    const data = Object.fromEntries(formData.entries());

                                    // Show loading state
                                    const btn = this.querySelector('button[type="submit"]');
                                    const originalText = btn.innerText;
                                    btn.innerText = 'Logging in...';
                                    btn.disabled = true;

                                    try {
                                        const response = await fetch('/auth/login', {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/json',
                                                'Accept': 'application/json'
                                            },
                                            body: JSON.stringify(data)
                                        });

                                        const result = await response.json();

                                        if (result.success) {
                                            // Check persistent intent (sessionStorage)
                                            const storedReturnTo = sessionStorage.getItem('authReturnTo');

                                            if (window.loginIntent === 'checkout') {
                                                window.location.href = '/checkout';
                                            } else if (result.redirectUrl && result.redirectUrl !== '/') {
                                                // Server has a valid memory
                                                window.location.href = result.redirectUrl;
                                            } else if (storedReturnTo) {
                                                // Fallback: Use client-side memory
                                                sessionStorage.removeItem('authReturnTo');
                                                window.location.href = storedReturnTo;
                                            } else {
                                                window.location.reload();
                                            }
                                        } else {
                                            alert(result.message || 'Login failed');
                                            btn.innerText = originalText;
                                            btn.disabled = false;
                                        }
                                    } catch (err) {
                                        console.error(err);
                                        alert('An error occurred');
                                        btn.innerText = originalText;
                                        btn.disabled = false;
                                    }
                                });
                            }

                            // --- 2. AUTH MODAL LOGIC ---
                            function openAuthModal(mode = 'login') {
                                const modal = document.getElementById('auth-modal');
                                const backdrop = document.getElementById('modal-backdrop');
                                const panel = document.getElementById('modal-panel');

                                modal.classList.remove('hidden');

                                // Reset anime.js inline styles
                                backdrop.style.opacity = '';
                                panel.style.opacity = '';
                                panel.style.transform = '';

                                // Force reflow
                                void modal.offsetWidth;

                                backdrop.classList.remove('opacity-0');
                                panel.classList.remove('scale-95', 'opacity-0');

                                switchTab(mode);
                            }

                            function switchTab(tab) {
                                const viewLogin = document.getElementById('view-login');
                                const viewRegister = document.getElementById('view-register');
                                const tabLogin = document.getElementById('tab-login');
                                const tabRegister = document.getElementById('tab-register');

                                if (tab === 'login') {
                                    viewLogin.classList.remove('hidden');
                                    viewRegister.classList.add('hidden');

                                    tabLogin.classList.add('border-primary', 'text-primary');
                                    tabLogin.classList.remove('border-transparent', 'text-gray-400');

                                    tabRegister.classList.remove('border-primary', 'text-primary');
                                    tabRegister.classList.add('border-transparent', 'text-gray-400');
                                } else {
                                    viewRegister.classList.remove('hidden');
                                    viewLogin.classList.add('hidden');

                                    tabRegister.classList.add('border-primary', 'text-primary');
                                    tabRegister.classList.remove('border-transparent', 'text-gray-400');

                                    tabLogin.classList.remove('border-primary', 'text-primary');
                                    tabLogin.classList.add('border-transparent', 'text-gray-400');
                                }
                            }

                            function closeAuthModal() {
                                const modal = document.getElementById('auth-modal');
                                const backdrop = document.getElementById('modal-backdrop');
                                const panel = document.getElementById('modal-panel');
                                anime({ targets: backdrop, opacity: 0, duration: 200, easing: 'linear' });
                                anime({
                                    targets: panel,
                                    opacity: 0,
                                    scale: 0.9,
                                    duration: 200,
                                    easing: 'easeInQuad',
                                    complete: () => modal.classList.add('hidden')
                                });
                            }



                            // --- 3. CHAT MODAL LOGIC ---
                            function toggleChatModal() {
                                const modal = document.getElementById('chat-modal');
                                if (!modal) return;

                                if (modal.classList.contains('hidden')) {
                                    modal.classList.remove('hidden');
                                    setTimeout(() => {
                                        modal.classList.remove('scale-95', 'opacity-0');
                                        modal.classList.add('scale-100', 'opacity-100');
                                    }, 10);
                                } else {
                                    modal.classList.remove('scale-100', 'opacity-100');
                                    modal.classList.add('scale-95', 'opacity-0');
                                    setTimeout(() => modal.classList.add('hidden'), 300);
                                }
                            }

                            // --- 4. CAROUSEL LOGIC ---
                            const carousels = {};
                            const intervals = {};

                            function scrollCarousel(id, direction) {
                                const el = document.getElementById(id);
                                if (!el) return;
                                const scrollAmount = window.innerWidth > 768 ? 400 : 300;

                                el.scrollBy({
                                    left: direction * scrollAmount,
                                    behavior: 'smooth'
                                });

                                // Seamless loop check
                                if (direction > 0 && el.scrollLeft + el.clientWidth >= el.scrollWidth - 50) {
                                    setTimeout(() => {
                                        el.scrollTo({ left: 0, behavior: 'smooth' });
                                    }, 500);
                                }
                            }

                            function startAutoScroll(id) {
                                if (intervals[id]) clearInterval(intervals[id]);
                                intervals[id] = setInterval(() => {
                                    scrollCarousel(id, 1);
                                }, 2500);
                            }

                            function stopAutoScroll(id) {
                                if (intervals[id]) clearInterval(intervals[id]);
                            }

                            function initCarousel(id) {
                                const el = document.getElementById(id);
                                if (!el) return;
                                el.addEventListener('mouseenter', () => stopAutoScroll(id));
                                el.addEventListener('mouseleave', () => startAutoScroll(id));
                                startAutoScroll(id);
                            }


                            // --- 5. ANIMATIONS (Anime.js) ---
                            document.addEventListener('DOMContentLoaded', () => {
                                updateCartUI();

                                const heroTimeline = anime.timeline({ easing: 'easeOutExpo', duration: 1000 });
                                heroTimeline
                                    .add({ targets: '.hero-content', opacity: [0, 1], translateY: [50, 0], delay: 200 })
                                    .add({ targets: '.hero-image', opacity: [0, 1], translateX: [50, 0] }, '-=800')
                                    .add({ targets: '.cta-btn', scale: [0.9, 1], opacity: [0, 1], delay: anime.stagger(100) }, '-=600')
                                    .add({ targets: '.float-card', translateY: [20, 0], opacity: [0, 1] }, '-=800');

                                const observer = new IntersectionObserver((entries) => {
                                    entries.forEach(entry => {
                                        if (entry.isIntersecting) {
                                            anime({
                                                targets: '.med-card',
                                                opacity: [0, 1],
                                                translateY: [30, 0],
                                                delay: anime.stagger(100),
                                                easing: 'easeOutQuad'
                                            });
                                            observer.unobserve(entry.target);
                                        }
                                    });
                                }, { threshold: 0.1 });

                                ['medicine-carousel', 'essentials-carousel', 'wellness-carousel', 'services-carousel'].forEach(id => {
                                    const el = document.getElementById(id);
                                    if (el) {
                                        observer.observe(el);
                                        initCarousel(id);
                                    }
                                });

                                const addButtons = document.querySelectorAll('.add-btn');
                                addButtons.forEach(btn => {
                                    btn.addEventListener('mouseenter', () => anime({ targets: btn, rotate: '90deg', duration: 300 }));
                                    btn.addEventListener('mouseleave', () => anime({ targets: btn, rotate: '0deg', duration: 300 }));
                                });

                                // --- 6. DRAGGABLE CHAT LOGIC ---
                                const draggableChat = document.getElementById('draggable-chat');
                                if (draggableChat) {
                                    let isDragging = false;
                                    let offset = { x: 0, y: 0 };

                                    draggableChat.addEventListener('mousedown', (e) => {
                                        isDragging = true;
                                        offset = {
                                            x: draggableChat.offsetLeft - e.clientX,
                                            y: draggableChat.offsetTop - e.clientY
                                        };
                                        draggableChat.style.transition = 'none';
                                    });

                                    document.addEventListener('mousemove', (e) => {
                                        if (!isDragging) return;
                                        draggableChat.style.left = (e.clientX + offset.x) + 'px';
                                        draggableChat.style.top = (e.clientY + offset.y) + 'px';
                                        draggableChat.style.right = 'auto';
                                        draggableChat.style.bottom = 'auto';
                                    });

                                    document.addEventListener('mouseup', () => {
                                        isDragging = false;
                                        draggableChat.style.transition = 'all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
                                    });

                                    // Touch support
                                    draggableChat.addEventListener('touchstart', (e) => {
                                        isDragging = true;
                                        const touch = e.touches[0];
                                        offset = {
                                            x: draggableChat.offsetLeft - touch.clientX,
                                            y: draggableChat.offsetTop - touch.clientY
                                        };
                                        draggableChat.style.transition = 'none';
                                    });

                                    document.addEventListener('touchmove', (e) => {
                                        if (!isDragging) return;
                                        const touch = e.touches[0];
                                        draggableChat.style.left = (touch.clientX + offset.x) + 'px';
                                        draggableChat.style.top = (touch.clientY + offset.y) + 'px';
                                        draggableChat.style.right = 'auto';
                                        draggableChat.style.bottom = 'auto';
                                    });

                                    document.addEventListener('touchend', () => isDragging = false);
                                }

                                // --- 7. AUTH AUTO-OPEN ON MESSAGE ---
                                const hasAuthError = "<%= (locals.error && error.length > 0) ? 'true' : 'false' %>" === "true";
                                const hasAuthSuccess = "<%= (locals.success && success.length > 0) ? 'true' : 'false' %>" === "true";
                                const isUserLoggedIn = "<%= (locals.user) ? 'true' : 'false' %>" === "true";

                                if (!isUserLoggedIn && (hasAuthError || hasAuthSuccess)) {
                                    window.addEventListener('load', () => {
                                        setTimeout(() => {
                                            if (typeof openAuthModal === 'function') {
                                                openAuthModal('login');
                                            }
                                        }, 500);
                                    });
                                }
                            });
                        </script>
    </body>

</html>

<!-- ISOLATED AUTH CHECK SCRIPT -->
<script>
    (function () {
        try {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('openLogin') === 'true') {

                // Backup: Save returnTo from URL if present (still useful for initial load)
                const returnTo = urlParams.get('returnTo');
                if (returnTo) {
                    // We'll keep this simple storage for now as a passive backup, 
                    // but NOT injection.
                    sessionStorage.setItem('authReturnTo', returnTo);
                }

                // Wait for DOM to be ready, independent of other listeners
                if (document.readyState === 'complete' || document.readyState === 'interactive') {
                    openAuthModalSafe();
                } else {
                    document.addEventListener('DOMContentLoaded', openAuthModalSafe);
                }
            }

            function openAuthModalSafe() {
                setTimeout(() => {
                    if (typeof openAuthModal === 'function') {
                        openAuthModal('login');
                    } else {
                        console.warn('Auth modal function not found');
                    }
                }, 800);
            }
        } catch (e) {
            console.error('Safe Auth Check Error:', e);
        }
    })();
</script>