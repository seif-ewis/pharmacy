<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<%- include('partials/head') %>

    <body class="bg-bg text-dark font-sans antialiased overflow-x-hidden">

        <%- include('partials/header.ejs') %>

            <!-- Hero Section -->
            <section class="relative bg-white dark:bg-night overflow-hidden pt-10 transition-colors duration-300">
                <!-- Modern Promo Pill -->
                <!-- Modern Promo Pill with Star Light Glow -->
                <div class="flex justify-center mb-8 px-4 translate-y-4 opacity-0 animate-fade-in-down relative z-10">
                    <!-- Back Star Light / Glow Effect -->
                    <div
                        class="absolute -inset-1 bg-gradient-to-r from-blue-400 to-teal-400 rounded-full blur opacity-20 dark:opacity-40 animate-pulse group-hover:opacity-60 transition duration-1000 group-hover:duration-200">
                    </div>

                    <div onclick="navigator.clipboard.writeText('WELCOME20'); const el=this.querySelector('.coupon-text'); const original=el.innerText; el.innerText='COPIED!'; setTimeout(()=>el.innerText=original, 1500);"
                        class="glass dark:bg-slate-800/90 dark:border-slate-600/50 py-2 px-6 rounded-full inline-flex items-center gap-3 border-blue-100/50 shadow-sm relative cursor-pointer hover:shadow-md dark:shadow-blue-900/20 transition-all group">
                        <span class="flex h-2 w-2 relative">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-secondary"></span>
                        </span>
                        <p class="text-[13px] font-bold text-gray-600 dark:text-gray-200">
                            Flash Sale: <span class="text-primary dark:text-blue-300 tracking-tight">20% OFF</span> your
                            first order
                        </p>
                        <div class="h-4 w-[1px] bg-gray-200 dark:bg-slate-600"></div>
                        <p
                            class="coupon-text text-[13px] font-mono font-bold text-secondary dark:text-teal-400 tracking-widest group-hover:text-primary dark:group-hover:text-white transition-colors">
                            WELCOME20</p>
                        <i
                            class="fas fa-copy text-[10px] text-gray-300 dark:text-gray-500 group-hover:text-primary transition-colors ml-1"></i>
                    </div>
                </div>
                <div class="container mx-auto px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
                    <div class="lg:grid lg:grid-cols-12 lg:gap-8 items-center">

                        <!-- Text Content -->
                        <div
                            class="sm:text-center md:max-w-2xl md:mx-auto lg:col-span-6 lg:text-left hero-content opacity-0">


                            <h1
                                class="text-4xl tracking-tight font-extrabold text-dark dark:text-white sm:text-5xl md:text-6xl">
                                <span class="block">Your Health,</span>
                                <span class="block text-primary dark:text-blue-400">Our Priority.</span>
                            </h1>
                            <p
                                class="mt-4 text-lg text-gray-500 dark:text-gray-400 sm:mt-5 sm:max-w-xl sm:mx-auto md:mt-5 md:text-xl lg:mx-0">
                                Order medicines from the comfort of your home. Genuine products, rapid delivery, and
                                expert
                                care.
                            </p>
                            <div class="mt-8 sm:max-w-lg sm:mx-auto sm:text-center lg:text-left lg:mx-0">
                                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                                    <a href="#medicines"
                                        class="flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-full text-white bg-primary hover:bg-blue-800 md:py-4 md:text-lg md:px-10 shadow-lg shadow-blue-900/20 transition-all transform hover:-translate-y-1 cta-btn">
                                        Order Now
                                    </a>
                                    <a href="/prescription/upload"
                                        class="flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-full text-secondary bg-teal-50 hover:bg-teal-100 md:py-4 md:text-lg md:px-10 transition-colors cta-btn">
                                        <i class="fas fa-upload mr-2"></i> Upload Rx
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Hero Image/Illustration -->
                        <div class="mt-12 lg:mt-0 lg:col-span-6 hero-image opacity-0 translate-x-10">
                            <div class="relative mx-auto w-full rounded-lg shadow-lg lg:max-w-md">
                                <div class="relative block w-full bg-white rounded-lg overflow-hidden">
                                    <!-- Placeholder for medical illustration -->
                                    <div class="bg-blue-50 h-96 w-full flex items-center justify-center">
                                        <i class="fas fa-user-md text-9xl text-primary/20"></i>
                                    </div>

                                    <!-- Floating Card Animation -->
                                    <div
                                        class="absolute bottom-4 left-4 bg-white p-4 rounded-lg shadow-xl flex items-center gap-3 float-card">
                                        <div class="bg-green-100 p-2 rounded-full text-green-600">
                                            <i class="fas fa-check"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-500">Delivery Status</p>
                                            <p class="font-bold text-dark">On the way</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>


            <!-- Featured Medicines Section -->
            <section id="medicines" class="py-16 bg-bg dark:bg-dark transition-colors duration-300">
                <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex justify-between items-end mb-8">
                        <div class="flex items-center gap-3">
                            <div
                                class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary group">
                                <i class="fas fa-fire text-xl animate-pulse"></i>
                            </div>
                            <div>
                                <h2 class="text-2xl font-bold text-dark dark:text-white">Featured Products</h2>
                                <p class="text-gray-500 dark:text-gray-400 mt-1">Top picks for your daily health needs
                                </p>
                            </div>
                        </div>
                        <a href="/medicines"
                            class="text-primary hover:text-blue-800 font-medium flex items-center gap-1 group">
                            View All <i
                                class="fas fa-arrow-right transform group-hover:translate-x-1 transition-transform"></i>
                        </a>
                    </div>

                    <div class="relative group">
                        <button onclick="scrollCarousel('medicine-carousel', -1)"
                            class="flex absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 bg-white rounded-full shadow-xl items-center justify-center text-primary border border-gray-100 md:opacity-0 group-hover:opacity-100 transition-all duration-300 -translate-x-2 md:-translate-x-4 group-hover:translate-x-0">
                            <i class="fas fa-chevron-left text-sm md:text-base"></i>
                        </button>

                        <div class="flex space-x-6 overflow-x-auto pb-8 hide-scroll py-4 px-2 scroll-smooth"
                            id="medicine-carousel">
                            <% if (typeof featuredMedicines !=='undefined' ) { %>
                                <% featuredMedicines.forEach(function(med) { %>
                                    <div
                                        class="min-w-[280px] bg-white dark:bg-slate-800 rounded-2xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border border-gray-100 dark:border-slate-700 med-card relative group/card <%= (typeof med.stock !== 'undefined' && med.stock === 0) ? 'opacity-60 grayscale' : '' %>">
                                        <!-- Out of Stock Overlay -->
                                        <% if (typeof med.stock !=='undefined' && med.stock===0) { %>
                                            <div
                                                class="absolute top-4 left-4 z-20 bg-gray-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg">
                                                Out of Stock
                                            </div>
                                            <% } %>

                                                <a href="/products/<%= med.id %>" class="block">
                                                    <% if (med.image_url) { %>
                                                        <div class="h-48 overflow-hidden relative group">
                                                            <img src="<%= med.image_url %>" alt="<%= med.name %>"
                                                                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-in-out">
                                                            <div
                                                                class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                                            </div>
                                                        </div>
                                                        <% } else { %>
                                                            <div
                                                                class="h-48 flex items-center justify-center bg-blue-50 dark:bg-slate-700/50 group-hover:bg-blue-100 dark:group-hover:bg-slate-700 transition-colors">
                                                                <i
                                                                    class="<%= med.icon || 'fas fa-pills' %> text-6xl text-blue-200 dark:text-slate-500 transform group-hover:scale-110 transition-transform duration-500"></i>
                                                            </div>
                                                            <% } %>
                                                </a>
                                                <h3 class="font-bold text-lg text-dark dark:text-gray-100 mb-1">
                                                    <%= med.name %>
                                                </h3>
                                                <p class="text-sm text-gray-500 dark:text-gray-400 mb-3 line-clamp-1">
                                                    <%= med.description %>
                                                </p>
                                                <div class="flex justify-between items-center">
                                                    <span class="text-xl font-bold text-primary dark:text-blue-400">$<%=
                                                            med.price %></span>

                                                    <% if (typeof med.stock !=='undefined' && med.stock===0) { %>
                                                        <button disabled
                                                            class="w-10 h-10 rounded-full bg-gray-100 dark:bg-slate-700 text-gray-400 cursor-not-allowed flex items-center justify-center">
                                                            <i class="fas fa-ban"></i>
                                                        </button>
                                                        <% } else { %>
                                                            <button
                                                                onclick="addToCart('<%= med.id %>', '<%= med.name %>', '<%= med.price %>')"
                                                                class="w-10 h-10 rounded-full bg-blue-50 dark:bg-blue-900/30 text-primary dark:text-blue-400 flex items-center justify-center hover:bg-primary hover:text-white dark:hover:bg-blue-600 dark:hover:text-white transition-all duration-300 add-btn">
                                                                <i class="fas fa-plus"></i>
                                                            </button>
                                                            <% } %>
                                                </div>
                                    </div>
                                    <% }); %>
                                        <% } %>
                        </div>

                        <button onclick="scrollCarousel('medicine-carousel', 1)"
                            class="flex absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 bg-white dark:bg-slate-800 rounded-full shadow-xl items-center justify-center text-primary dark:text-white border border-gray-100 dark:border-slate-700 md:opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-2 md:translate-x-4 group-hover:translate-x-0">
                            <i class="fas fa-chevron-right text-sm md:text-base"></i>
                        </button>
                    </div>
                </div>
            </section>

            <!-- Daily Essentials Section -->
            <section id="essentials" class="py-16 bg-white dark:bg-night transition-colors duration-300">
                <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex justify-between items-end mb-8">
                        <div class="flex items-center gap-3">
                            <div
                                class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary group">
                                <i class="fas fa-pills text-xl"></i>
                            </div>
                            <div>
                                <h2 class="text-2xl font-bold text-dark dark:text-white">Daily Medicines</h2>
                                <p class="text-gray-500 dark:text-gray-400 mt-1">Must-have medical supplies for every
                                    home</p>
                            </div>
                        </div>
                    </div>

                    <div class="relative group">
                        <button onclick="scrollCarousel('essentials-carousel', -1)"
                            class="flex absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 bg-white rounded-full shadow-xl items-center justify-center text-primary border border-gray-100 md:opacity-0 group-hover:opacity-100 transition-all duration-300 -translate-x-2 md:-translate-x-4 group-hover:translate-x-0">
                            <i class="fas fa-chevron-left text-sm md:text-base"></i>
                        </button>

                        <div class="flex space-x-6 overflow-x-auto pb-8 hide-scroll py-4 px-2 scroll-smooth"
                            id="essentials-carousel">
                            <% if (typeof dailyEssentials !=='undefined' ) { %>
                                <% dailyEssentials.forEach(function(med) { %>
                                    <div
                                        class="min-w-[280px] bg-slate-50 dark:bg-slate-800 rounded-2xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border border-gray-100 dark:border-slate-700 med-card relative group/card <%= (typeof med.stock !== 'undefined' && med.stock === 0) ? 'opacity-60 grayscale' : '' %>">
                                        <!-- Out of Stock Overlay -->
                                        <% if (typeof med.stock !=='undefined' && med.stock===0) { %>
                                            <div
                                                class="absolute top-4 left-4 z-20 bg-gray-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg">
                                                Out of Stock
                                            </div>
                                            <% } %>

                                                <div
                                                    class="h-40 bg-white dark:bg-slate-700/50 rounded-xl mb-4 flex items-center justify-center relative overflow-hidden group/med">
                                                    <i
                                                        class="fas <%= med.icon || 'fa-box' %> text-6xl text-gray-100 dark:text-slate-600"></i>
                                                    <div
                                                        class="absolute inset-0 bg-primary/5 dark:bg-white/5 opacity-0 group-hover/med:opacity-100 transition-opacity">
                                                    </div>
                                                </div>
                                                <h3 class="font-bold text-lg text-dark dark:text-gray-100 mb-1">
                                                    <%= med.name %>
                                                </h3>
                                                <p class="text-sm text-gray-500 dark:text-gray-400 mb-3 line-clamp-1">
                                                    <%= med.description %>
                                                </p>
                                                <div class="flex justify-between items-center">
                                                    <span class="text-xl font-bold text-primary dark:text-blue-400">$<%=
                                                            med.price %></span>

                                                    <% if (typeof med.stock !=='undefined' && med.stock===0) { %>
                                                        <button disabled
                                                            class="w-10 h-10 rounded-full bg-gray-100 dark:bg-slate-700 text-gray-400 cursor-not-allowed flex items-center justify-center">
                                                            <i class="fas fa-ban"></i>
                                                        </button>
                                                        <% } else { %>
                                                            <button
                                                                onclick="addToCart('<%= med.id %>', '<%= med.name %>', '<%= med.price %>')"
                                                                class="w-10 h-10 rounded-full bg-white dark:bg-white/10 text-primary dark:text-blue-400 flex items-center justify-center hover:bg-primary hover:text-white dark:hover:bg-blue-600 dark:hover:text-white transition-all duration-300 add-btn">
                                                                <i class="fas fa-plus"></i>
                                                            </button>
                                                            <% } %>
                                                </div>
                                    </div>
                                    <% }); %>
                                        <% } %>
                        </div>

                        <button onclick="scrollCarousel('essentials-carousel', 1)"
                            class="flex absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 bg-white dark:bg-slate-800 rounded-full shadow-xl items-center justify-center text-primary dark:text-white border border-gray-100 dark:border-slate-700 md:opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-2 md:translate-x-4 group-hover:translate-x-0">
                            <i class="fas fa-chevron-right text-sm md:text-base"></i>
                        </button>
                    </div>
                </div>
            </section>

            <!-- Wellness Products Section -->
            <section id="wellness" class="py-16 bg-bg dark:bg-dark transition-colors duration-300">
                <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex justify-between items-end mb-8">
                        <div class="flex items-center gap-3">
                            <div
                                class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary group">
                                <i class="fas fa-magic text-xl"></i>
                            </div>
                            <div>
                                <h2 class="text-2xl font-bold text-dark dark:text-white">Beauty & Wellness</h2>
                                <p class="text-gray-500 dark:text-gray-400 mt-1">Boost your health with our premium
                                    supplements</p>
                            </div>
                        </div>
                    </div>

                    <div class="relative group">
                        <button onclick="scrollCarousel('wellness-carousel', -1)"
                            class="flex absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 bg-white dark:bg-slate-800 rounded-full shadow-xl items-center justify-center text-primary dark:text-white border border-gray-100 dark:border-slate-700 md:opacity-0 group-hover:opacity-100 transition-all duration-300 -translate-x-2 md:-translate-x-4 group-hover:translate-x-0">
                            <i class="fas fa-chevron-left text-sm md:text-base"></i>
                        </button>

                        <div class="flex space-x-6 overflow-x-auto pb-8 hide-scroll py-4 px-2 scroll-smooth"
                            id="wellness-carousel">
                            <% if (typeof wellnessProducts !=='undefined' ) { %>
                                <% wellnessProducts.forEach(function(med) { %>
                                    <div
                                        class="min-w-[280px] bg-white dark:bg-slate-800 rounded-2xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border border-gray-100 dark:border-slate-700 med-card relative group/card <%= (typeof med.stock !== 'undefined' && med.stock === 0) ? 'opacity-60 grayscale' : '' %>">
                                        <!-- Out of Stock Overlay -->
                                        <% if (typeof med.stock !=='undefined' && med.stock===0) { %>
                                            <div
                                                class="absolute top-4 left-4 z-20 bg-gray-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg">
                                                Out of Stock
                                            </div>
                                            <% } %>

                                                <div
                                                    class="h-40 bg-teal-50/30 dark:bg-teal-900/20 rounded-xl mb-4 flex items-center justify-center relative overflow-hidden group/med">
                                                    <i
                                                        class="fas <%= med.icon || 'fa-heartbeat' %> text-6xl text-teal-100 dark:text-teal-700"></i>
                                                    <div
                                                        class="absolute inset-0 bg-teal-500/5 dark:bg-teal-500/10 opacity-0 group-hover/med:opacity-100 transition-opacity">
                                                    </div>
                                                </div>
                                                <h3 class="font-bold text-lg text-dark dark:text-gray-100 mb-1">
                                                    <%= med.name %>
                                                </h3>
                                                <p class="text-sm text-gray-500 dark:text-gray-400 mb-3 line-clamp-1">
                                                    <%= med.description %>
                                                </p>
                                                <div class="flex justify-between items-center">
                                                    <span class="text-xl font-bold text-secondary dark:text-teal-400">$
                                                        <%= med.price %>
                                                    </span>

                                                    <% if (typeof med.stock !=='undefined' && med.stock===0) { %>
                                                        <button disabled
                                                            class="w-10 h-10 rounded-full bg-gray-100 dark:bg-slate-700 text-gray-400 cursor-not-allowed flex items-center justify-center">
                                                            <i class="fas fa-ban"></i>
                                                        </button>
                                                        <% } else { %>
                                                            <button
                                                                onclick="addToCart('<%= med.id %>', '<%= med.name %>', '<%= med.price %>')"
                                                                class="w-10 h-10 rounded-full bg-teal-50 dark:bg-teal-900/30 text-secondary dark:text-teal-400 flex items-center justify-center hover:bg-secondary hover:text-white dark:hover:bg-teal-500 dark:hover:text-white transition-all duration-300 add-btn">
                                                                <i class="fas fa-plus"></i>
                                                            </button>
                                                            <% } %>
                                                </div>
                                    </div>
                                    <% }); %>
                                        <% } %>
                        </div>

                        <button onclick="scrollCarousel('wellness-carousel', 1)"
                            class="flex absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 bg-white dark:bg-slate-800 rounded-full shadow-xl items-center justify-center text-primary dark:text-white border border-gray-100 dark:border-slate-700 md:opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-2 md:translate-x-4 group-hover:translate-x-0">
                            <i class="fas fa-chevron-right text-sm md:text-base"></i>
                        </button>
                    </div>
                </div>
            </section>



            <section id="services" class="py-16 bg-white dark:bg-night transition-colors duration-300">
                <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex justify-between items-end mb-8">
                        <div class="flex items-center gap-3">
                            <div
                                class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center text-primary group">
                                <i class="fas fa-hand-holding-medical text-xl"></i>
                            </div>
                            <div>
                                <h2 class="text-2xl font-bold text-dark dark:text-white">Pharmacy Services</h2>
                                <p class="text-gray-500 dark:text-gray-400 mt-1">Professional healthcare services at
                                    your fingertips</p>
                            </div>
                        </div>
                    </div>

                    <div class="relative group">
                        <button onclick="scrollCarousel('services-carousel', -1)"
                            class="flex absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 bg-white rounded-full shadow-xl items-center justify-center text-primary border border-gray-100 md:opacity-0 group-hover:opacity-100 transition-all duration-300 -translate-x-2 md:-translate-x-4 group-hover:translate-x-0">
                            <i class="fas fa-chevron-left text-sm md:text-base"></i>
                        </button>

                        <div class="flex space-x-6 overflow-x-auto pb-8 hide-scroll py-4 px-2 scroll-smooth"
                            id="services-carousel">
                            <% if (typeof servicesProducts !=='undefined' ) { %>
                                <% servicesProducts.forEach(function(med) { %>
                                    <div
                                        class="min-w-[280px] bg-white dark:bg-slate-800 rounded-2xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border border-gray-100 dark:border-slate-700 med-card">
                                        <div
                                            class="h-40 bg-teal-50/30 dark:bg-teal-900/20 rounded-xl mb-4 flex items-center justify-center relative overflow-hidden group/med">
                                            <i
                                                class="fas <%= med.icon || 'fa-heartbeat' %> text-6xl text-teal-100 dark:text-teal-700"></i>
                                            <div
                                                class="absolute inset-0 bg-teal-500/5 dark:bg-teal-500/10 opacity-0 group-hover/med:opacity-100 transition-opacity">
                                            </div>
                                        </div>
                                        <h3 class="font-bold text-lg text-dark dark:text-gray-100 mb-1">
                                            <%= med.name %>
                                        </h3>
                                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3 line-clamp-1">
                                            <%= med.description %>
                                        </p>
                                        <div class="flex justify-between items-center">
                                            <span class="text-xl font-bold text-secondary dark:text-teal-400">$<%=
                                                    med.price %></span>
                                            <button
                                                onclick="addToCart('<%= med.id %>', '<%= med.name %>', '<%= med.price %>')"
                                                class="w-10 h-10 rounded-full bg-teal-50 text-secondary flex items-center justify-center hover:bg-secondary hover:text-white transition-all duration-300 add-btn">

                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% } %>
                        </div>

                        <button onclick="scrollCarousel('services-carousel', 1)"
                            class="flex absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 bg-white dark:bg-slate-800 rounded-full shadow-xl items-center justify-center text-primary dark:text-white border border-gray-100 dark:border-slate-700 md:opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-2 md:translate-x-4 group-hover:translate-x-0">
                            <i class="fas fa-chevron-right text-sm md:text-base"></i>
                        </button>
                    </div>
                </div>
            </section>

            <!-- Prescription Upload Section -->
            <section id="upload" class="py-16 bg-white dark:bg-slate-900 transition-colors duration-300">
                <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="bg-gradient-to-r from-primary to-blue-800 rounded-3xl p-8 md:p-12 shadow-2xl relative overflow-hidden group cursor-pointer"
                        id="rx-card">
                        <!-- Background Pattern -->
                        <div
                            class="absolute top-0 right-0 -mr-20 -mt-20 w-80 h-80 bg-white/10 rounded-full blur-3xl group-hover:scale-110 transition-transform duration-700">
                        </div>

                        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
                            <div class="text-white text-center md:text-left">
