                            </div>

                            <a href="/prescription/upload"
                                class="bg-secondary hover:bg-teal-500 text-white px-8 py-4 rounded-xl font-bold text-lg shadow-lg flex items-center gap-3 transition-all transform hover:-translate-y-1 hover:shadow-teal-500/30 rx-btn">
                                <i class="fas fa-file-medical text-2xl"></i>
