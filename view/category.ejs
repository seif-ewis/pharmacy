<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<%- include('partials/head') %>

    <body class="bg-bg dark:bg-dark text-dark font-sans antialiased overflow-x-hidden transition-colors duration-300">

        <%- include('partials/header.ejs') %>

            <!-- Category Page Header -->
            <section class="bg-white dark:bg-night py-12 border-b border-gray-100 dark:border-slate-800">
                <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex items-center gap-4 mb-4">
                        <a href="/" class="text-gray-400 hover:text-primary transition-colors">
                            <i class="fas fa-home"></i>
                        </a>
                        <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                        <span class="text-gray-600 dark:text-gray-300 font-medium">
                            <%= categoryName %>
                        </span>
                    </div>

                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                        <div class="min-w-0">
                            <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-dark dark:text-white mb-2">
                                <%= categoryName %>
                            </h1>
                            <p class="text-gray-500 dark:text-gray-400 text-sm">
                                <span id="shown-count">
                                    <%= products.length %>
                                </span> of <span id="total-count">
                                    <%= totalCount %>
                                </span> products
                            </p>
                        </div>

                        <div class="hidden md:flex items-center gap-3 shrink-0">
                            <span class="text-sm text-gray-500">Sort by:</span>
                            <select id="sort-select"
                                class="bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-xl px-4 py-2 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-primary dark:text-white">
                                <option value="newest">Newest First</option>
                                <option value="price-low">Price: Low to High</option>
                                <option value="price-high">Price: High to Low</option>
                                <option value="name">Name A-Z</option>
                            </select>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Products Grid -->
            <section class="py-12 bg-bg dark:bg-dark min-h-screen">
                <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                    <div id="products-grid"
                        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 md:gap-6">
                        <% products.forEach(function(med) { %>
                            <div
                                class="product-card bg-white dark:bg-slate-800 rounded-2xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border border-gray-100 dark:border-slate-700 relative group <%= med.stock === 0 ? 'opacity-60 grayscale' : '' %>">

                                <!-- Out of Stock Badge -->
                                <% if (med.stock===0) { %>
                                    <div
                                        class="absolute top-3 left-3 z-20 bg-gray-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
                                        Out of Stock
                                    </div>
                                    <% } %>

                                        <!-- Product Image/Icon -->
                                        <a href="/products/<%= med.id %>" class="block">
                                            <% if (med.imageUrl) { %>
                                                <div
                                                    class="aspect-square overflow-hidden rounded-xl mb-3 bg-gray-50 dark:bg-slate-700/50">
                                                    <img src="<%= med.imageUrl %>" alt="<%= med.name %>"
                                                        class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500">
                                                </div>
                                                <% } else { %>
                                                    <div
                                                        class="aspect-square rounded-xl mb-3 bg-blue-50 dark:bg-slate-700/50 flex items-center justify-center">
                                                        <i
                                                            class="<%= med.icon || 'fas fa-pills' %> text-4xl md:text-5xl text-blue-200 dark:text-slate-500 group-hover:scale-110 transition-transform"></i>
                                                    </div>
                                                    <% } %>
                                        </a>

                                        <!-- Product Info -->
                                        <a href="/products/<%= med.id %>" class="block">
                                            <h3
                                                class="font-bold text-sm md:text-base text-dark dark:text-gray-100 mb-1 line-clamp-2 group-hover:text-primary transition-colors">
                                                <%= med.name %>
                                            </h3>
                                        </a>
                                        <p class="text-xs text-gray-500 dark:text-gray-400 mb-3 line-clamp-1">
                                            <%= med.description || 'No description' %>
                                        </p>

                                        <!-- Price & Action -->
                                        <div class="flex justify-between items-center">
                                            <div class="flex flex-col">
                                                <span
                                                    class="text-lg md:text-xl font-bold text-primary dark:text-blue-400">$
                                                    <%= med.price %>
                                                </span>
                                                <% if (med.originalPrice) { %>
                                                    <span class="text-[10px] text-red-400 line-through">$<%=
                                                            med.originalPrice %></span>
                                                    <% } %>
                                            </div>

                                            <% if (med.stock===0) { %>
                                                <button disabled
                                                    class="w-9 h-9 rounded-full bg-gray-100 dark:bg-slate-700 text-gray-400 cursor-not-allowed flex items-center justify-center">
                                                    <i class="fas fa-ban text-sm"></i>
                                                </button>
                                                <% } else { %>
                                                    <button
                                                        onclick="addToCart('<%= med.id %>', '<%= med.name %>', '<%= med.price %>', <%= Number(med.stock) || 9999 %>)"
                                                        class="add-btn w-9 h-9 rounded-full bg-blue-50 dark:bg-blue-900/30 text-primary dark:text-blue-400 flex items-center justify-center hover:bg-primary hover:text-white dark:hover:bg-blue-600 transition-all duration-300">
                                                        <i class="fas fa-plus text-sm"></i>
                                                    </button>
                                                    <% } %>
                                        </div>
                            </div>
                            <% }); %>
                    </div>

                    <!-- Sentinel for Infinite Scroll -->
                    <div id="scroll-sentinel" class="h-4 w-full"></div>

                    <!-- Loading Indicator -->
                    <div id="loading-indicator" class="hidden flex items-center justify-center py-12">
                        <div class="flex items-center gap-3 text-gray-400">
                            <div class="w-8 h-8 border-4 border-primary/20 border-t-primary rounded-full animate-spin">
                            </div>
                            <span class="font-medium">Loading more products...</span>
                        </div>
                    </div>

                    <!-- End of Products Message -->
                    <div id="end-message" class="<%= hasMore ? 'hidden' : '' %> text-center py-12">
                        <div
                            class="inline-flex items-center gap-2 text-gray-400 bg-gray-100 dark:bg-slate-800 px-6 py-3 rounded-full">
                            <i class="fas fa-check-circle text-green-500"></i>
                            <span class="font-medium">You've seen all products in this category</span>
                        </div>
                    </div>

                    <!-- Empty State -->
                    <% if (products.length===0) { %>
                        <div class="text-center py-20">
                            <i class="fas fa-box-open text-6xl text-gray-200 dark:text-slate-700 mb-4"></i>
                            <h3 class="text-xl font-bold text-gray-400 mb-2">No Products Found</h3>
                            <p class="text-gray-400">Check back later for new arrivals</p>
                            <a href="/"
                                class="inline-block mt-6 bg-primary text-white px-6 py-3 rounded-xl font-bold hover:bg-blue-700 transition-colors">
                                <i class="fas fa-home mr-2"></i> Back to Home
                            </a>
                        </div>
                        <% } %>
                </div>
            </section>

            <%- include('partials/footer') %>

                <script>
                    // ===============================
                    // INFINITE SCROLL IMPLEMENTATION
                    // ===============================

                    let nextCursor = '<%= nextCursor || "" %>';
                    let isLoading = false;
                    let hasMore = <%= (typeof hasMore !== 'undefined' && hasMore) ? 'true' : 'false' %>;
                    const category = '<%= category %>';

                    // Cart functions
                    let cart = JSON.parse(sessionStorage.getItem('guestCart')) || [];

                    function updateCartUI() {
                        if (window.updateCartCount) window.updateCartCount();
                    }

                    function addToCart(id, name, price, stock = 9999) {
                        cart = JSON.parse(sessionStorage.getItem('guestCart')) || [];
                        const existingItem = cart.find(item => item.id === id);
                        const currentQty = existingItem ? (existingItem.qty || 1) : 0;

                        if (currentQty + 1 > stock) {
                            showToast('warning', `Sorry, only ${stock} items in stock.`);
                            return;
                        }

                        if (existingItem) {
                            existingItem.qty = (existingItem.qty || 1) + 1;
                        } else {
                            cart.push({ id, name, price, qty: 1, maxStock: stock });
                        }

                        sessionStorage.setItem('guestCart', JSON.stringify(cart));
                        updateCartUI();
                        window.dispatchEvent(new Event('storage'));

                        // Visual feedback
                        showToast('success', `${name} added successfully!`);
                    }



                    // Create product card HTML
                    function createProductCard(med) {
                        const isOutOfStock = med.stock === 0;

                        return `
                <div class="product-card bg-white dark:bg-slate-800 rounded-2xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border border-gray-100 dark:border-slate-700 relative group animate-fade-in-up ${isOutOfStock ? 'opacity-60 grayscale' : ''}">
                    ${isOutOfStock ? '<div class="absolute top-3 left-3 z-20 bg-gray-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">Out of Stock</div>' : ''}
                    
                    <a href="/products/${med.id}" class="block">
                        ${med.imageUrl
                                ? `<div class="aspect-square overflow-hidden rounded-xl mb-3 bg-gray-50 dark:bg-slate-700/50">
                                <img src="${med.imageUrl}" alt="${med.name}" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500">
                               </div>`
                                : `<div class="aspect-square rounded-xl mb-3 bg-blue-50 dark:bg-slate-700/50 flex items-center justify-center">
                                <i class="${med.icon || 'fas fa-pills'} text-4xl md:text-5xl text-blue-200 dark:text-slate-500 group-hover:scale-110 transition-transform"></i>
                               </div>`
                            }
                    </a>
                    
                    <a href="/products/${med.id}" class="block">
                        <h3 class="font-bold text-sm md:text-base text-dark dark:text-gray-100 mb-1 line-clamp-2 group-hover:text-primary transition-colors">
                            ${med.name}
                        </h3>
                    </a>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-3 line-clamp-1">
                        ${med.description || 'No description'}
                    </p>
                    
                    <div class="flex justify-between items-center">
                        <div class="flex flex-col">
                            <span class="text-lg md:text-xl font-bold text-primary dark:text-blue-400">$${med.price}</span>
                            ${med.originalPrice ? `<span class="text-[10px] text-red-400 line-through">$${med.originalPrice}</span>` : ''}
                        </div>
                        
                        ${isOutOfStock
                                ? `<button disabled class="w-9 h-9 rounded-full bg-gray-100 dark:bg-slate-700 text-gray-400 cursor-not-allowed flex items-center justify-center">
                                <i class="fas fa-ban text-sm"></i>
                               </button>`
                                : `<button onclick="addToCart('${med.id}', '${med.name.replace(/'/g, "\\'")}', '${med.price}', ${med.stock || 9999})"
                                class="add-btn w-9 h-9 rounded-full bg-blue-50 dark:bg-blue-900/30 text-primary dark:text-blue-400 flex items-center justify-center hover:bg-primary hover:text-white dark:hover:bg-blue-600 transition-all duration-300">
                                <i class="fas fa-plus text-sm"></i>
                               </button>`
                            }
                    </div>
                </div>
            `;
                    }

                    // Load more products
                    // Load more products
                    async function loadMoreProducts() {
                        if (isLoading || !hasMore) return;

                        isLoading = true;
                        const loadingIndicator = document.getElementById('loading-indicator');
                        loadingIndicator.classList.remove('hidden');

                        try {
                            const urlParams = new URLSearchParams(window.location.search);
                            const sort = urlParams.get('sort') || 'newest';

                            // Adjust API call to include sort
                            const url = `/api/category/${category}/products?cursor=${encodeURIComponent(nextCursor)}&sort=${sort}`;

                            const response = await fetch(url);
                            const data = await response.json();

                            if (data.success) {
                                const grid = document.getElementById('products-grid');

                                data.products.forEach(product => {
                                    grid.insertAdjacentHTML('beforeend', createProductCard(product));
                                });

                                // Update state
                                nextCursor = data.nextCursor;
                                hasMore = data.hasMore;

                                // Update count
                                const shownCount = document.getElementById('shown-count');
                                shownCount.textContent = grid.querySelectorAll('.product-card').length;

                                // Show/hide indicators
                                if (!hasMore) {
                                    // Hide sentinel? No need, just hide loader and show end message
                                    loadingIndicator.classList.add('hidden');
                                    document.getElementById('end-message').classList.remove('hidden');
                                    // Optional: Hide sentinel to stop observing
                                    document.getElementById('scroll-sentinel').classList.add('hidden');
                                }
                            }
                        } catch (err) {
                            showToast('error', 'Failed to load more products');
                        } finally {
                            isLoading = false;
                            // Hide loader regardless
                            loadingIndicator.classList.add('hidden');
                        }
                    }

                    // Intersection Observer for infinite scroll
                    function setupInfiniteScroll() {
                        const sentinel = document.getElementById('scroll-sentinel');
                        if (!sentinel) return;

                        const observer = new IntersectionObserver((entries) => {
                            entries.forEach(entry => {
                                if (entry.isIntersecting && hasMore && !isLoading) {
                                    loadMoreProducts();
                                }
                            });
                        }, {
                            rootMargin: '200px' // Start loading 200px before reaching the bottom
                        });

                        observer.observe(sentinel);
                    }

                    function initSort() {
                        const sortSelect = document.getElementById('sort-select');
                        if (sortSelect) {
                            const urlParams = new URLSearchParams(window.location.search);
                            sortSelect.value = urlParams.get('sort') || 'newest';

                            sortSelect.addEventListener('change', (e) => {
                                const url = new URL(window.location.href);
                                url.searchParams.set('sort', e.target.value);
                                window.location.href = url.toString();
                            });
                        }
                    }

                    // Initialize on page load
                    document.addEventListener('DOMContentLoaded', () => {
                        updateCartUI();
                        setupInfiniteScroll();
                        initSort();

                        // Add button hover animation
                        document.querySelectorAll('.add-btn').forEach(btn => {
                            btn.addEventListener('mouseenter', () => {
                                btn.querySelector('i').classList.add('rotate-90');
                            });
                            btn.addEventListener('mouseleave', () => {
                                btn.querySelector('i').classList.remove('rotate-90');
                            });
                        });
                    });
                </script>

                <style>
                    @keyframes fade-in-up {
                        from {
                            opacity: 0;
                            transform: translateY(20px);
                        }

                        to {
                            opacity: 1;
                            transform: translateY(0);
                        }
                    }

                    @keyframes slide-in-right {
                        from {
                            opacity: 0;
                            transform: translateX(100%);
                        }

                        to {
                            opacity: 1;
                            transform: translateX(0);
                        }
                    }

                    .animate-fade-in-up {
                        animation: fade-in-up 0.4s ease-out forwards;
                    }

                    .animate-slide-in-right {
                        animation: slide-in-right 0.3s ease-out forwards;
                    }

                    .rotate-90 {
                        transform: rotate(90deg);
                        transition: transform 0.2s ease;
                    }
                </style>

    </body>

</html>