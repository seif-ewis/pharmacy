<!DOCTYPE html>
<html lang="en">
<%- include('partials/admin_head') %>

    <body class="bg-[#F8FAFC] dark:bg-[#020617] min-h-screen flex flex-col custom-scrollbar overflow-x-hidden">

        <!-- TOP BAR (Always Visible) -->
        <header
            class="h-20 min-h-[5rem] bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border-b border-gray-100 dark:border-slate-800 sticky top-0 z-40 px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-2 transition-all flex-wrap sm:flex-nowrap">
            <div class="flex items-center gap-2 sm:gap-4 lg:gap-8 flex-1 min-w-0">
                <!-- Mobile: hamburger -->
                <button type="button" onclick="toggleAdminSidebar()" aria-label="Open menu"
                    class="md:hidden w-10 h-10 rounded-xl flex items-center justify-center text-gray-500 hover:text-primary hover:bg-gray-100 dark:hover:bg-slate-800 transition-all shrink-0">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                    <div
                        class="w-9 h-9 sm:w-10 sm:h-10 bg-primary/10 rounded-xl flex items-center justify-center text-primary shadow-inner shrink-0">
                        <i class="fas fa-store"></i>
                    </div>
                    <div class="min-w-0">
                        <p class="text-[9px] sm:text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">Store
                        </p>
                        <div class="flex items-center gap-1.5">
                            <span id="store-status-text"
                                class="text-xs sm:text-sm font-black dark:text-white uppercase truncate">OFFLINE</span>
                            <div id="store-status-dot" class="w-2 h-2 rounded-full bg-gray-400 animate-pulse shrink-0">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="hidden sm:block h-8 w-[1px] bg-gray-100 dark:bg-slate-800 shrink-0"></div>

                <div class="flex items-center gap-2 sm:gap-6 min-w-0">
                    <div id="active-shift-badge"
                        class="hidden flex items-center gap-2 sm:gap-4 py-1.5 sm:py-2 px-2 sm:px-4 bg-primary/5 rounded-xl sm:rounded-2xl border border-primary/10">
                        <div
                            class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-primary text-white flex items-center justify-center text-xs shadow-lg shadow-primary/30 shrink-0">
                            <i class="fas fa-user-md"></i>
                        </div>
                        <div class="min-w-0 hidden sm:block">
                            <p id="active-doctor-name"
                                class="text-xs font-black dark:text-white tracking-tight leading-none mb-0.5 sm:mb-1 truncate">
                                Dr. Loading...</p>
                            <p id="shift-start-time"
                                class="text-[9px] text-gray-400 font-bold uppercase tracking-widest">Started --:--</p>
                        </div>
                        <div class="pl-2 sm:ml-4 sm:pl-4 border-l border-primary/20 text-right shrink-0">
                            <p class="text-[8px] sm:text-[9px] font-black text-primary uppercase tracking-widest">Live
                            </p>
                            <p id="live-revenue-text" class="text-xs sm:text-sm font-black dark:text-white">+0 EGP</p>
                        </div>
                    </div>
                    <div id="no-shift-warning"
                        class="flex items-center gap-1.5 sm:gap-2 text-amber-500 bg-amber-50 dark:bg-amber-900/10 px-2 sm:px-4 py-1.5 sm:py-2 rounded-xl sm:rounded-2xl border border-amber-100 dark:border-amber-900/20">
                        <i class="fas fa-exclamation-triangle text-xs shrink-0"></i>
                        <span class="text-[9px] sm:text-[10px] font-black uppercase tracking-widest">No Shift</span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-2 sm:gap-4 shrink-0">
                <div class="text-right hidden sm:block">
                    <p class="text-xs font-black dark:text-white mb-0.5 truncate max-w-[120px] lg:max-w-none">
                        <%= user.full_name %>
                    </p>
                    <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">
                        <%= user.role %>
                    </p>
                </div>
                <div
                    class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-slate-900 dark:bg-slate-800 flex items-center justify-center text-white font-black text-sm shadow-lg border-2 border-white dark:border-slate-700">
                    <%= user.full_name.charAt(0) %>
                </div>
                <a href="/auth/logout"
                    class="w-10 h-10 rounded-xl flex items-center justify-center text-gray-400 hover:text-red-500 hover:bg-red-50 transition-all"
                    aria-label="Logout">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
            </div>
        </header>

        <!-- Mobile sidebar overlay (shown when sidebar is open) -->
        <div id="admin-sidebar-overlay"
            class="fixed inset-0 bg-black/50 z-20 transition-opacity duration-300 md:hidden hidden pointer-events-none"
            onclick="toggleAdminSidebar()" aria-hidden="true"></div>

        <div class="flex flex-1 overflow-hidden relative">
            <!-- SIDEBAR: collapsible on mobile, always visible on md+ -->
            <aside id="admin-sidebar"
                class="w-72 bg-white dark:bg-slate-900 border-r border-gray-100 dark:border-slate-800 flex flex-col shrink-0 z-30 transition-transform duration-300 overflow-y-auto custom-scrollbar fixed md:relative inset-y-0 left-0 h-[calc(100vh-5rem)] md:h-full -translate-x-full md:translate-x-0">
                <div class="p-4 sm:p-6 lg:p-8 flex items-center justify-between md:block">
                    <div class="flex items-center gap-3 pl-2">
                        <div
                            class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center text-white text-sm shadow-lg shadow-primary/30">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <span class="font-black text-lg dark:text-white tracking-tighter">PHARMA<span
                                class="text-primary">OS</span></span>
                    </div>
                    <button type="button" onclick="toggleAdminSidebar()" aria-label="Close menu"
                        class="md:hidden w-10 h-10 rounded-xl flex items-center justify-center text-gray-400 hover:text-primary hover:bg-gray-100 dark:hover:bg-slate-800">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="px-4 sm:px-6 lg:px-8 pb-8">

                    <nav class="space-y-1.5" id="sidebar-nav">
                        <p
                            class="text-[10px] font-black text-gray-400 uppercase tracking-[0.3em] mb-4 ml-4 mt-8 opacity-50">
                            Operation</p>
                        <button onclick="showModule('overview')"
                            class="sidebar-item active w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="overview">
                            <i class="fas fa-th-large w-5 text-center group-hover:scale-110 transition-transform"></i>
                            Overview
                        </button>
                        <button onclick="showModule('orders')"
                            class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="orders">
                            <i
                                class="fas fa-shopping-basket w-5 text-center group-hover:scale-110 transition-transform"></i>
                            Orders
                        </button>
                        <button onclick="showModule('shift')"
                            class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="shift">
                            <i class="fas fa-clock w-5 text-center group-hover:scale-110 transition-transform"></i>
                            Shift Log
                        </button>
                        <button onclick="showModule('prescriptions')"
                            class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="prescriptions">
                            <i
                                class="fas fa-file-medical w-5 text-center group-hover:scale-110 transition-transform"></i>
                            Prescriptions
                        </button>

                        <p
                            class="text-[10px] font-black text-gray-400 uppercase tracking-[0.3em] mb-4 ml-4 mt-8 opacity-50">
                            Resources</p>
                        <button onclick="showModule('inventory')"
                            class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="inventory">
                            <i class="fas fa-boxes w-5 text-center group-hover:scale-110 transition-transform"></i>
                            Inventory
                        </button>
                        <button onclick="showModule('doctors')"
                            class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="doctors">
                            <i class="fas fa-user-md w-5 text-center group-hover:scale-110 transition-transform"></i>
                            Doctors
                        </button>
                        <button onclick="showModule('users')"
                            class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="users">
                            <i class="fas fa-id-card w-5 text-center group-hover:scale-110 transition-transform"></i>
                            Patients
                        </button>
                        <button onclick="showModule('categories')"
                            class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="categories">
                            <i class="fas fa-tags w-5 text-center group-hover:scale-110 transition-transform"></i>
                            Categories
                        </button>

                        <p
                            class="text-[10px] font-black text-gray-400 uppercase tracking-[0.3em] mb-4 ml-4 mt-8 opacity-50">
                            Intelligence</p>
                        <button onclick="showModule('analytics')"
                            class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="analytics">
                            <i class="fas fa-chart-line w-5 text-center group-hover:scale-110 transition-transform"></i>
                            Analytics
                        </button>
                        <button onclick="showModule('announcements')"
                            class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="announcements">
                            <i class="fas fa-bullhorn w-5 text-center group-hover:scale-110 transition-transform"></i>
                            Announcements
                        </button>
                        <button onclick="showModule('ledger')"
                            class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="ledger">
                            <i class="fas fa-receipt w-5 text-center group-hover:scale-110 transition-transform"></i>
                            Performance Ledger
                        </button>
                        <button onclick="showModule('coupons')"
                            class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="coupons">
                            <i class="fas fa-ticket-alt w-5 text-center group-hover:scale-110 transition-transform"></i>
                            Coupons
                        </button>

                        <p
                            class="text-[10px] font-black text-gray-400 uppercase tracking-[0.3em] mb-4 ml-4 mt-8 opacity-50">
                            Governance</p>
                        <button onclick="showModule('settings')"
                            class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="settings">
                            <i class="fas fa-cog w-5 text-center group-hover:scale-110 transition-transform"></i>
                            Settings
                        </button>
                        <button onclick="showModule('audit')"
                            class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="audit">
                            <i class="fas fa-shield-alt w-5 text-center group-hover:scale-110 transition-transform"></i>
                            Audit Logs
                        </button>

                        <p
                            class="text-[10px] font-black text-gray-400 uppercase tracking-[0.3em] mb-4 ml-4 mt-8 opacity-50">
                            Account</p>
                        <button onclick="showModule('profile')"
                            class="sidebar-item w-full flex items-center gap-4 px-5 py-3.5 rounded-2xl text-sm font-black transition-all group"
                            data-module="profile">
                            <i
                                class="fas fa-user-circle w-5 text-center group-hover:scale-110 transition-transform"></i>
                            My Profile
                        </button>
                    </nav>
                </div>
            </aside>

            <!-- MAIN CONTENT AREA -->
            <main class="flex-1 overflow-y-auto custom-scrollbar relative p-4 sm:p-6 lg:p-8 xl:p-12 min-w-0">
                <div id="module-container" class="max-w-7xl mx-auto">
                    <!-- AJAX loaded modules land here -->
                    <div class="flex items-center justify-center min-h-[60vh]">
                        <div class="text-center">
                            <i class="fas fa-circle-notch fa-spin text-4xl text-primary/20 mb-4"></i>
                            <p class="font-black text-gray-400 uppercase tracking-[0.3em]">Synching Core...</p>
                        </div>
                    </div>
                </div>
            </main>
        </div>

        <!-- SIDE DRAWER (Global Detail Viewer) -->
        <div id="global-drawer"
            class="fixed inset-y-0 right-0 w-full max-w-lg bg-white dark:bg-slate-900 shadow-[-20px_0_60px_-15px_rgba(0,0,0,0.1)] z-50 translate-x-full transition-transform duration-500 ease-in-out border-l border-gray-100 dark:border-slate-800">
            <div class="h-full flex flex-col">
                <div
                    class="p-8 border-b border-gray-100 dark:border-slate-800 flex justify-between items-center bg-gray-50/50 dark:bg-slate-900/50">
                    <div>
                        <h3 id="drawer-title" class="text-2xl font-black dark:text-white tracking-tighter">Details</h3>
                        <p id="drawer-subtitle"
                            class="text-[10px] text-gray-400 font-black uppercase tracking-[0.2em] mt-1 italic">Resource
                            Metadata</p>
                    </div>
                    <button onclick="closeDrawer()"
                        class="w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700 flex items-center justify-center text-gray-400 hover:text-primary transition-all shadow-sm">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div id="drawer-content" class="flex-1 overflow-y-auto p-8 custom-scrollbar">
                    <!-- Async detail content -->
                </div>
            </div>
        </div>
        <div id="drawer-overlay" onclick="closeDrawer()"
            class="fixed inset-0 bg-black/40 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-300">
        </div>

        <style>
            .sidebar-item {
                color: #94A3B8;
            }

            .sidebar-item:hover {
                color: #1E3A8A;
                background: rgba(30, 58, 138, 0.05);
            }

            .sidebar-item.active {
                color: white;
                background: #1E3A8A;
                box-shadow: 0 10px 15px -3px rgba(30, 58, 138, 0.2);
            }

            .dark .sidebar-item.active {
                background: #2563EB;
                box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
            }
        </style>

        <script>
            let currentModule = null;

            async function showModule(name) {
                if (currentModule === name) return;

                const container = document.getElementById('module-container');
                const navItems = document.querySelectorAll('.sidebar-item');

                // Set Loading state
                container.innerHTML = `<div class="flex items-center justify-center min-h-[60vh] animate-pulse">
                <div class="text-center">
                    <i class="fas fa-circle-notch fa-spin text-4xl text-primary/20 mb-4"></i>
                    <p class="font-black text-gray-400 uppercase tracking-widest">Loading ${name}...</p>
                </div>
            </div>`;

                // Update Nav UI
                navItems.forEach(item => {
                    if (item.getAttribute('data-module') === name) item.classList.add('active');
                    else item.classList.remove('active');
                });

                try {
                    const res = await fetch(`/admin/module/${name}`);
                    const html = await res.text();

                    container.innerHTML = html;
                    currentModule = name;

                    // Execute scripts manually (since innerHTML doesn't)
                    const scripts = container.querySelectorAll('script');
                    scripts.forEach(oldScript => {
                        const newScript = document.createElement('script');
                        Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                        newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                        oldScript.parentNode.replaceChild(newScript, oldScript);
                    });

                    // Fire initialization event
                    const initFunc = `initialize${name.charAt(0).toUpperCase() + name.slice(1)}`;
                    if (typeof window[initFunc] === 'function') {
                        window[initFunc]();
                    }

                    window.location.hash = name;

                    // On mobile, close sidebar after selecting a module
                    if (window.innerWidth < 768) closeAdminSidebar();
                } catch (err) {
                    container.innerHTML = `<div class="p-12 text-center text-red-500 font-bold">Failed to load module. Check network or permissions.</div>`;
                }
            }

            function toggleAdminSidebar() {
                const sidebar = document.getElementById('admin-sidebar');
                const overlay = document.getElementById('admin-sidebar-overlay');
                if (!sidebar || !overlay) return;
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                if (isOpen) {
                    sidebar.classList.add('-translate-x-full');
                    overlay.classList.add('hidden', 'pointer-events-none');
                } else {
                    sidebar.classList.remove('-translate-x-full');
                    overlay.classList.remove('hidden', 'pointer-events-none');
                }
            }
            function closeAdminSidebar() {
                const sidebar = document.getElementById('admin-sidebar');
                const overlay = document.getElementById('admin-sidebar-overlay');
                if (!sidebar || !overlay) return;
                if (!sidebar.classList.contains('-translate-x-full')) {
                    sidebar.classList.add('-translate-x-full');
                    overlay.classList.add('hidden', 'pointer-events-none');
                }
            }

            async function updateTopBar() {
                try {
                    const res = await fetch('/admin/summary');
                    const data = await res.json();
                    if (!data.success) return;

                    // 1. Store Status (is_open)
                    const statusText = document.getElementById('store-status-text');
                    const statusDot = document.getElementById('store-status-dot');
                    if (statusText && statusDot) {
                        statusText.innerText = data.is_open ? 'ONLINE' : 'OFFLINE';
                        statusDot.className = `w-2 h-2 rounded-full ${data.is_open ? 'bg-green-500 animate-pulse' : 'bg-red-500'}`;
                    }

                    // 2. Active Shift Badge & Warning
                    const badge = document.getElementById('active-shift-badge');
                    const warning = document.getElementById('no-shift-warning');

                    if (data.active_shift) {
                        if (badge) badge.classList.remove('hidden');
                        if (warning) warning.classList.add('hidden');

                        const drName = document.getElementById('active-doctor-name');
                        const startTime = document.getElementById('shift-start-time');
                        const liveRev = document.getElementById('live-revenue-text');

                        if (drName) drName.innerText = data.active_shift.doctor_name;
                        if (startTime) startTime.innerText = `Started ${new Date(data.active_shift.opened_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
                        if (liveRev) liveRev.innerText = `+${Number(data.active_shift.net_revenue).toLocaleString()} EGP`;
                    } else {
                        if (badge) badge.classList.add('hidden');
                        if (warning) warning.classList.remove('hidden');
                    }
                } catch (err) {
                    console.warn("Polling failed", err);
                }
            }
            window.updateTopBar = updateTopBar;

            // Drawer Logic
            function openDrawer(title, content, subtitle = 'Resource Metadata') {
                const drawer = document.getElementById('global-drawer');
                const overlay = document.getElementById('drawer-overlay');

                document.getElementById('drawer-title').innerText = title;
                document.getElementById('drawer-subtitle').innerText = subtitle;
                document.getElementById('drawer-content').innerHTML = content;

                overlay.classList.remove('hidden');
                setTimeout(() => {
                    overlay.style.opacity = '1';
                    drawer.classList.remove('translate-x-full');
                }, 10);
            }

            function closeDrawer() {
                const drawer = document.getElementById('global-drawer');
                const overlay = document.getElementById('drawer-overlay');

                drawer.classList.add('translate-x-full');
                overlay.style.opacity = '0';
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }

            // Global ShowToast (Fallback if Toastify not loaded)
            function showToast(type, message) {
                if (window.Toastify) {
                    Toastify({
                        text: message,
                        duration: 4000,
                        gravity: "top",
                        position: "right",
                        style: {
                            background: type === 'success' ? "linear-gradient(to right, #10b981, #059669)" : "linear-gradient(to right, #ef4444, #dc2626)",
                            borderRadius: "20px",
                            boxShadow: "0 10px 15px -3px rgba(0,0,0,0.1)",
                            fontFamily: "'Inter', sans-serif",
                            fontWeight: "800",
                            textTransform: "uppercase",
                            fontSize: "10px",
                            letterSpacing: "0.1em",
                            padding: "16px 24px"
                        }
                    }).showToast();
                } else showToast('info', message);
            }

            // Top bar: real-time via Socket.IO (listener in admin_head) + 30s fallback when tab visible
            let topBarFallbackInterval = null;
            const TOP_BAR_FALLBACK_MS = 30000;

            function startTopBarFallback() {
                if (topBarFallbackInterval) return;
                topBarFallbackInterval = setInterval(updateTopBar, TOP_BAR_FALLBACK_MS);
            }
            function stopTopBarFallback() {
                if (topBarFallbackInterval) {
                    clearInterval(topBarFallbackInterval);
                    topBarFallbackInterval = null;
                }
            }

            // On connect/reconnect: refresh top bar so first push is never missed and reconnects get latest data
            if (typeof window.socket !== 'undefined') {
                function onSocketConnect() {
                    updateTopBar();
                }
                if (window.socket.connected) onSocketConnect();
                else window.socket.once('connect', onSocketConnect);
                window.socket.on('connect', onSocketConnect);
            }

            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'visible') startTopBarFallback();
                else stopTopBarFallback();
            });

            // Bootstrap
            window.onload = () => {
                const hash = window.location.hash.replace('#', '') || 'overview';
                showModule(hash);
                updateTopBar();
                if (document.visibilityState === 'visible') startTopBarFallback();
            };
        </script>
    </body>

</html>