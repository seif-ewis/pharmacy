<div id="module-profile" class="module-content">
    <div class="mb-8">
        <h1 class="text-3xl font-black dark:text-white mb-2 tracking-tighter">Profile Settings</h1>
        <p class="text-gray-500 text-sm">Manage your account Security and Personal Identification.</p>
    </div>

    <div class="max-w-3xl">
        <div
            class="bg-white dark:bg-slate-800 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-slate-800 p-8">
            <div class="flex items-center gap-6 mb-8">
                <div
                    class="w-20 h-20 rounded-2xl bg-slate-900 dark:bg-slate-700 flex items-center justify-center text-white text-3xl font-black shadow-lg">
                    <%= user.full_name ? user.full_name.charAt(0) : 'A' %>
                </div>
                <div>
                    <h3 class="text-xl font-black dark:text-white">
                        <%= user.full_name %>
                    </h3>
                    <p class="text-sm text-gray-500 mb-1">
                        <%= user.email %>
                    </p>
                    <p class="text-xs font-bold text-primary uppercase tracking-widest">
                        <%= user.role %>
                    </p>
                </div>
            </div>

            <form onsubmit="handleProfileUpdate(event)" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Display
                            Name</label>
                        <input type="text" name="full_name" value="<%= user.full_name %>" required
                            class="w-full px-6 py-4 bg-gray-50 dark:bg-slate-900 border-none rounded-2xl font-bold dark:text-white focus:ring-2 focus:ring-primary/20 transition-all">
                    </div>
                    <div>
                        <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Email
                            Address</label>
                        <input type="email" name="email" value="<%= user.email %>" required
                            class="w-full px-6 py-4 bg-gray-50 dark:bg-slate-900 border-none rounded-2xl font-bold dark:text-white focus:ring-2 focus:ring-primary/20 transition-all">
                    </div>
                </div>

                <div class="pt-6 border-t border-gray-100 dark:border-slate-800">
                    <h4 class="text-sm font-black dark:text-white mb-4 flex items-center gap-2">
                        <i class="fas fa-lock text-primary"></i>
                        Security Credentials
                    </h4>

                    <!-- Hidden fields to trick browser autocomplete -->
                    <input type="text" name="fake_user" style="display:none" autocomplete="username">
                    <input type="password" name="fake_pass" style="display:none" autocomplete="current-password">

                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Current
                                Password <span class="text-red-500">*</span></label>
                            <input type="password" name="current_password" id="profile-current-pass" required
                                placeholder="Enter current password" autocomplete="new-password" data-lpignore="true"
                                data-form-type="other"
                                class="w-full px-6 py-4 bg-gray-50 dark:bg-slate-900 border-none rounded-2xl font-bold dark:text-white focus:ring-2 focus:ring-primary/20 transition-all">
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">New
                                    Password</label>
                                <input type="password" name="new_password" placeholder="Min 6 chars (optional)"
                                    class="w-full px-6 py-4 bg-gray-50 dark:bg-slate-900 border-none rounded-2xl font-bold dark:text-white focus:ring-2 focus:ring-primary/20 transition-all">
                            </div>
                            <div>
                                <label
                                    class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Confirm
                                    New</label>
                                <input type="password" name="confirm_password" placeholder="Confirm new"
                                    class="w-full px-6 py-4 bg-gray-50 dark:bg-slate-900 border-none rounded-2xl font-bold dark:text-white focus:ring-2 focus:ring-primary/20 transition-all">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pt-4 flex justify-end">
                    <button type="submit"
                        class="px-8 py-4 bg-slate-900 dark:bg-white dark:text-slate-900 text-white rounded-2xl font-black uppercase tracking-widest shadow-xl hover:scale-105 transition-all">
                        Update Profile
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    async function handleProfileUpdate(e) {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());

        try {
            const res = await fetch('/admin/profile/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const contentType = res.headers.get("content-type");
            if (contentType && contentType.indexOf("application/json") !== -1) {
                const json = await res.json();
                if (json.success) {
                    showToast('success', 'Profile updated successfully');
                    // Clear password fields only
                    e.target.querySelector('[name="current_password"]').value = '';
                    e.target.querySelector('[name="new_password"]').value = '';
                    e.target.querySelector('[name="confirm_password"]').value = '';
                } else {
                    showToast('error', json.message || 'Update failed');
                }
            } else {
                if (res.ok) window.location.reload();
                else showToast('error', 'Update failed');
            }
        } catch (err) {
            showToast('error', 'Network error');
        }
    }
</script>