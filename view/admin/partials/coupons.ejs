<div id="module-coupons" class="module-content">
    <div class="mb-8 flex justify-between items-end">
        <div>
            <h1 class="text-3xl font-black dark:text-white mb-2 tracking-tighter">Promotions Hub</h1>
            <p class="text-gray-500 text-sm">Create and manage marketing campaigns, discount codes, and usage limits.
            </p>
        </div>
        <button onclick="openAddCouponModal()"
            class="px-6 py-3 bg-primary text-white rounded-2xl text-xs font-black uppercase tracking-widest shadow-xl shadow-primary/20 hover:scale-105 transition-all">
            <i class="fas fa-plus mr-2"></i> Create Coupon
        </button>
    </div>

    <!-- COUPONS LIST -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="coupons-container">
        <!-- Loaded via AJAX -->
        <div class="lg:col-span-3 p-12 text-center text-gray-400 italic font-bold">
            <i class="fas fa-circle-notch fa-spin mr-2"></i> Synching promotions...
        </div>
    </div>

    <!-- Add Coupon Modal -->
    <div id="add-coupon-modal"
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm hidden p-4">
        <div
            class="bg-white dark:bg-slate-800 w-full max-w-md rounded-3xl shadow-2xl border border-gray-100 dark:border-slate-700 overflow-hidden">
            <div
                class="p-8 border-b border-gray-100 dark:border-slate-700 flex justify-between items-center bg-gray-50/50 dark:bg-slate-900/50">
                <div>
                    <h3 class="text-xl font-black dark:text-white">New Campaign</h3>
                    <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-1 italic">Promotion
                        Protocol Entry</p>
                </div>
                <button onclick="closeAddCouponModal()"
                    class="w-10 h-10 rounded-full flex items-center justify-center hover:bg-red-50 hover:text-red-500 text-gray-400 transition-all">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <form onsubmit="submitAddCoupon(event)" class="p-8 space-y-4 max-h-[80vh] overflow-y-auto custom-scrollbar">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label
                            class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Unique
                            Code</label>
                        <input type="text" name="code" required
                            class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border-none rounded-xl text-sm font-black dark:text-white focus:ring-2 focus:ring-primary/20"
                            placeholder="SUMMER2026">
                    </div>
                    <div>
                        <label
                            class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Internal
                            Label</label>
                        <input type="text" name="label" required
                            class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border-none rounded-xl text-sm font-bold dark:text-white focus:ring-2 focus:ring-primary/20"
                            placeholder="Summer Growth">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label
                            class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Disc.
                            Type</label>
                        <select name="discount_type"
                            class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border-none rounded-xl text-sm font-bold dark:text-white focus:ring-2 focus:ring-primary/20">
                            <option value="percent">Percentage %</option>
                            <option value="fixed">Fixed Amount</option>
                            <option value="free_delivery">Free Delivery</option>
                        </select>
                    </div>
                    <div>
                        <label
                            class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Disc.
                            Value</label>
                        <input type="number" name="discount_value" required
                            class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border-none rounded-xl text-sm font-black dark:text-white focus:ring-2 focus:ring-primary/20">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label
                            class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Global
                            Limit</label>
                        <input type="number" name="usage_limit_global"
                            class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border-none rounded-xl text-sm font-black dark:text-white focus:ring-2 focus:ring-primary/20"
                            placeholder="e.g. 100">
                    </div>
                    <div>
                        <label
                            class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-1 mb-2 block">Per
                            User Limit</label>
                        <input type="number" name="usage_limit_per_user"
                            class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border-none rounded-xl text-sm font-black dark:text-white focus:ring-2 focus:ring-primary/20"
                            placeholder="e.g. 1" value="1">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4 items-center p-4 bg-gray-50 dark:bg-slate-900 rounded-2xl">
                    <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Publically
                        Visible</label>
                    <div class="flex justify-end">
                        <input type="checkbox" name="is_public"
                            class="w-6 h-6 rounded-lg border-none bg-white dark:bg-slate-800 text-primary">
                    </div>
                </div>

                <button type="submit"
                    class="w-full py-4 bg-primary text-white rounded-2xl font-black uppercase tracking-widest shadow-xl shadow-primary/20 hover:scale-[1.02] transition-all">
                    Initialize Campaign
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function initializeCoupons() {
        loadCoupons();
    }

    async function loadCoupons() {
        const container = document.getElementById('coupons-container');
        try {
            const res = await fetch('/admin/coupons');
            const data = await res.json();

            if (data.success) {
                if (data.coupons.length === 0) {
                    container.innerHTML = `<div class="lg:col-span-3 p-24 text-center text-gray-300">
                        <i class="fas fa-ticket-alt text-4xl mb-4 opacity-20"></i>
                        <p class="font-black uppercase tracking-widest">No Active Campaigns</p>
                    </div>`;
                    return;
                }

                container.innerHTML = data.coupons.map(c => `
                    <div class="bg-white dark:bg-slate-800 rounded-3xl border border-gray-100 dark:border-slate-700 p-8 shadow-sm group hover:shadow-xl hover:shadow-primary/5 transition-all duration-500 relative overflow-hidden">
                        <div class="absolute -top-10 -right-10 w-24 h-24 bg-primary/5 rounded-full blur-2xl group-hover:bg-primary/10 transition-all"></div>
                        
                        <div class="flex justify-between items-start mb-6">
                            <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center text-xl shadow-inner font-black">
                                <i class="fas fa-tag"></i>
                            </div>
                            <span class="px-3 py-1 bg-gray-50 dark:bg-slate-900 rounded-full text-[9px] font-black uppercase tracking-widest ${c.is_active ? 'text-green-500' : 'text-red-500'}">
                                ${c.is_active ? 'Active' : 'Paused'}
                            </span>
                        </div>

                        <h3 class="text-2xl font-black dark:text-white tracking-tighter mb-1">${c.code}</h3>
                        <p class="text-[10px] text-gray-400 font-black uppercase tracking-widest mb-6">${c.label}</p>

                        <div class="space-y-3 mb-8">
                            <div class="flex justify-between text-xs font-bold text-gray-500">
                                <span>Discount</span>
                                <span class="dark:text-white font-black">${c.discount_type === 'percent' ? c.discount_value + '%' : c.discount_value + ' EGP'}</span>
                            </div>
                            <div class="flex justify-between text-xs font-bold text-gray-500">
                                <span>Min. Order</span>
                                <span class="dark:text-white font-black">${c.min_order_amount} EGP</span>
                            </div>
                            <div class="flex justify-between text-xs font-bold text-gray-500">
                                <span>Usage Count</span>
                                <span class="dark:text-white font-black">${c.usage_count} / ${c.usage_limit_global || '∞'}</span>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <button onclick="toggleCoupon('${c.id}', ${!c.is_active})" class="py-2.5 rounded-xl text-[9px] font-black uppercase tracking-widest ${c.is_active ? 'bg-red-50 text-red-500 hover:bg-red-500 hover:text-white' : 'bg-green-50 text-green-500 hover:bg-green-500 hover:text-white'} transition-all">
                                ${c.is_active ? 'Deactivate' : 'Activate'}
                            </button>
                            <button onclick="deleteCoupon('${c.id}')" class="py-2.5 bg-gray-50 dark:bg-slate-900 text-gray-400 rounded-xl text-[9px] font-black uppercase tracking-widest hover:bg-red-500 hover:text-white transition-all">
                                Delete
                            </button>
                        </div>
                    </div>
                `).join('');
            }
        } catch (err) {
            container.innerHTML = `<div class="lg:col-span-3 text-red-500 text-center font-bold">Failed to load promotions</div>`;
        }
    }

    function openAddCouponModal() {
        document.getElementById('add-coupon-modal').classList.remove('hidden');
    }

    function closeAddCouponModal() {
        document.getElementById('add-coupon-modal').classList.add('hidden');
    }

    async function submitAddCoupon(e) {
        e.preventDefault();
        const formData = new FormData(e.target);
        const jsonData = Object.fromEntries(formData.entries());
        jsonData.is_public = e.target.is_public.checked;

        try {
            const res = await fetch('/admin/coupons/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(jsonData)
            });
            const data = await res.json();
            if (data.success) {
                showToast('success', 'Campaign initialized successfully');
                closeAddCouponModal();
                loadCoupons();
                e.target.reset();
            } else {
                showToast('error', data.message);
            }
        } catch (err) {
            showToast('error', 'Promotion engine connection error');
        }
    }

    async function toggleCoupon(id, status) {
        try {
            const res = await fetch(`/admin/coupons/${id}/toggle`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ is_active: status })
            });
            const data = await res.json();
            if (data.success) {
                showToast('success', `Campaign ${status ? 'activated' : 'deactivated'}`);
                loadCoupons();
            }
        } catch (err) {
            showToast('error', 'Failed to update campaign state');
        }
    }

    async function deleteCoupon(id) {
        if (!confirm('Are you sure you want to delete this coupon? This cannot be undone.')) return;
        try {
            const res = await fetch(`/admin/coupons/${id}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
                showToast('success', 'Campaign deleted');
                loadCoupons();
            } else {
                showToast('error', data.message);
            }
        } catch (err) {
            showToast('error', 'Failed to delete campaign');
        }
    }

    initializeCoupons();
</script>