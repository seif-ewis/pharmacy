<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="text-3xl font-black dark:text-white mb-2">Coupon System</h1>
        <p class="text-gray-500">Create and manage pharmacy discount codes.</p>
    </div>
    <button onclick="openAddCouponModal()"
        class="bg-primary hover:bg-primary/90 text-white font-bold px-6 py-3 rounded-xl flex items-center gap-2 shadow-lg shadow-primary/30 transition-all">
        <i class="fas fa-plus"></i> Create Coupon
    </button>
</div>

<!-- Coupons List -->
<div
    class="bg-white dark:bg-slate-800 rounded-2xl border border-gray-100 dark:border-slate-700 shadow-sm overflow-hidden">
    <table class="w-full text-left">
        <thead class="bg-gray-50 dark:bg-slate-700/50 text-xs font-bold text-gray-400 uppercase tracking-widest">
            <tr>
                <th class="px-6 py-4">Code & Description</th>
                <th class="px-6 py-4 text-center">Discount</th>
                <th class="px-6 py-4 text-center">Usage</th>
                <th class="px-6 py-4 text-center">Status</th>
                <th class="px-6 py-4 text-right">Actions</th>
            </tr>
        </thead>
        <tbody id="coupons-tbody" class="divide-y divide-gray-50 dark:divide-slate-700">
            <!-- Loaded via AJAX -->
        </tbody>
    </table>
</div>

<!-- Add Coupon Modal -->
<div id="add-coupon-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm hidden p-4">
    <div
        class="bg-white dark:bg-slate-800 w-full max-w-lg rounded-2xl shadow-2xl border border-gray-100 dark:border-slate-700 animate-fadeIn">
        <form onsubmit="submitAddCoupon(event)" class="p-8">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-2xl font-black dark:text-white">Create New Coupon</h3>
                <button type="button" onclick="closeAddCouponModal()" class="text-gray-400 hover:text-gray-600"><i
                        class="fas fa-times"></i></button>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="col-span-1">
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Coupon Code</label>
                    <input type="text" name="code" required placeholder="SAVE10"
                        class="w-full bg-gray-50 dark:bg-slate-900 border-none rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary dark:text-white uppercase">
                </div>
                <div class="col-span-1">
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Label (Internal)</label>
                    <input type="text" name="label" required placeholder="Summer Sale"
                        class="w-full bg-gray-50 dark:bg-slate-900 border-none rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary dark:text-white">
                </div>

                <div class="col-span-1">
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Discount Type</label>
                    <select name="discount_type"
                        class="w-full bg-gray-50 dark:bg-slate-900 border-none rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary dark:text-white font-bold">
                        <option value="percentage">Percentage (%)</option>
                        <option value="fixed">Fixed Amount ($)</option>
                    </select>
                </div>
                <div class="col-span-1">
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Discount Value</label>
                    <input type="number" step="0.01" name="discount_value" required
                        class="w-full bg-gray-50 dark:bg-slate-900 border-none rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary dark:text-white">
                </div>

                <div class="col-span-1">
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Min Order ($)</label>
                    <input type="number" step="0.01" name="min_order_amount" value="0"
                        class="w-full bg-gray-50 dark:bg-slate-900 border-none rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary dark:text-white">
                </div>
                <div class="col-span-1">
                    <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Usage Limit (Global)</label>
                    <input type="number" name="usage_limit_global" placeholder="Unlimited"
                        class="w-full bg-gray-50 dark:bg-slate-900 border-none rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary dark:text-white">
                </div>

                <div class="col-span-2">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" name="is_public" class="w-5 h-5 rounded-lg text-primary focus:ring-0">
                        <span class="text-sm font-bold text-gray-500">Public (Visible to everyone in checkout)</span>
                    </label>
                </div>
            </div>

            <button type="submit"
                class="w-full mt-8 bg-primary hover:bg-primary/90 text-white font-bold py-4 rounded-xl shadow-lg shadow-primary/30 transition-all">
                Publish Coupon
            </button>
        </form>
    </div>
</div>

<script>
    async function loadCoupons() {
        const tbody = document.getElementById('coupons-tbody');
        try {
            const res = await fetch('/admin/coupons');
            const data = await res.json();

            if (data.success) {
                if (data.coupons.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-gray-400 font-bold">No coupons found.</td></tr>';
                    return;
                }

                tbody.innerHTML = data.coupons.map(c => `
                    <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/30 transition-colors text-sm">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="px-3 py-1 bg-amber-100 dark:bg-amber-900/30 text-amber-600 rounded-lg font-black tracking-tighter">
                                    ${c.code}
                                </div>
                                <div>
                                    <p class="font-bold dark:text-white">${c.label}</p>
                                    <p class="text-[10px] text-gray-400 uppercase font-black">${c.is_public ? 'Public' : 'Private'}</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <span class="font-black dark:text-gray-300">
                                ${c.discount_type === 'percentage' ? `${c.discount_value}%` : `$${parseFloat(c.discount_value).toFixed(2)}`}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <p class="font-bold text-gray-500">${c.usage_count} Used</p>
                            <p class="text-[10px] text-gray-400">Limit: ${c.usage_limit_global || '∞'}</p>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <button onclick="toggleCouponStatus('${c.id}', ${!c.is_active})" 
                                class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider 
                                ${c.is_active ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600'}">
                                ${c.is_active ? 'Active' : 'Paused'}
                            </button>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <button onclick="deleteCoupon('${c.id}')" class="text-gray-300 hover:text-red-500 transition-colors p-2">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            }
        } catch (err) {
            tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-red-400">Failed to load system.</td></tr>';
        }
    }

    function openAddCouponModal() {
        document.getElementById('add-coupon-modal').classList.remove('hidden');
    }

    function closeAddCouponModal() {
        document.getElementById('add-coupon-modal').classList.add('hidden');
    }

    async function submitAddCoupon(e) {
        e.preventDefault();
        const formData = new FormData(e.target);
        const jsonData = Object.fromEntries(formData.entries());
        jsonData.is_public = e.target.is_public.checked;

        try {
            const res = await fetch('/admin/coupons/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(jsonData)
            });
            const data = await res.json();

            if (data.success) {
                showToast('success', "Coupon published successfully!");
                closeAddCouponModal();
                loadCoupons();
                e.target.reset();
            } else {
                showToast('error', data.message);
            }
        } catch (err) {
            showToast('error', "Network error publishing coupon.");
        }
    }

    async function toggleCouponStatus(id, newStatus) {
        try {
            const res = await fetch(`/admin/coupons/${id}/toggle`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ is_active: newStatus })
            });
            const data = await res.json();
            if (data.success) {
                showToast('success', "Status updated.");
                loadCoupons();
            }
        } catch (err) {
            showToast('error', "Failed to toggle status.");
        }
    }

    async function deleteCoupon(id) {
        if (!confirm("Are you sure you want to delete this coupon? This action cannot be undone.")) return;

        try {
            const res = await fetch(`/admin/coupons/${id}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
                showToast('success', data.message);
                loadCoupons();
            } else {
                showToast('error', data.message);
            }
        } catch (err) {
            showToast('error', "Failed to delete coupon.");
        }
    }
</script>