<div id="module-users" class="module-content">
    <div class="mb-8 flex justify-between items-end">
        <div>
            <h1 class="text-3xl font-black dark:text-white mb-2 tracking-tighter">Patient Directory</h1>
            <p class="text-gray-500 text-sm">Search and manage patient profiles and order history.</p>
        </div>
    </div>

    <!-- SEARCH BAR -->
    <div
        class="bg-white dark:bg-slate-800 p-6 rounded-3xl border border-gray-100 dark:border-slate-700 shadow-sm mb-8 flex gap-4">
        <div class="relative flex-1">
            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <input type="text" id="user-search" placeholder="Search by name, email, or phone..."
                class="w-full pl-12 pr-4 py-3 bg-gray-50 dark:bg-slate-900 border-none rounded-2xl text-sm font-bold focus:ring-2 focus:ring-primary/20 dark:text-white">
        </div>
        <button onclick="loadUsers()"
            class="px-8 py-3 bg-primary text-white rounded-2xl text-xs font-black uppercase tracking-widest shadow-xl shadow-primary/20 hover:scale-105 transition-all">
            Find Patient
        </button>
    </div>

    <!-- USERS TABLE -->
    <div
        class="bg-white dark:bg-slate-800 rounded-3xl border border-gray-100 dark:border-slate-700 shadow-xl overflow-hidden">
        <table class="w-full text-left">
            <thead
                class="bg-gray-50/50 dark:bg-slate-700/30 text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">
                <tr>
                    <th class="px-6 py-5">Patient Name</th>
                    <th class="px-6 py-5">Contact Details</th>
                    <th class="px-6 py-5 text-center">Orders</th>
                    <th class="px-6 py-5">Joined</th>
                    <th class="px-6 py-5 text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="users-tbody" class="divide-y divide-gray-50 dark:divide-slate-700">
                <tr>
                    <td colspan="5" class="px-6 py-24 text-center">
                        <div class="max-w-xs mx-auto text-gray-300">
                            <i class="fas fa-user-search text-5xl mb-6 opacity-20"></i>
                            <p class="font-black dark:text-gray-500 uppercase tracking-widest mb-2">Search Required</p>
                            <p class="text-xs font-bold">To protect performance, use the search bar above to fetch
                                patient records.</p>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script>
    function initializeUsers() {
        // No auto-load as per commandment
    }

    async function loadUsers() {
        const search = document.getElementById('user-search').value;
        const tbody = document.getElementById('users-tbody');

        if (!search) {
            showToast('info', 'Please enter a name or email to search');
            return;
        }

        tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-gray-400 font-bold italic">Finding patients...</td></tr>';

        try {
            const res = await fetch(`/admin/users/all?search=${search}`);
            const data = await res.json();

            if (data.success) {
                if (data.users.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-24 text-center text-gray-400 font-bold italic">No patients found.</td></tr>';
                    return;
                }

                tbody.innerHTML = data.users.map(u => `
                    <tr class="hover:bg-gray-50/50 dark:hover:bg-slate-700/20 transition-all text-sm group">
                        <td class="px-6 py-5">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center font-black dark:text-white">
                                    ${u.full_name.charAt(0)}
                                </div>
                                <span class="font-black dark:text-white">${u.full_name}</span>
                            </div>
                        </td>
                        <td class="px-6 py-5">
                            <p class="text-xs font-bold dark:text-gray-300">${u.email}</p>
                            <p class="text-[10px] text-gray-400 uppercase tracking-widest">${u.phone || 'No phone'}</p>
                        </td>
                        <td class="px-6 py-5 text-center">
                            <span class="px-3 py-1 bg-blue-50 dark:bg-blue-900/30 text-blue-600 rounded-full text-[10px] font-black uppercase tracking-widest">
                                ${u.orders_count || 0} Orders
                            </span>
                        </td>
                        <td class="px-6 py-5 text-gray-400 font-medium text-xs">
                            ${new Date(u.created_at).toLocaleDateString()}
                        </td>
                        <td class="px-6 py-5 text-right">
                             <button onclick="viewUserDetails('${u.id}')" class="w-8 h-8 rounded-lg bg-gray-50 dark:bg-slate-900 flex items-center justify-center text-gray-400 hover:text-primary transition-all">
                                <i class="fas fa-history"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            }
        } catch (err) {
            tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-red-500 font-bold">Failed to connect to patient database.</td></tr>';
        }
    }

    async function viewUserDetails(id) {
        showToast('info', 'Deep user profile coming in settings update');
    }

    initializeUsers();
</script>