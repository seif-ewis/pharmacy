<div id="module-settings" class="module-content">
    <div class="mb-8">
        <h1 class="text-3xl font-black dark:text-white mb-2 tracking-tighter">Governance & Controls</h1>
        <p class="text-gray-500 text-sm">Global system overrides, financial protocols, and operational status
            management.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- LEFT: STATUS & FINANCIALS -->
        <div class="lg:col-span-2 space-y-8">
            <!-- PHARMACY STATUS CORE -->
            <div
                class="bg-white dark:bg-slate-800 p-8 rounded-[2.5rem] border border-gray-100 dark:border-slate-800 shadow-sm">
                <div class="flex justify-between items-center mb-10">
                    <div>
                        <h3 class="text-xl font-black dark:text-white tracking-tighter">Operational Status</h3>
                        <p class="text-[10px] text-gray-400 font-black uppercase tracking-widest mt-1 italic">Master
                            Override Toggle</p>
                    </div>
                </div>

                <div
                    class="flex items-center gap-8 p-8 bg-gray-50 dark:bg-slate-900 rounded-3xl border border-gray-100 dark:border-slate-800">
                    <div id="settings-status-indicator"
                        class="w-16 h-16 rounded-full flex items-center justify-center text-2xl transition-all duration-500">
                        <i class="fas fa-power-off"></i>
                    </div>
                    <div class="flex-1">
                        <h4 id="settings-status-label" class="text-2xl font-black dark:text-white tracking-tight">
                            Checking...</h4>
                        <p id="settings-status-desc"
                            class="text-xs text-gray-400 font-bold uppercase tracking-widest mt-1">System Authority
                            Syncing</p>
                    </div>
                    <button onclick="togglePharmacyStatus()" id="toggle-status-btn"
                        class="px-8 py-4 rounded-2xl text-xs font-black uppercase tracking-widest shadow-xl transition-all hover:scale-105 active:scale-95">
                        Switch State
                    </button>
                </div>

                <div
                    class="mt-8 p-6 bg-amber-50 dark:bg-amber-900/10 border border-dashed border-amber-200 dark:border-amber-900/30 rounded-2xl flex gap-4 items-center">
                    <i class="fas fa-exclamation-triangle text-amber-500"></i>
                    <p
                        class="text-[10px] text-amber-700 dark:text-amber-500 font-black uppercase tracking-widest leading-relaxed">
                        Warning: Changing status will immediately disconnect or enable customer checkout capabilities
                        across all platforms.</p>
                </div>
            </div>

            <!-- FINANCIAL PROTOCOLS -->
            <div
                class="bg-white dark:bg-slate-800 p-8 rounded-[2.5rem] border border-gray-100 dark:border-slate-800 shadow-sm">
                <div class="flex justify-between items-center mb-8">
                    <div>
                        <h3 class="text-xl font-black dark:text-white tracking-tighter">Financial Configuration</h3>
                        <p class="text-[10px] text-gray-400 font-black uppercase tracking-widest mt-1 italic">Tax &
                            Fulfillment Overrides</p>
                    </div>
                </div>

                <form onsubmit="updateFinancialSettings(event)" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-2 block">Value
                            Added Tax (VAT) %</label>
                        <div class="relative">
                            <input type="number" id="setting-tax-rate" name="tax_rate" step="0.01" required
                                class="w-full pl-6 pr-12 py-4 bg-gray-50 dark:bg-slate-900 border-none rounded-2xl text-lg font-black dark:text-white focus:ring-2 focus:ring-primary/20">
                            <span class="absolute right-6 top-1/2 -translate-y-1/2 text-gray-400 font-black">%</span>
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label
                            class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-2 block">Standard
                            Delivery Fee</label>
                        <div class="relative">
                            <input type="number" id="setting-delivery-fee" name="delivery_fee" step="0.5" required
                                class="w-full pl-12 pr-6 py-4 bg-gray-50 dark:bg-slate-900 border-none rounded-2xl text-lg font-black dark:text-white focus:ring-2 focus:ring-primary/20">
                            <span
                                class="absolute left-6 top-1/2 -translate-y-1/2 text-gray-400 font-black text-xs">EGP</span>
                        </div>
                    </div>
                    <div class="md:col-span-2 pt-4">
                        <button type="submit"
                            class="w-full py-5 bg-slate-900 text-white rounded-[1.5rem] font-black uppercase tracking-[0.2em] shadow-2xl hover:bg-black transition-all">
                            Persist Protocol Updates
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIGHT: AUDIT HISTORY -->
        <div class="space-y-8">
            <div
                class="bg-white dark:bg-slate-800 p-8 rounded-[2.5rem] border border-gray-100 dark:border-slate-800 shadow-sm flex-1">
                <div class="mb-8">
                    <h3 class="text-xl font-black dark:text-white tracking-tighter">Status Change Log</h3>
                    <p class="text-[10px] text-gray-400 font-black uppercase tracking-widest mt-1 italic">Immutable
                        Timeline</p>
                </div>

                <div id="status-logs-timeline"
                    class="space-y-6 max-h-[500px] overflow-y-auto pr-4 scrollbar-thin scrollbar-thumb-gray-200 dark:scrollbar-thumb-slate-700">
                    <!-- Logs via AJAX -->
                    <div class="p-8 text-center text-gray-300 font-bold italic text-xs">Syncing logs...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let currentIsOpen = true;

    function initializeSettings() {
        loadSettings();
    }

    async function loadSettings() {
        try {
            const res = await fetch('/admin/settings');
            const data = await res.json();

            if (data.success) {
                const s = data.settings;
                currentIsOpen = s.is_open;

                // Update Financials
                document.getElementById('setting-tax-rate').value = s.tax_rate * 100;
                document.getElementById('setting-delivery-fee').value = s.delivery_fee;

                // Update Status UI
                const indicator = document.getElementById('settings-status-indicator');
                const label = document.getElementById('settings-status-label');
                const desc = document.getElementById('settings-status-desc');
                const btn = document.getElementById('toggle-status-btn');

                if (s.is_open) {
                    indicator.className = 'w-16 h-16 rounded-full flex items-center justify-center text-2xl bg-green-100 text-green-600 shadow-lg shadow-green-100 dark:shadow-none';
                    label.innerText = 'Store is ONLINE';
                    label.className = 'text-2xl font-black text-green-600 tracking-tight';
                    desc.innerText = 'Customers can place orders normally';
                    btn.innerText = 'Close Pharmacy';
                    btn.className = 'px-8 py-4 rounded-2xl text-xs font-black uppercase tracking-widest shadow-xl bg-red-50 text-red-600 hover:bg-red-600 hover:text-white transition-all';
                } else {
                    indicator.className = 'w-16 h-16 rounded-full flex items-center justify-center text-2xl bg-red-100 text-red-600 shadow-lg shadow-red-100 dark:shadow-none';
                    label.innerText = 'Store is OFFLINE';
                    label.className = 'text-2xl font-black text-red-600 tracking-tight';
                    desc.innerText = 'Only admins can access system features';
                    btn.innerText = 'Open Pharmacy';
                    btn.className = 'px-8 py-4 rounded-2xl text-xs font-black uppercase tracking-widest shadow-xl bg-green-600 text-white hover:bg-green-700 transition-all';
                }

                // Update Logs
                const logContainer = document.getElementById('status-logs-timeline');
                if (data.logs.length === 0) {
                    logContainer.innerHTML = '<p class="text-center text-gray-400 text-xs italic">No history found.</p>';
                } else {
                    logContainer.innerHTML = data.logs.slice(0, 10).map(l => `
                        <div class="flex gap-4 group">
                            <div class="flex flex-col items-center">
                                <div class="w-2 h-2 rounded-full ${l.is_open ? 'bg-green-500' : 'bg-red-500'} group-hover:scale-150 transition-all"></div>
                                <div class="w-[2px] flex-1 bg-gray-100 dark:bg-slate-700 mt-2"></div>
                            </div>
                            <div class="pb-6">
                                <p class="text-xs font-black dark:text-white uppercase tracking-widest">${l.is_open ? 'Opened' : 'Closed'} System</p>
                                <p class="text-[9px] text-gray-400 font-bold mt-1 uppercase">By ${l.creator_name} • ${new Date(l.created_at).toLocaleString()}</p>
                            </div>
                        </div>
                    `).join('');
                }
            }
        } catch (err) {
            showToast('error', 'Failed to synchronize system settings');
        }
    }

    async function togglePharmacyStatus() {
        const nextState = !currentIsOpen;
        if (!confirm(`Are you sure you want to ${nextState ? 'OPEN' : 'CLOSE'} the pharmacy?`)) return;

        try {
            const res = await fetch('/admin/settings/toggle-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ is_open: nextState })
            });
            const data = await res.json();
            if (data.success) {
                showToast('success', data.message);
                loadSettings();
                // External trigger for top bar sync
                if (typeof updateTopBar === 'function') updateTopBar();
            }
        } catch (err) {
            showToast('error', 'Master override failed to execute');
        }
    }

    async function updateFinancialSettings(e) {
        e.preventDefault();
        const formData = new FormData(e.target);
        const jsonData = Object.fromEntries(formData.entries());
        jsonData.tax_rate = Number(jsonData.tax_rate) / 100;

        try {
            const res = await fetch('/admin/settings/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(jsonData)
            });
            const data = await res.json();
            if (data.success) {
                showToast('success', 'Financial protocols updated and versioned');
                loadSettings();
            }
        } catch (err) {
            showToast('error', 'Failed to persist updates');
        }
    }

    initializeSettings();
</script>