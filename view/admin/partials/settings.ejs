<div class="mb-8">
    <h1 class="text-3xl font-black dark:text-white mb-2">Pharmacy Settings</h1>
    <p class="text-gray-500">Global configuration and operational status tracking.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
    <!-- Status Toggle -->
    <div
        class="bg-white dark:bg-slate-800 p-8 rounded-2xl border border-gray-100 dark:border-slate-700 shadow-sm flex flex-col justify-between">
        <div>
            <h3 class="font-black text-xl mb-2 dark:text-white">Pharmacy Status</h3>
            <p class="text-sm text-gray-400 mb-6">Instantly open or close the storefront for all patients.</p>
        </div>

        <div class="flex items-center gap-4">
            <button id="toggle-status-btn" onclick="togglePharmacyStatus()"
                class="flex-1 py-4 rounded-xl font-bold transition-all shadow-lg flex items-center justify-center gap-2">
                <i class="fas fa-power-off"></i>
                <span id="status-text">Loading...</span>
            </button>
        </div>
    </div>

    <!-- Edit Financials -->
    <div
        class="lg:col-span-2 bg-white dark:bg-slate-800 p-8 rounded-2xl border border-gray-100 dark:border-slate-700 shadow-sm">
        <h3 class="font-black text-xl mb-6 dark:text-white">Financial Configuration</h3>
        <form onsubmit="submitUpdateSettings(event)" id="settings-form" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Tax Rate (Decimal)</label>
                <div class="relative">
                    <input type="number" step="0.01" name="tax_rate" required
                        class="w-full bg-gray-50 dark:bg-slate-900 border-none rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary dark:text-white pl-10">
                    <i class="fas fa-percent absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Delivery Fee ($)</label>
                <div class="relative">
                    <input type="number" step="0.01" name="delivery_fee" required
                        class="w-full bg-gray-50 dark:bg-slate-900 border-none rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-primary dark:text-white pl-10">
                    <i class="fas fa-truck absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                </div>
            </div>

            <button type="submit"
                class="md:col-span-2 w-full bg-slate-900 dark:bg-primary text-white font-bold py-4 rounded-xl hover:opacity-90 transition-all shadow-lg shadow-primary/20">
                Save Changes
            </button>
        </form>
    </div>
</div>

<!-- Status Logs -->
<div
    class="bg-white dark:bg-slate-800 rounded-2xl border border-gray-100 dark:border-slate-700 shadow-sm overflow-hidden">
    <div class="p-6 border-b border-gray-50 dark:border-slate-700">
        <h3 class="font-black text-xl dark:text-white">Operation Logs</h3>
        <p class="text-xs text-gray-400 uppercase font-bold tracking-widest mt-1">Who opened/closed and when</p>
    </div>
    <table class="w-full text-left">
        <thead class="bg-gray-50 dark:bg-slate-700/50 text-[10px] font-bold text-gray-400 uppercase tracking-widest">
            <tr>
                <th class="px-6 py-4">Action</th>
                <th class="px-6 py-4">Performed By</th>
                <th class="px-6 py-4 text-right">Timestamp</th>
            </tr>
        </thead>
        <tbody id="status-logs-tbody" class="divide-y divide-gray-50 dark:divide-slate-700">
            <!-- Loaded via AJAX -->
        </tbody>
    </table>
</div>

<script>
    let currentIsOpen = true;

    async function loadSettings() {
        try {
            const res = await fetch('/admin/settings');
            const data = await res.json();
            if (data.success) {
                const form = document.getElementById('settings-form');
                form.tax_rate.value = data.settings.tax_rate;
                form.delivery_fee.value = data.settings.delivery_fee;

                currentIsOpen = data.settings.is_open;
                updateStatusUI();

                const logBody = document.getElementById('status-logs-tbody');
                if (data.logs.length === 0) {
                    logBody.innerHTML = '<tr><td colspan="3" class="px-6 py-8 text-center text-gray-400">No logs found.</td></tr>';
                } else {
                    logBody.innerHTML = data.logs.map(l => `
                        <tr class="text-sm">
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 rounded-full text-[10px] font-black uppercase ${l.is_open ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600'}">
                                    ${l.is_open ? 'Opened Store' : 'Closed Store'}
                                </span>
                            </td>
                            <td class="px-6 py-4 font-bold dark:text-white">${l.creator_name}</td>
                            <td class="px-6 py-4 text-right text-xs text-gray-400">${new Date(l.created_at).toLocaleString()}</td>
                        </tr>
                    `).join('');
                }
            }
        } catch (err) {
            showToast('error', "Failed to load current settings.");
        }
    }

    function updateStatusUI() {
        const btn = document.getElementById('toggle-status-btn');
        const text = document.getElementById('status-text');

        if (currentIsOpen) {
            btn.className = "flex-1 py-4 rounded-xl font-bold transition-all shadow-lg flex items-center justify-center gap-2 bg-red-50 text-red-600 hover:bg-red-100 shadow-red-100 dark:shadow-none";
            text.innerText = "CLOSE PHARMACY";
        } else {
            btn.className = "flex-1 py-4 rounded-xl font-bold transition-all shadow-lg flex items-center justify-center gap-2 bg-green-50 text-green-600 hover:bg-green-100 shadow-green-100 dark:shadow-none";
            text.innerText = "OPEN PHARMACY";
        }
    }

    async function togglePharmacyStatus() {
        const newStatus = !currentIsOpen;
        try {
            const res = await fetch('/admin/settings/toggle-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ is_open: newStatus })
            });
            const data = await res.json();
            if (data.success) {
                showToast('success', data.message);
                loadSettings();
            }
        } catch (err) {
            showToast('error', "Failed to toggle status.");
        }
    }

    async function submitUpdateSettings(e) {
        e.preventDefault();
        const formData = new FormData(e.target);
        const jsonData = Object.fromEntries(formData.entries());

        try {
            const res = await fetch('/admin/settings/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(jsonData)
            });
            const data = await res.json();
            if (data.success) {
                showToast('success', "Financial settings updated successfully!");
                loadSettings();
            } else {
                showToast('error', data.message);
            }
        } catch (err) {
            showToast('error', "Network error updating settings.");
        }
    }
</script>