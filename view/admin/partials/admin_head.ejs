<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof pageTitle !=='undefined' ? pageTitle : 'Admin' %> | Admin Panel
    </title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- Anime.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>

    <!-- Toastify -->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Socket.io -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        window.socket = socket;
        // Room join happens server-side after auth; client may re-request on connect for resilience (server validates admin)
        socket.on('connect', function () {
            socket.emit('join', 'admin');
        });
        // Listener registered early so no race with first server push; calls window.updateTopBar when dashboard defines it
        socket.on('admin:summary-update', function () {
            if (typeof window.updateTopBar === 'function') window.updateTopBar();
        });

        /**
         * Global Toast Notification Helper
         */
        function showToast(type, message) {
            let bgColor;
            let icon;
            switch (type) {
                case 'success':
                    bgColor = "linear-gradient(to right, #059669, #10b981)";
                    icon = "✅";
                    break;
                case 'error':
                    bgColor = "linear-gradient(to right, #dc2626, #ef4444)";
                    icon = "❌";
                    break;
                case 'warning':
                    bgColor = "linear-gradient(to right, #d97706, #f59e0b)";
                    icon = "⚠️";
                    break;
                case 'info':
                default:
                    bgColor = "linear-gradient(to right, #1E3A8A, #3B82F6)";
                    icon = "ℹ️";
                    break;
            }

            Toastify({
                text: `${icon} ${message}`,
                duration: 5000,
                gravity: "top",
                position: "right",
                stopOnFocus: true,
                style: {
                    background: bgColor,
                    borderRadius: "12px",
                    fontWeight: "600",
                    fontFamily: "Inter, sans-serif"
                }
            }).showToast();
        }

        /**
         * Global UI Alert Helper
         */
        function showAlert(message, type = 'info') {
            showToast(type, message);
        }

        /**
         * Global UI Confirm Helper
         * Returns a Promise that resolves to true (Confirm) or false (Cancel)
         */
        function showConfirm(title, message, confirmText = 'Confirm', cancelText = 'Cancel') {
            return new Promise((resolve) => {
                const modalId = 'global-confirm-modal';
                let modal = document.getElementById(modalId);

                if (!modal) {
                    modal = document.createElement('div');
                    modal.id = modalId;
                    modal.className = 'fixed inset-0 z-[9999] flex items-center justify-center bg-black/50 backdrop-blur-sm hidden p-4';
                    modal.innerHTML = `
                        <div class="bg-white dark:bg-slate-800 w-full max-w-sm rounded-3xl shadow-2xl border border-gray-100 dark:border-slate-700 overflow-hidden transform transition-all scale-95 opacity-0 duration-300" id="global-confirm-content">
                            <div class="p-8 text-center">
                                <div class="w-16 h-16 bg-blue-50 dark:bg-blue-900/30 text-primary dark:text-blue-400 rounded-full flex items-center justify-center mx-auto mb-6">
                                    <i class="fas fa-question text-2xl"></i>
                                </div>
                                <h3 class="text-xl font-black dark:text-white mb-2" id="global-confirm-title">Confirm Action</h3>
                                <p class="text-gray-500 text-sm font-medium" id="global-confirm-message"></p>
                            </div>
                            <div class="p-6 bg-gray-50 dark:bg-slate-900/50 flex gap-3">
                                <button id="global-confirm-cancel" class="flex-1 py-3 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-gray-500 font-bold rounded-2xl hover:bg-gray-100 dark:hover:bg-slate-700 transition-all text-sm">
                                    Cancel
                                </button>
                                <button id="global-confirm-ok" class="flex-1 py-3 bg-primary text-white font-bold rounded-2xl shadow-lg shadow-primary/20 hover:scale-[1.02] transition-all text-sm">
                                    Confirm
                                </button>
                            </div>
                        </div>
                    `;
                    document.body.appendChild(modal);
                }

                const content = document.getElementById('global-confirm-content');
                document.getElementById('global-confirm-title').innerText = title;
                document.getElementById('global-confirm-message').innerText = message;
                document.getElementById('global-confirm-ok').innerText = confirmText;
                document.getElementById('global-confirm-cancel').innerText = cancelText;

                const openModal = () => {
                    modal.classList.remove('hidden');
                    setTimeout(() => {
                        content.classList.remove('scale-95', 'opacity-0');
                        content.classList.add('scale-100', 'opacity-100');
                    }, 50);
                };

                const closeModal = (result) => {
                    content.classList.remove('scale-100', 'opacity-100');
                    content.classList.add('scale-95', 'opacity-0');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                        resolve(result);
                    }, 300);
                };

                document.getElementById('global-confirm-ok').onclick = () => closeModal(true);
                document.getElementById('global-confirm-cancel').onclick = () => closeModal(false);

                openModal();
            });
        }

        // Listen for global announcements
        socket.on('announcement', (data) => {
            showToast('info', `${data.title}: ${data.message.substring(0, 50)}...`);
        });
    </script>

    <!-- Tailwind Config -->
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#1E3A8A',
                        secondary: '#0D9488',
                        success: '#22C55E',
                        warning: '#F59E0B',
                        error: '#EF4444',
                        bg: '#F8FAFC',
                        dark: '#020617',
                        night: '#0F172A',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #e2e8f0;
            border-radius: 10px;
        }

        .dark .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #334155;
        }

        .admin-sidebar-item.active {
            background: rgba(59, 130, 246, 0.1);
            color: #3b82f6;
            border-right: 4px solid #3b82f6;
        }

        .module-content.hidden {
            display: none;
        }

        .module-content {
            animation: fadeIn 0.3s ease-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>