<div id="module-ledger" class="module-content">
    <div class="mb-10 flex justify-between items-end">
        <div>
            <h1 class="text-3xl font-black dark:text-white mb-2 tracking-tighter">Performance Ledger</h1>
            <p class="text-gray-500 text-sm font-medium">Detailed historical audit of revenue and order volume.</p>
        </div>
        <div
            class="flex bg-white dark:bg-slate-800 p-1.5 rounded-2xl border border-gray-100 dark:border-slate-800 shadow-sm">
            <button onclick="switchLedgerGrain('day')" id="ledger-grain-day"
                class="px-6 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all">Daily</button>
            <button onclick="switchLedgerGrain('month')" id="ledger-grain-month"
                class="px-6 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all">Monthly</button>
        </div>
    </div>

    <div id="ledger-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <!-- Shimmers while loading -->
        <div
            class="bg-white dark:bg-slate-800 p-6 rounded-3xl border border-gray-100 dark:border-slate-800 loading-shimmer h-32">
        </div>
        <div
            class="bg-white dark:bg-slate-800 p-6 rounded-3xl border border-gray-100 dark:border-slate-800 loading-shimmer h-32">
        </div>
        <div
            class="bg-white dark:bg-slate-800 p-6 rounded-3xl border border-gray-100 dark:border-slate-800 loading-shimmer h-32">
        </div>
        <div
            class="bg-white dark:bg-slate-800 p-6 rounded-3xl border border-gray-100 dark:border-slate-800 loading-shimmer h-32">
        </div>
    </div>
</div>

<script>
    let currentGrain = 'day';
    let ledgerHistory = [];

    function initializeLedger() {
        console.log("Ledger Initialized");
        updateToggleUI();
        loadLedgerData();
    }

    async function loadLedgerData() {
        const grid = document.getElementById('ledger-grid');
        try {
            const res = await fetch(`/admin/performance-ledger?grain=${currentGrain}`);
            const data = await res.json();

            if (data.success) {
                ledgerHistory = data.history;
                if (ledgerHistory.length === 0) {
                    grid.innerHTML = '<div class="col-span-full py-12 text-center text-gray-400 font-bold italic">No historical data found for this grain.</div>';
                    return;
                }

                grid.innerHTML = ledgerHistory.map((item, index) => `
                    <div class="bg-white dark:bg-slate-800 p-8 rounded-[2rem] border border-gray-100 dark:border-slate-800 hover:shadow-2xl hover:shadow-primary/10 transition-all group relative overflow-hidden">
                        <div class="absolute top-0 left-0 w-1 h-full bg-primary opacity-20 group-hover:opacity-100 transition-opacity"></div>
                        
                        <div class="flex justify-between items-start mb-6">
                            <div>
                                <p class="text-[9px] font-black text-gray-400 uppercase tracking-[0.2em] mb-1 italic">${item.label}</p>
                                <h4 class="text-2xl font-black dark:text-white tracking-tighter">${Number(item.net_revenue).toLocaleString()} EGP</h4>
                                <p class="text-[10px] font-bold text-primary uppercase tracking-widest">Net Revenue</p>
                            </div>
                            <div class="w-12 h-12 rounded-2xl bg-primary/5 text-primary flex items-center justify-center text-xl group-hover:bg-primary group-hover:text-white transition-all duration-500 shadow-inner">
                                <i class="fas fa-file-invoice-dollar"></i>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4 mb-6">
                            <div class="p-3 bg-gray-50 dark:bg-slate-900/50 rounded-2xl border border-gray-50 dark:border-slate-700/50">
                                <p class="text-[8px] font-black text-gray-400 uppercase tracking-widest mb-1">Orders</p>
                                <p class="text-sm font-black dark:text-gray-300">${item.total_orders}</p>
                            </div>
                            <div class="p-3 bg-gray-50 dark:bg-slate-900/50 rounded-2xl border border-gray-50 dark:border-slate-700/50">
                                <p class="text-[8px] font-black text-gray-400 uppercase tracking-widest mb-1">Returns</p>
                                <p class="text-sm font-bold text-red-500">${item.total_returns}</p>
                            </div>
                        </div>

                        <button onclick="openLedgerDetails(${index})" 
                            class="w-full py-3 bg-slate-900 dark:bg-white/5 dark:hover:bg-white/10 text-white dark:text-white text-[10px] font-black uppercase tracking-widest rounded-xl transition-all hover:scale-[1.02] active:scale-95 flex items-center justify-center gap-2">
                            <i class="fas fa-chart-bar opacity-50"></i>
                            View Audit Breakdown
                        </button>
                    </div>
                `).join('');
            }
        } catch (err) {
            console.error("Ledger Load Error:", err);
            grid.innerHTML = '<div class="col-span-full py-12 text-center text-red-500 font-bold">Failed to load ledger data.</div>';
        }
    }

    function openLedgerDetails(index) {
        const item = ledgerHistory[index];
        if (!item) return;

        const content = `
            <div class="space-y-8">
                <div class="p-8 bg-slate-900 rounded-[2.5rem] text-white shadow-2xl relative overflow-hidden group">
                    <div class="absolute -top-24 -right-24 w-64 h-64 bg-primary/20 rounded-full blur-[100px]"></div>
                    <div class="relative z-10">
                        <p class="text-[10px] font-black text-primary uppercase tracking-[0.3em] mb-6">Consolidated Statement</p>
                        <div class="space-y-5">
                            <div class="flex justify-between items-center bg-white/5 p-4 rounded-2xl border border-white/5">
                                <span class="text-xs font-bold text-gray-400 uppercase tracking-widest">Gross Sales</span>
                                <span class="text-lg font-black">${Number(item.gross_revenue).toLocaleString()} EGP</span>
                            </div>
                            <div class="flex justify-between items-center bg-red-500/5 p-4 rounded-2xl border border-red-500/10">
                                <span class="text-xs font-bold text-red-400 uppercase tracking-widest">Refunded Cash</span>
                                <span class="text-lg font-black text-red-400">-${Number(item.total_refunds).toLocaleString()} EGP</span>
                            </div>
                            <div class="pt-4 border-t border-white/10 flex justify-between items-end">
                                <div>
                                    <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Final Net Total</p>
                                    <h3 class="text-3xl font-black text-green-400 tracking-tighter">${Number(item.net_revenue).toLocaleString()} EGP</h3>
                                </div>
                                <div class="w-12 h-12 bg-green-400/10 rounded-2xl flex items-center justify-center text-green-400">
                                    <i class="fas fa-check-circle text-2xl"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="p-6 bg-white dark:bg-slate-900 rounded-3xl border border-gray-100 dark:border-slate-800 flex flex-col items-center justify-center text-center">
                        <div class="w-10 h-10 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-3">
                            <i class="fas fa-shopping-basket"></i>
                        </div>
                        <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Volume</p>
                        <p class="text-2xl font-black dark:text-white">${item.total_orders}</p>
                        <p class="text-[9px] text-gray-500 font-bold uppercase mt-1">Successful Orders</p>
                    </div>
                    <div class="p-6 bg-white dark:bg-slate-900 rounded-3xl border border-gray-100 dark:border-slate-800 flex flex-col items-center justify-center text-center">
                        <div class="w-10 h-10 bg-red-500/10 text-red-500 rounded-xl flex items-center justify-center mb-3">
                            <i class="fas fa-undo"></i>
                        </div>
                        <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Attrition</p>
                        <p class="text-2xl font-black text-red-500">${item.total_returns}</p>
                        <p class="text-[9px] text-gray-500 font-bold uppercase mt-1">Returned Items</p>
                    </div>
                </div>

                <div class="p-6 bg-indigo-50 dark:bg-indigo-900/10 rounded-3xl border border-indigo-100 dark:border-indigo-900/20">
                    <div class="flex gap-4 items-start">
                        <div class="w-10 h-10 bg-indigo-500 text-white rounded-xl flex items-center justify-center shrink-0 shadow-lg shadow-indigo-500/20">
                            <i class="fas fa-info-circle"></i>
                        </div>
                        <div>
                            <h4 class="text-xs font-black text-indigo-900 dark:text-indigo-400 uppercase tracking-widest mb-1">Reporting Period</h4>
                            <p class="text-xs text-indigo-700 dark:text-indigo-500/80 font-bold italic leading-relaxed">This audit covers the internal financial performance for the period of <b>${item.label}</b>. All data is synchronized from real-time database transitions.</p>
                        </div>
                    </div>
                </div>
            </div>
        `;

        openDrawer(`${currentGrain === 'month' ? 'Monthly' : 'Daily'} Audit: ${item.label}`, content);
    }

    function switchLedgerGrain(grain) {
        if (currentGrain === grain) return;
        currentGrain = grain;
        updateToggleUI();
        loadLedgerData();
    }

    function updateToggleUI() {
        const dayBtn = document.getElementById('ledger-grain-day');
        const monthBtn = document.getElementById('ledger-grain-month');
        if (dayBtn && monthBtn) {
            if (currentGrain === 'day') {
                dayBtn.className = "px-6 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all bg-primary text-white shadow-lg shadow-primary/20";
                monthBtn.className = "px-6 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all text-gray-400 hover:text-gray-600 dark:hover:text-white";
            } else {
                monthBtn.className = "px-6 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all bg-primary text-white shadow-lg shadow-primary/20";
                dayBtn.className = "px-6 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all text-gray-400 hover:text-gray-600 dark:hover:text-white";
            }
        }
    }

    initializeLedger();
</script>