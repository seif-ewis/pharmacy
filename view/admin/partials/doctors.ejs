<div id="module-doctors" class="module-content">
    <div class="mb-8 flex justify-between items-end">
        <div>
            <h1 class="text-3xl font-black dark:text-white mb-2 tracking-tighter">Medical Staff</h1>
            <p class="text-gray-500 text-sm">Manage pharmacy doctors, monitor shift performance, and control access.</p>
        </div>
        <button onclick="openAddDoctorModal()"
            class="px-6 py-3 bg-primary text-white rounded-2xl text-xs font-black uppercase tracking-widest shadow-xl shadow-primary/20 hover:scale-105 transition-all">
            <i class="fas fa-plus mr-2"></i> Add New Doctor
        </button>
    </div>

    <!-- DOCTORS TABLE -->
    <div
        class="bg-white dark:bg-slate-800 rounded-3xl border border-gray-100 dark:border-slate-700 shadow-xl overflow-hidden">
        <table class="w-full text-left">
            <thead
                class="bg-gray-50/50 dark:bg-slate-700/30 text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">
                <tr>
                    <th class="px-6 py-5">Doctor Name</th>
                    <th class="px-6 py-5">Status</th>
                    <th class="px-6 py-5">Last Shift</th>
                    <th class="px-6 py-5">Month Revenue</th>
                    <th class="px-6 py-5 text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="doctors-tbody" class="divide-y divide-gray-50 dark:divide-slate-700">
                <!-- Loaded via JS -->
                <tr>
                    <td colspan="5" class="p-16 text-center text-gray-400 italic font-bold">
                        <i class="fas fa-circle-notch fa-spin mr-2"></i> Fetching medical staff...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Add Doctor Modal -->
    <div id="add-doctor-modal"
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm hidden p-4">
        <div
            class="bg-white dark:bg-slate-800 w-full max-w-md rounded-3xl shadow-2xl border border-gray-100 dark:border-slate-700 overflow-hidden">
            <div
                class="p-8 border-b border-gray-100 dark:border-slate-700 flex justify-between items-center bg-gray-50/50 dark:bg-slate-900/50">
                <div>
                    <h3 class="text-xl font-black dark:text-white">New Staff Account</h3>
                    <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-1">Medical Personnel
                        Entry</p>
                </div>
                <button onclick="closeAddDoctorModal()"
                    class="w-10 h-10 rounded-full flex items-center justify-center hover:bg-red-50 hover:text-red-500 text-gray-400 transition-all">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <form onsubmit="submitAddDoctor(event)" class="p-8 space-y-5">
                <div>
                    <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-2 mb-2 block">Full
                        Name</label>
                    <input type="text" name="full_name" required
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border-none rounded-xl text-sm font-bold dark:text-white focus:ring-2 focus:ring-primary/20">
                </div>
                <div>
                    <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-2 mb-2 block">Email
                        Address</label>
                    <input type="email" name="email" required
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border-none rounded-xl text-sm font-bold dark:text-white focus:ring-2 focus:ring-primary/20">
                </div>
                <div>
                    <label
                        class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-2 mb-2 block">Temporary
                        Password</label>
                    <input type="password" name="password" required
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border-none rounded-xl text-sm font-bold dark:text-white focus:ring-2 focus:ring-primary/20">
                </div>
                <div>
                    <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-2 mb-2 block">Phone
                        Number</label>
                    <input type="tel" name="phone"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border-none rounded-xl text-sm font-bold dark:text-white focus:ring-2 focus:ring-primary/20">
                </div>

                <button type="submit"
                    class="w-full py-4 bg-primary text-white rounded-2xl font-black uppercase tracking-widest shadow-xl shadow-primary/20 hover:scale-[1.02] transition-all mt-4">
                    Authorize Staff Member
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function initializeDoctors() {
        loadDoctors();
    }

    async function loadDoctors() {
        const tbody = document.getElementById('doctors-tbody');
        try {
            const res = await fetch('/admin/doctors');
            const data = await res.json();

            if (data.success) {
                if (data.doctors.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="p-16 text-center text-gray-400 font-bold italic uppercase tracking-widest">No medical staff found</td></tr>';
                    return;
                }

                tbody.innerHTML = data.doctors.map(d => `
                    <tr class="hover:bg-gray-50/50 dark:hover:bg-slate-700/20 transition-all text-sm group">
                        <td class="px-6 py-5">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center text-xl shadow-inner font-black">
                                    ${d.full_name.charAt(0)}
                                </div>
                                <div>
                                    <span class="font-black dark:text-white block">${d.full_name}</span>
                                    <span class="text-[10px] text-gray-400 uppercase tracking-widest">${d.email}</span>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-5">
                            <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ${d.current_shift_status === 'open' ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' : 'bg-gray-100 text-gray-500'}">
                                ${d.current_shift_status === 'open' ? 'On Duty' : 'Away'}
                            </span>
                        </td>
                        <td class="px-6 py-5">
                            <span class="text-xs font-bold dark:text-gray-300 block">${d.last_shift_at ? new Date(d.last_shift_at).toLocaleDateString() : 'Never'}</span>
                            <span class="text-[9px] text-gray-400 uppercase tracking-widest">Last Rev: ${Number(d.last_shift_revenue || 0).toLocaleString()} EGP</span>
                        </td>
                        <td class="px-6 py-5">
                            <span class="text-lg font-black dark:text-white text-primary">${Number(d.month_revenue).toLocaleString()} EGP</span>
                            <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest">${d.month_orders} Orders this month</p>
                        </td>
                        <td class="px-6 py-5 text-right">
                             <div class="flex justify-end gap-2">
                                <button onclick="viewDoctorShifts('${d.id}')" class="w-8 h-8 rounded-lg bg-gray-50 dark:bg-slate-900 flex items-center justify-center text-gray-400 hover:text-primary transition-all">
                                    <i class="fas fa-history"></i>
                                </button>
                                <button onclick="toggleDoctorStatus('${d.id}')" class="w-8 h-8 rounded-lg bg-gray-50 dark:bg-slate-900 flex items-center justify-center text-gray-400 hover:text-red-500 transition-all">
                                    <i class="fas fa-ban"></i>
                                </button>
                             </div>
                        </td>
                    </tr>
                `).join('');
            }
        } catch (err) {
            tbody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-red-500 font-bold">Failed to load medical staff</td></tr>';
        }
    }

    function openAddDoctorModal() {
        document.getElementById('add-doctor-modal').classList.remove('hidden');
    }

    function closeAddDoctorModal() {
        document.getElementById('add-doctor-modal').classList.add('hidden');
    }

    async function submitAddDoctor(e) {
        e.preventDefault();
        const formData = new FormData(e.target);
        const jsonData = Object.fromEntries(formData.entries());

        try {
            const res = await fetch('/admin/doctors/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(jsonData)
            });
            const data = await res.json();

            if (data.success) {
                showToast('success', "Doctor account created and authorized!");
                closeAddDoctorModal();
                loadDoctors();
                e.target.reset();
            } else {
                showToast('error', data.message);
            }
        } catch (err) {
            showToast('error', "Failed to connect to authorization server.");
        }
    }

    async function viewDoctorShifts(id) {
        try {
            const res = await fetch(`/admin/history/doctor-shifts/${id}`);
            const data = await res.json();

            if (data.success) {
                const historyHtml = `
                    <div class="space-y-4">
                        ${data.shifts.length === 0 ? '<p class="text-center py-8 text-gray-400 italic font-bold">No recorded shifts found.</p>' :
                        data.shifts.map(s => `
                            <div class="p-4 bg-gray-50 dark:bg-slate-900 rounded-2xl border border-gray-100 dark:border-slate-800">
                                <div class="flex justify-between items-start mb-2">
                                    <span class="text-[11px] font-black dark:text-white">${new Date(s.opened_at).toLocaleDateString()}</span>
                                    <span class="px-2 py-0.5 rounded text-[8px] font-black uppercase tracking-widest ${s.status === 'open' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500'}">${s.status}</span>
                                </div>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest">Revenue</p>
                                        <p class="text-sm font-black text-primary">${Number(s.net_revenue).toLocaleString()} EGP</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest">Orders</p>
                                        <p class="text-sm font-black dark:text-white">${s.total_orders}</p>
                                    </div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;
                openDrawer(`Staff Shift History`, historyHtml, 'Performance Ledger');
            }
        } catch (err) {
            showToast('error', 'Performance history retrieval failed');
        }
    }

    function toggleDoctorStatus(id) {
        showToast('warning', 'Access revocation must be logged in audit');
    }

    initializeDoctors();
</script>