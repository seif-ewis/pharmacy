<div id="module-audit" class="module-content">
    <div class="mb-8 flex justify-between items-end">
        <div>
            <h1 class="text-3xl font-black dark:text-white mb-2 tracking-tighter">Audit Authority</h1>
            <p class="text-gray-500 text-sm">Immutable ledger of all critical system actions. Mandatory filtering for
                performance.</p>
        </div>
        <div class="flex gap-2">
            <button onclick="loadAuditLogs()"
                class="px-6 py-3 bg-slate-900 text-white rounded-2xl text-[10px] font-black uppercase tracking-widest shadow-xl hover:scale-105 transition-all">
                <i class="fas fa-search mr-2"></i> Query Logs
            </button>
        </div>
    </div>

    <!-- AUDIT FILTERS -->
    <div
        class="bg-white dark:bg-slate-800 p-6 rounded-3xl border border-gray-100 dark:border-slate-700 shadow-sm mb-8 grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
        <div>
            <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-2 mb-2 block">Entity
                Class</label>
            <select id="audit-entity-filter"
                class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border-none rounded-xl text-sm font-bold focus:ring-2 focus:ring-primary/20 dark:text-white">
                <option value="all">All Entities</option>
                <option value="order">Orders</option>
                <option value="shift">Shifts</option>
                <option value="inventory">Inventory</option>
                <option value="return">Returns</option>
                <option value="setting">System Settings</option>
                <option value="user">User Auth</option>
            </select>
        </div>

        <div class="md:col-span-2">
            <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-2 mb-2 block">Action /
                Metadata Search</label>
            <div class="relative">
                <i class="fas fa-fingerprint absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                <input type="text" id="audit-search" placeholder="Search keywords..."
                    class="w-full pl-12 pr-4 py-3 bg-gray-50 dark:bg-slate-900 border-none rounded-xl text-sm font-bold focus:ring-2 focus:ring-primary/20 dark:text-white">
            </div>
        </div>

        <div>
            <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest ml-2 mb-2 block">Date
                Start</label>
            <input type="date" id="audit-date-filter"
                class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border-none rounded-xl text-sm font-bold dark:text-white focus:ring-2 focus:ring-primary/20">
        </div>
    </div>

    <!-- AUDIT TABLE -->
    <div
        class="bg-white dark:bg-slate-800 rounded-3xl border border-gray-100 dark:border-slate-700 shadow-xl overflow-hidden">
        <table class="w-full text-left">
            <thead
                class="bg-gray-50/50 dark:bg-slate-700/30 text-[10px] font-black text-gray-400 uppercase tracking-[0.2em]">
                <tr>
                    <th class="px-6 py-5">Timestamp</th>
                    <th class="px-6 py-5">Actor</th>
                    <th class="px-6 py-5">Action</th>
                    <th class="px-6 py-5">Entity</th>
                    <th class="px-6 py-5 text-right">Context</th>
                </tr>
            </thead>
            <tbody id="audit-tbody" class="divide-y divide-gray-50 dark:divide-slate-700">
                <tr>
                    <td colspan="5" class="px-6 py-24 text-center">
                        <div class="max-w-xs mx-auto text-gray-300">
                            <i class="fas fa-shield-halved text-5xl mb-6 opacity-20"></i>
                            <p class="font-black dark:text-gray-500 uppercase tracking-widest mb-2">Immutable History
                            </p>
                            <p class="text-xs font-bold">Use the filters to query the system audit logs. All actions are
                                final and non-deletable.</p>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- PAGINATION -->
        <div id="audit-pagination"
            class="p-6 bg-gray-50/30 dark:bg-slate-700/10 border-t border-gray-100 dark:border-slate-700 flex justify-between items-center hidden">
            <span id="audit-count-info" class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Showing
                log entry points</span>
            <div class="flex gap-2">
                <button id="audit-prev-btn"
                    class="px-4 py-2 rounded-lg bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700 text-xs font-bold disabled:opacity-50 transition-all">Previous</button>
                <button id="audit-next-btn"
                    class="px-4 py-2 rounded-lg bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700 text-xs font-bold disabled:opacity-50 transition-all">Next</button>
            </div>
        </div>
    </div>
</div>

<script>
    let auditPage = 1;

    function initializeAudit() {
        console.log("Audit Module Ready");
    }

    async function loadAuditLogs() {
        const search = document.getElementById('audit-search').value;
        const entity = document.getElementById('audit-entity-filter').value;
        const startDate = document.getElementById('audit-date-filter').value;
        const tbody = document.getElementById('audit-tbody');
        const pagination = document.getElementById('audit-pagination');

        tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-gray-400 font-bold italic"><i class="fas fa-dna fa-spin mr-2"></i> Querying Blockchain Authority...</td></tr>';

        try {
            const params = new URLSearchParams({
                search,
                entity,
                startDate,
                page: auditPage,
                limit: 20
            });

            const res = await fetch(`/admin/audit/logs?${params.toString()}`);
            const data = await res.json();

            if (data.success) {
                if (data.logs.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-24 text-center text-gray-400 font-bold italic">No matching audit entries discovered.</td></tr>';
                    pagination.classList.add('hidden');
                    return;
                }

                tbody.innerHTML = data.logs.map(log => `
                    <tr class="hover:bg-gray-50/50 dark:hover:bg-slate-700/20 transition-all text-xs group border-l-4 ${getAuditBorder(log.entity)}">
                        <td class="px-6 py-5">
                            <span class="font-black dark:text-white block">${new Date(log.timestamp).toLocaleTimeString()}</span>
                            <span class="text-[9px] text-gray-400 font-bold uppercase">${new Date(log.timestamp).toLocaleDateString()}</span>
                        </td>
                        <td class="px-6 py-5">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-gray-100 dark:bg-slate-700 flex items-center justify-center font-black dark:text-gray-300">
                                    ${log.actor_name ? log.actor_name.charAt(0) : 'S'}
                                </div>
                                <div>
                                    <span class="font-bold dark:text-gray-300 block">${log.actor_name || 'System Auto'}</span>
                                    <span class="text-[8px] text-gray-400 uppercase tracking-widest">${log.actor_role || 'Process'}</span>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-5 italic font-medium dark:text-gray-400 max-w-xs truncate">${log.action}</td>
                        <td class="px-6 py-5">
                            <span class="px-2 py-0.5 bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-800 rounded font-black uppercase text-[8px] tracking-widest">
                                ${log.entity} #${log.entity_id ? (log.entity_id.toString().substring(0, 8)) : 'Global'}
                            </span>
                        </td>
                        <td class="px-6 py-5 text-right">
                             <button onclick="viewAuditMeta('${log.id}')" class="w-8 h-8 rounded-lg bg-gray-50 dark:bg-slate-900 flex items-center justify-center text-gray-400 hover:text-primary transition-all">
                                <i class="fas fa-ellipsis-h"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');

                pagination.classList.remove('hidden');
                document.getElementById('audit-count-info').innerText = `Page ${data.currentPage} of ${data.totalPages} | ${data.totalCount} Entries`;

                const prevBtn = document.getElementById('audit-prev-btn');
                const nextBtn = document.getElementById('audit-next-btn');

                prevBtn.disabled = data.currentPage === 1;
                nextBtn.disabled = data.currentPage === data.totalPages;

                prevBtn.onclick = () => { auditPage--; loadAuditLogs(); };
                nextBtn.onclick = () => { auditPage++; loadAuditLogs(); };
            }
        } catch (err) {
            tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-red-500 font-bold italic">Audit database sync failed.</td></tr>';
        }
    }

    function viewAuditMeta(id) {
        showToast('info', 'Metadata deep-dive requires high-level keys');
    }

    function getAuditBorder(entity) {
        switch (entity) {
            case 'order': return 'border-blue-500';
            case 'shift': return 'border-primary';
            case 'inventory': return 'border-amber-500';
            case 'return': return 'border-red-500';
            case 'setting': return 'border-indigo-500';
            default: return 'border-gray-300';
        }
    }

    initializeAudit();
</script>