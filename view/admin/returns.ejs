<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Manage Returns</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = { darkMode: 'class' };
    </script>
</head>

<body class="bg-gray-50 text-slate-800 font-sans">

    <!-- Simple Admin Header -->
    <header class="bg-white shadow">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <h1 class="text-xl font-bold text-blue-900">MediCare Admin</h1>
            <a href="/" class="text-sm text-gray-500 hover:text-blue-900">Back to Site</a>
        </div>
    </header>

    <div class="container mx-auto px-6 py-8">
        <h2 class="text-2xl font-bold mb-6">Return Requests</h2>

        <!-- Pending Returns -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-8">
            <div class="bg-blue-50 px-6 py-4 border-b border-blue-100 flex justify-between items-center">
                <h3 class="font-bold text-blue-900">Pending Requests</h3>
                <span class="bg-blue-200 text-blue-800 text-xs px-2 py-1 rounded-full">
                    <%= pendingReturns.length %> Pending
                </span>
            </div>

            <% if (pendingReturns.length> 0) { %>
                <div class="divide-y divide-gray-100">
                    <% pendingReturns.forEach(ret=> { %>
                        <div class="p-6">
                            <div class="flex flex-col md:flex-row justify-between mb-4">
                                <div>
                                    <p class="font-bold text-lg">Order #<%= ret.order_uid || ret.order_id.substring(0,8)
                                            %>
                                    </p>
                                    <p class="text-sm text-gray-500">User: <%= ret.user_email %> | Date: <%= new
                                                Date(ret.created_at).toLocaleDateString() %>
                                    </p>
                                </div>
                                <div class="mt-2 md:mt-0">
                                    <span
                                        class="bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-xs font-bold uppercase">Pending
                                        Review</span>
                                </div>
                            </div>

                            <div class="bg-gray-50 p-4 rounded-lg mb-4">
                                <p class="text-sm font-bold text-gray-700 mb-1">Customer Reason:</p>
                                <p class="text-sm text-gray-600 italic">"<%= ret.reason %>"</p>
                            </div>

                            <div class="mb-4">
                                <h4 class="text-xs font-bold uppercase text-gray-400 mb-2">Items to Return</h4>
                                <ul class="space-y-2">
                                    <% ret.items.forEach(item=> { %>
                                        <li class="flex justify-between items-center bg-white border p-2 rounded">
                                            <span>
                                                <%= item.medicine_name %>
                                            </span>
                                            <span class="font-mono text-sm">Qty: <%= item.quantity %></span>
                                        </li>
                                        <% }); %>
                                </ul>
                            </div>

                            <form action="/admin/returns/process" method="POST"
                                class="bg-gray-50 p-4 rounded-xl border border-gray-200">
                                <input type="hidden" name="return_id" value="<%= ret.id %>">

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                    <div>
                                        <label class="block text-xs font-bold uppercase text-gray-500 mb-1">Admin
                                            Notes</label>
                                        <textarea name="admin_notes" rows="2"
                                            class="w-full rounded border-gray-300 text-sm p-2"
                                            placeholder="Internal notes..."></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold uppercase text-gray-500 mb-1">Item
                                            Conditions (Inventory Impact)</label>
                                        <div class="space-y-2 max-h-32 overflow-y-auto">
                                            <% ret.items.forEach(item=> { %>
                                                <div class="flex items-center justify-between text-sm">
                                                    <span class="truncate w-1/2">
                                                        <%= item.medicine_name %>
                                                    </span>
                                                    <select name="item_conditions[<%= item.id %>]"
                                                        class="text-xs border-gray-300 rounded">
                                                        <option value="good">Good (Restock)</option>
                                                        <option value="damaged">Damaged (Discard)</option>
                                                        <option value="expired">Expired (Discard)</option>
                                                    </select>
                                                </div>
                                                <% }); %>
                                        </div>
                                    </div>
                                </div>

                                <div class="flex justify-end gap-3">
                                    <button type="submit" name="action" value="reject"
                                        class="px-4 py-2 bg-white border border-red-200 text-red-600 hover:bg-red-50 rounded-lg text-sm font-bold transition-colors">
                                        Reject Return
                                    </button>
                                    <button type="submit" name="action" value="approve"
                                        class="px-4 py-2 bg-green-600 text-white hover:bg-green-700 rounded-lg text-sm font-bold shadow transition-colors">
                                        Approve & Restock
                                    </button>
                                </div>
                            </form>
                        </div>
                        <% }); %>
                </div>
                <% } else { %>
                    <div class="p-8 text-center text-gray-500">
                        <p>No pending return requests.</p>
                    </div>
                    <% } %>
        </div>

    </div>
</body>

</html>