<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

    <body class="bg-gray-100 dark:bg-dark text-dark dark:text-gray-200">
        <%- include('../partials/header') %>
            <main class="container mx-auto px-4 py-8 mt-20">
                <div class="flex justify-between items-center mb-8">
                    <h1 class="text-3xl font-bold">Product Requests (Doctor Dashboard)</h1>
                </div>

                <div
                    class="bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-gray-100 dark:border-slate-800 overflow-hidden">
                    <table class="w-full text-left">
                        <thead class="bg-gray-50 dark:bg-slate-800 text-xs uppercase font-bold text-gray-500">
                            <tr>
                                <th class="px-6 py-4">User</th>
                                <th class="px-6 py-4">Product</th>
                                <th class="px-6 py-4">Description</th>
                                <th class="px-6 py-4">Status</th>
                                <th class="px-6 py-4">Created At</th>
                                <th class="px-6 py-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
                            <% requests.forEach(req=> { %>
                                <tr class="hover:bg-gray-50 dark:hover:bg-slate-800/50 transition-colors">
                                    <td class="px-6 py-4">
                                        <p class="font-bold text-sm">
                                            <%= req.user_name %>
                                        </p>
                                        <p class="text-xs text-gray-400">
                                            <%= req.user_email %>
                                        </p>
                                    </td>
                                    <td class="px-6 py-4 font-bold text-sm text-primary">
                                        <%= req.product_name %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate">
                                        <%= req.description %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-2 py-1 rounded-full text-xs font-bold uppercase 
                                    <%= req.status === 'ready' ? 'bg-green-100 text-green-700' : 
                                       req.status === 'preparing' ? 'bg-blue-100 text-blue-700' : 
                                       'bg-gray-100 text-gray-600' %>">
                                            <%= req.status %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-xs text-gray-400">
                                        <%= new Date(req.created_at).toLocaleString() %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <button onclick="openModal('<%= req.id %>', '<%= req.status %>')"
                                            class="text-primary hover:underline text-sm font-bold">Process</button>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% if(requests.length===0) { %>
                                        <tr>
                                            <td colspan="6" class="px-6 py-12 text-center text-gray-400">No requests
                                                found.</td>
                                        </tr>
                                        <% } %>
                        </tbody>
                    </table>
                </div>
            </main>

            <!-- Partial Modal for Processing (Simplified) -->
            <div id="process-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
                <div class="bg-white dark:bg-slate-900 rounded-3xl max-w-md w-full p-8 shadow-2xl">
                    <h2 class="text-2xl font-bold mb-6">Process Request</h2>
                    <form id="process-form" onsubmit="submitStatusUpdate(event)">
                        <input type="hidden" name="requestId" id="modal-req-id">
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-bold mb-2">Change Status</label>
                                <select name="status" id="modal-status"
                                    class="w-full rounded-xl border-gray-300 dark:bg-slate-800 dark:border-slate-700 p-3">
                                    <option value="pending">Pending</option>
                                    <option value="preparing">Found & Preparing</option>
                                    <option value="ready">Ready to Take</option>
                                    <option value="cancelled">Cancelled</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-bold mb-2">Match Medicine ID (If Ready)</label>
                                <input type="text" name="matched_medicine_id" placeholder="UUID of Catalog Product"
                                    class="w-full rounded-xl border-gray-300 dark:bg-slate-800 dark:border-slate-700 p-3">
                            </div>
                            <div>
                                <label class="block text-sm font-bold mb-2">Doctor's Notes</label>
                                <textarea name="doctor_notes" rows="3"
                                    class="w-full rounded-xl border-gray-300 dark:bg-slate-800 dark:border-slate-700 p-3"></textarea>
                            </div>
                            <div class="flex gap-4 pt-4">
                                <button type="button" onclick="closeModal()"
                                    class="flex-1 py-3 text-gray-500 font-bold hover:bg-gray-100 dark:hover:bg-slate-800 rounded-xl transition-colors">Cancel</button>
                                <button type="submit"
                                    class="flex-1 py-3 bg-primary text-white font-bold rounded-xl hover:bg-blue-800 transition-colors shadow-lg shadow-blue-500/20">Update</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <script>
                function openModal(id, status) {
                    document.getElementById('modal-req-id').value = id;
                    document.getElementById('modal-status').value = status;
                    document.getElementById('process-modal').classList.remove('hidden');
                }
                function closeModal() {
                    document.getElementById('process-modal').classList.add('hidden');
                }
                async function submitStatusUpdate(e) {
                    e.preventDefault();
                    const id = document.getElementById('modal-req-id').value;
                    const formData = new FormData(e.target);
                    const data = Object.fromEntries(formData.entries());

                    try {
                        const res = await fetch(`/admin/requests/${id}/status`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });
                        if (res.ok) {
                            window.location.reload();
                        } else {
                            alert('Update failed');
                        }
                    } catch (err) { console.error(err); }
                }
            </script>
    </body>

</html>