<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<%- include('partials/head') %>

    <body class="bg-bg text-dark font-sans antialiased overflow-x-hidden selection:bg-primary selection:text-white">

        <%- include('partials/header') %>

            <!-- Page Header -->
            <div class="bg-primary text-white py-12 md:py-20 relative overflow-hidden">
                <div class="absolute inset-0 bg-blue-900/50"></div>
                <div class="absolute -bottom-10 -right-10 w-64 h-64 bg-secondary/20 rounded-full blur-3xl"></div>
                <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
                    <h1 class="text-3xl md:text-5xl font-extrabold mb-4">Privacy Policy</h1>
                    <p class="text-blue-100 text-sm md:text-base max-w-2xl mx-auto">Your privacy is critically important
                        to us. This policy explains how MediCare collects, uses, and protects your personal health
                        information.</p>
                    <p class="mt-4 text-xs font-mono text-blue-200 uppercase tracking-widest">Last Updated: October 26,
                        2026</p>
                </div>
            </div>

            <!-- Content Section -->
            <section class="py-16 bg-bg dark:bg-dark transition-colors duration-300">
                <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                    <div
                        class="max-w-4xl mx-auto bg-white dark:bg-slate-900 rounded-3xl shadow-xl p-8 md:p-12 border border-gray-100 dark:border-slate-800">

                        <div class="space-y-12">
                            <!-- Section 1 -->
                            <div>
                                <div class="flex items-center gap-3 mb-4">
                                    <div
                                        class="w-10 h-10 rounded-full bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center text-primary dark:text-blue-400 font-bold">
                                        1</div>
                                    <h2 class="text-2xl font-bold text-dark dark:text-white">Information We Collect</h2>
                                </div>
                                <div class="pl-14 text-gray-600 dark:text-gray-400 space-y-3 leading-relaxed">
                                    <p>We collect information to provide better services to all our users. This
                                        includes:</p>
                                    <ul class="list-disc list-outside space-y-2 ml-4">
                                        <li><strong>Personal Identification:</strong> Name, email address, phone number,
                                            and shipping address.</li>
                                        <li><strong>Health Information:</strong> Prescriptions uploaded, medication
                                            history, and health conditions you explicitly share with our pharmacists.
                                        </li>
                                        <li><strong>Technical Data:</strong> IP address, browser type, device
                                            information, and cookies to enhance site functionality.</li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Section 2 -->
                            <div>
                                <div class="flex items-center gap-3 mb-4">
                                    <div
                                        class="w-10 h-10 rounded-full bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center text-primary dark:text-blue-400 font-bold">
                                        2</div>
                                    <h2 class="text-2xl font-bold text-dark dark:text-white">How We Use Your Data</h2>
                                </div>
                                <div class="pl-14 text-gray-600 dark:text-gray-400 space-y-3 leading-relaxed">
                                    <p>Your data is used strictly for the following purposes:</p>
                                    <ul class="list-disc list-outside space-y-2 ml-4">
                                        <li>Processing and delivering your orders securely.</li>
                                        <li>Verifying prescriptions with certified pharmacists.</li>
                                        <li>Sending order updates, refills reminders, and health tips (if opted in).
                                        </li>
                                        <li>Improving our website performance and user experience.</li>
                                    </ul>
                                    <div
                                        class="mt-4 p-4 bg-yellow-50 dark:bg-yellow-900/10 border-l-4 border-yellow-400 rounded-r-lg">
                                        <p class="text-sm text-yellow-800 dark:text-yellow-200 font-medium">
                                            <i class="fas fa-shield-alt mr-2"></i> We never sell your personal health
                                            data to third-party advertisers.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Section 3 -->
                            <div>
                                <div class="flex items-center gap-3 mb-4">
                                    <div
                                        class="w-10 h-10 rounded-full bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center text-primary dark:text-blue-400 font-bold">
                                        3</div>
                                    <h2 class="text-2xl font-bold text-dark dark:text-white">Data Security</h2>
                                </div>
                                <div class="pl-14 text-gray-600 dark:text-gray-400 space-y-3 leading-relaxed">
                                    <p>We implement industry-standard security measures including SSL encryption, secure
                                        servers, and restricted access to personal information. Payment transactions are
                                        processed through secure gateways and we do not store sensitive credit card
                                        details on our servers.</p>
                                </div>
                            </div>

                            <!-- Section 4 -->
                            <div>
                                <div class="flex items-center gap-3 mb-4">
                                    <div
                                        class="w-10 h-10 rounded-full bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center text-primary dark:text-blue-400 font-bold">
                                        4</div>
                                    <h2 class="text-2xl font-bold text-dark dark:text-white">Cookies</h2>
                                </div>
                                <div class="pl-14 text-gray-600 dark:text-gray-400 space-y-3 leading-relaxed">
                                    <p>Our website uses cookies to distinguish you from other users of our website. This
                                        helps us to provide you with a good experience when you browse our website and
                                        also allows us to improve our site. You can choose to disable cookies through
                                        your browser settings, though some features of the site may not function
                                        properly.</p>
                                </div>
                            </div>

                            <!-- Contact -->
                            <div class="pt-8 border-t border-gray-100 dark:border-slate-800">
                                <h3 class="text-xl font-bold text-dark dark:text-white mb-4">Contact Us regarding
                                    Privacy</h3>
                                <p class="text-gray-600 dark:text-gray-400 mb-4">If you have questions about this
                                    Privacy Policy, please contact our Data Protection Officer:</p>
                                <a href="mailto:privacy@medicare.com"
                                    class="inline-flex items-center gap-2 text-primary dark:text-blue-400 font-bold hover:underline">
                                    <i class="fas fa-envelope"></i> privacy@medicare.com
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            </section>

            <%- include('partials/footer') %>

    </body>

</html>