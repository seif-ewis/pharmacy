<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>

    <body
        class="bg-gray-50 text-dark font-sans antialiased overflow-x-hidden selection:bg-primary selection:text-white dark:bg-dark transition-colors duration-300">
        <div class="print:hidden">
            <%- include('../partials/header') %>
        </div>

        <main class="min-h-screen py-12">
            <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
                <nav class="flex mb-8 text-sm text-gray-500 print:hidden">
                    <a href="/profile" class="hover:text-primary transition-colors">My Profile</a>
                    <span class="mx-2">/</span>
                    <a href="/profile#prescriptions" class="hover:text-primary transition-colors">Prescriptions</a>
                    <span class="mx-2">/</span>
                    <span class="text-dark dark:text-gray-300 font-bold">Rx #<%= prescription.id.substring(0,8) %>
                    </span>
                </nav>

                <div id="invoice-card"
                    class="bg-white dark:bg-slate-900 rounded-3xl shadow-xl shadow-gray-200/50 dark:shadow-none overflow-hidden border border-gray-100 dark:border-slate-800">

                    <!-- Header Status Section -->
                    <div
                        class="bg-gray-50 dark:bg-slate-800/50 px-8 py-6 border-b border-gray-100 dark:border-slate-800 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div>
                            <h1 class="text-2xl font-bold text-dark dark:text-white mb-1">Prescription Details</h1>
                            <p class="text-sm text-gray-500">Uploaded on <%= new
                                    Date(prescription.created_at).toDateString() %>
                            </p>
                            <p class="text-base font-bold text-primary mt-1">#<%=
                                    prescription.id.substring(0,8).toUpperCase() %>
                            </p>
                        </div>
                        <div class="flex flex-col sm:flex-row sm:items-center gap-3 w-full sm:w-auto">
                            <span class="px-3 py-1 text-sm font-bold rounded-full w-fit 
                                <%= prescription.status === 'done' ? 'bg-green-100 text-green-800' : 
                                    prescription.status === 'processing' ? 'bg-blue-100 text-blue-800' : 
                                    prescription.status === 'reviewing' ? 'bg-yellow-100 text-yellow-800' : 
                                    prescription.status === 'outtodelevery' ? 'bg-purple-100 text-purple-800' : 
                                    'bg-red-100 text-red-800' %>">
                                <%= prescription.status.charAt(0).toUpperCase() + prescription.status.slice(1) %>
                            </span>

                            <% if (finalDetails) { %>
                                <div class="flex flex-wrap items-center gap-2 print:hidden mt-2 sm:mt-0">
                                    <button onclick="downloadPDF()"
                                        class="flex-1 sm:flex-none w-full sm:w-auto px-4 py-2 bg-gray-800 text-white rounded-xl text-sm font-bold hover:bg-gray-900 transition-colors whitespace-nowrap text-center">
                                        Download PDF
                                    </button>
                                    <button onclick="window.print()"
                                        class="flex-1 sm:flex-none w-full sm:w-auto px-4 py-2 bg-primary text-white rounded-xl text-sm font-bold shadow-lg shadow-blue-200 hover:shadow-blue-300 transition-all whitespace-nowrap text-center">
                                        Print Invoice
                                    </button>
                                </div>
                                <% } %>
                        </div>
                    </div>

                    <div class="p-8">
                        <!-- Prescription Image (Hidden in PDF) -->
                        <div class="mb-12 print:hidden pdf-hide">
                            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Original
                                Prescription</h3>
                            <div
                                class="relative group rounded-2xl overflow-hidden border-2 border-gray-100 dark:border-slate-800 bg-gray-50 dark:bg-slate-800">
                                <img src="<%= prescription.image_url %>" alt="Prescription"
                                    class="w-full max-h-[500px] object-contain cursor-zoom-in"
                                    onclick="window.open(this.src, '_blank')">
                                <div
                                    class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
                                    <span class="text-white text-sm font-bold bg-black/50 px-4 py-2 rounded-full">Click
                                        to specific view full size</span>
                                </div>
                            </div>
                        </div>

                        <!-- Invoice Logic (Only correct if finalDetails exists) -->
                        <% if (finalDetails) { %>

                            <!-- Invoice Header (Visible in PDF) -->
                            <div
                                class="flex flex-col md:flex-row justify-between items-start border-b border-gray-100 dark:border-slate-800 pb-8 mb-8 gap-6">
                                <div>
                                    <h2 class="text-3xl font-black text-primary mb-2">Hosam Pharmacy</h2>
                                    <div class="text-sm text-gray-500 dark:text-gray-400 space-y-1">
                                        <p class="flex items-center gap-2"><i
                                                class="fas fa-map-marker-alt text-primary/60 w-4"></i> 123 Health St,
                                            Medical District</p>
                                        <p class="flex items-center gap-2"><i
                                                class="fas fa-envelope text-primary/60 w-4"></i>
                                            contact@hosampharmacy.com</p>
                                        <p class="flex items-center gap-2"><i
                                                class="fas fa-phone text-primary/60 w-4"></i> +1 (555) 123-4567</p>
                                    </div>
                                </div>
                                <div class="text-left md:text-right">
                                    <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Billed To
                                    </h3>
                                    <p class="font-bold text-dark dark:text-white text-lg">
                                        <%= user.full_name %>
                                    </p>
                                    <p class="text-sm text-gray-500 dark:text-gray-400">
                                        <%= user.email %>
                                    </p>
                                    <p class="text-sm text-gray-500 dark:text-gray-400">
                                        <%= user.phone %>
                                    </p>
                                </div>
                            </div>

                            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Prescribed
                                Medicines</h3>
                            <div class="overflow-x-auto rounded-xl border border-gray-100 dark:border-slate-800 mb-8">
                                <table class="w-full text-sm text-left">
                                    <thead class="bg-gray-50 dark:bg-slate-800 text-gray-500 uppercase text-xs">
                                        <tr>
                                            <th class="px-6 py-3 font-medium">Medicine</th>
                                            <th class="px-6 py-3 font-medium text-center">Dosage / Qty</th>
                                            <th class="px-6 py-3 font-medium text-right">Price</th>
                                            <th class="px-6 py-3 font-medium text-right">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
                                        <% const meds=finalDetails.final_meds || []; meds.forEach(function(item) { %>
                                            <tr class="bg-white dark:bg-slate-900">
                                                <td class="px-6 py-4">
                                                    <span class="font-medium text-dark dark:text-white">
                                                        <%= item.name %>
                                                    </span>
                                                </td>
                                                <td class="px-6 py-4 text-center text-gray-600 dark:text-gray-400">
                                                    <%= item.quantity %>
                                                </td>
                                                <td class="px-6 py-4 text-right text-gray-600 dark:text-gray-400">
                                                    $<%= parseFloat(item.price).toFixed(2) %>
                                                </td>
                                                <td class="px-6 py-4 text-right font-medium text-dark dark:text-white">
                                                    $<%= (parseFloat(item.price) * parseFloat(item.quantity)).toFixed(2)
                                                        %>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>

                            <div class="flex flex-col md:flex-row justify-end">
                                <div class="w-full md:w-80 space-y-3">
                                    <div
                                        class="border-t border-gray-100 dark:border-slate-800 pt-3 flex justify-between items-center">
                                        <span class="font-bold text-dark dark:text-white text-lg">Total</span>
                                        <span class="font-bold text-primary text-xl">$<%=
                                                parseFloat(finalDetails.total_price || 0).toFixed(2) %></span>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-8 pt-8 border-t border-gray-100 dark:border-slate-800 text-center">
                                <h4 class="font-bold text-primary mb-2">Prescription Validated</h4>
                                <p class="text-sm text-gray-500">This prescription has been reviewed and processed by
                                    our pharmacist.</p>
                            </div>

                            <% } else { %>
                                <!-- Reviewing State -->
                                <div
                                    class="bg-blue-50 dark:bg-blue-900/10 rounded-2xl p-8 text-center border-2 border-dashed border-blue-200 dark:border-blue-900/30">
                                    <div
                                        class="w-16 h-16 bg-blue-100 dark:bg-blue-800 rounded-full flex items-center justify-center mx-auto text-primary dark:text-blue-200 mb-4 animate-pulse">
                                        <i class="fas fa-stethoscope text-2xl"></i>
                                    </div>
                                    <h3 class="text-xl font-bold text-dark dark:text-white mb-2">Under Review</h3>
                                    <p class="text-gray-500 dark:text-gray-400 max-w-md mx-auto">Our pharmacists are
                                        currently reviewing your prescription to verify medicines and stock
                                        availability. You'll be notified once it's processed.</p>
                                </div>
                                <% } %>

                    </div>
                </div>
            </div>
        </main>

        <div class="print:hidden">
            <%- include('../partials/footer') %>
        </div>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
        <script>
            function downloadPDF() {
                const btn = document.querySelector('button[onclick="downloadPDF()"]');
                if (btn) {
                    btn.innerText = 'Generating...';
                    btn.disabled = true;
                }

                const element = document.getElementById('invoice-card');
                const clone = element.cloneNode(true);

                // Remove print-hidden elements (buttons, etc.)
                clone.querySelectorAll('.print\\:hidden').forEach(el => el.remove());

                // CRITICAL: Remove the image container specifically
                clone.querySelectorAll('.pdf-hide').forEach(el => el.remove());

                // Add "PRESCRIPTION" label to header for clarity
                const header = clone.querySelector('h1');
                if (header) header.innerText = "PRESCRIPTION INVOICE";

                const opt = {
                    margin: [10, 10, 10, 10],
                    filename: 'prescription_<%= prescription.id %>.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff' },
                    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
                };

                html2pdf().from(clone).set(opt).save().then(() => {
                    if (btn) {
                        btn.innerText = 'Download PDF';
                        btn.disabled = false;
                    }
                }).catch(err => {
                    console.error(err);
                    alert('PDF Generation failed');
                    if (btn) btn.disabled = false;
                });
            }
        </script>
    </body>

</html>